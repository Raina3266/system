/* rofi-power: the confirmation shown before SwayNC's Log out, Restart and
   Shut down buttons act. Suspend does not use it — it costs a keypress to undo.

   Enter confirms the highlighted row, Escape cancels. Cancel is highlighted
   first, so a stray Enter is harmless. */

configuration {
    /* Override the base config's top-right placement: a confirmation belongs
       in the middle of the screen, not under the bar. */
    location: 0;
    x-offset: 0px;
    y-offset: 0px;

    show-icons: false;
    eh: 1;
}

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    red:      #FF5C57;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 340px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    padding: 16px;
}

mainbox {
    orientation: vertical;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 4px 2px;
    children: [ prompt ];
}

prompt {
    text-color: @pink;
    horizontal-align: 0.5;
    expand: true;
}

listview {
    lines: 2;
    dynamic: true;
    scrollbar: false;
    spacing: 6px;
}

element {
    children: [ element-text ];
    padding: 10px 14px;
    cursor: pointer;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
}

element-text {
    text-color: @cyan;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.16);
}

element selected element-text {
    text-color: @pink;
}

/* The destructive row is the second one; make it read as such once chosen. */
element alternate selected {
    border-color: @red;
    background-color: rgba(255, 92, 87, 0.18);
}

element alternate selected element-text {
    text-color: @red;
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
