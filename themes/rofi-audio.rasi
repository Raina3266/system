/* rofi-audio: Bluetooth / Output / Input tabs, a status message, and four
   action buttons.

   Connecting, disconnecting and confirming have no buttons of their own:
   double-clicking a row — or pressing Enter on it — is Rofi's accept-entry
   action, which connects or disconnects on Bluetooth and makes the row the
   default device on Output / Input.

   Rofi builds its widget tree once and does not re-run a script mode when you
   switch back to a tab it has already shown, so the action bar can neither
   swap its buttons per tab nor keep per-tab colouring in sync. All four are
   therefore always present and always live; the selected tab in the mode
   switcher is what tells you which two are meaningful. */

/* Rofi triggers this binding once the UI has been idle for `delay` seconds,
   which is the only way a script mode can redraw itself without user input.
   Each script render re-writes this block through its `theme` header, but the
   timer is armed from whatever value was already in place — so this file's
   value is what arms the very first tick, and it must be non-zero or nothing
   ticks until the user presses something. See `write_refresh_theme` in
   scripts/rofi-audio/src/rofi.rs. */
configuration {
    /* Every device row is one compact line. */
    eh: 1;

    timeout {
        delay: 2;
        action: "kb-custom-5";
    }
}

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    amber:    #F29E74;
    red:      #FF5C57;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

/* Anchored under the Waybar icon that opens it, like the module it replaced. */
window {
    width: 400px;
    height: 444px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    margin: 5px;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    children: [ mode-switcher, inputbar, listview, message, action-bar ];
}

mode-switcher {
    orientation: horizontal;
    spacing: 10px;
    padding: 2px 0 2px 0;
}

button {
    expand: true;
    cursor: pointer;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
    horizontal-align: 0.5;
}

button selected {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.16);
    text-color: @pink;
}

/* Doubles as the pairing-code box: rofi-audio allows custom input while a
   device is waiting for a PIN or passkey, so the typed text is submitted with
   Enter instead of opening a nested dialog.

   The `prompt` widget is deliberately left out of the children. Rofi drives it
   from the mode's display name, which is the same string the mode-switcher tab
   shows, so keeping it here would repeat "Bluetooth" / "Output" / "Input" next
   to the tab that already says it. A static filter glyph goes in its place. */
inputbar {
    spacing: 10px;
    padding: 7px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(255, 126, 219, 0.25);
    background-color: @bg-mod;
    children: [ textbox-filter-icon, entry ];
}

textbox-filter-icon {
    expand: false;
    str: "󰍉";
    text-color: @pink;
    vertical-align: 0.5;
}

entry {
    cursor: text;
    placeholder: "Filter devices";
    placeholder-color: @dim;
}

listview {
    lines: 5;
    dynamic: false;
    scrollbar: true;
    spacing: 4px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: rgba(255, 126, 219, 0.55);
    border: 0;
    margin: 0 0 0 5px;
}

element {
    children: [ element-text ];
    padding: 9px 11px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.10);
}

element selected.normal,
element selected.active,
element selected.urgent {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.12);
}

/* Bluetooth: discovered is dim, paired is foreground, connected is cyan.
   Output/Input: every device is foreground, the default one is cyan. */
element-text normal.normal,
element-text alternate.normal,
element-text selected.normal {
    text-color: @dim;
}

element-text normal.active,
element-text alternate.active,
element-text selected.active {
    text-color: @fg;
}

element-text normal.urgent,
element-text alternate.urgent,
element-text selected.urgent {
    text-color: @cyan;
}

message {
    padding: 5px 10px;
    line: 1;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(242, 158, 116, 0.45);
    background-color: rgba(242, 158, 116, 0.07);
}

action-bar {
    expand: false;
    orientation: horizontal;
    spacing: 7px;
    children: [
        button-scan,
        button-forget,
        button-volume-up,
        button-volume-down
    ];
}

button-scan,
button-forget,
button-volume-up,
button-volume-down {
    cursor: pointer;
    expand: true;
    horizontal-align: 0.5;
    margin: 1px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
}

/* Bluetooth tab: scan, forget. Connect/disconnect is a double-click on the
   row. */
button-scan {
    content: " 󰑐 ";
    action: "kb-custom-1";
}

button-forget {
    content: " 󰆴 ";
    action: "kb-custom-2";
}

/* Output and Input tabs: volume up, volume down. Volume also answers to Alt+Up
   and Alt+Down; a double-click on the row makes it the default device. */
button-volume-up {
    content: " 󰝝 ";
    action: "kb-custom-3";
}

button-volume-down {
    content: " 󰝞 ";
    action: "kb-custom-4";
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
