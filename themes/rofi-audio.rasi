/* rofi-audio: Bluetooth / Output / Input / Playback.

   Alt+1 scan; Alt+2 forget; Alt+3/Up louder; Alt+4/Down quieter;
   Alt+6 mute; Alt+7 route; Alt+9 back (also a row in the route picker).
   Profile and Bluetooth codec selection are intentionally not included. */

configuration {
    /* Every device row is one compact line. */
    eh: 1;

    timeout {
        delay: 2;
        action: "kb-custom-5";
    }
}

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    amber:    #F29E74;
    red:      #FF5C57;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 490px;
    height: 490px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    margin: 5px;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    children: [ mode-switcher, inputbar, listview, message, action-bar ];
}

mode-switcher {
    orientation: horizontal;
    spacing: 6px;
    padding: 2px 0 2px 0;
}

button {
    expand: false;
    padding: 2px 8px;
    cursor: pointer;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
    horizontal-align: 0.5;
}

button selected {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.16);
    text-color: @pink;
}

inputbar {
    spacing: 10px;
    padding: 7px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(255, 126, 219, 0.25);
    background-color: @bg-mod;
    children: [ textbox-filter-icon, entry ];
}

textbox-filter-icon {
    expand: false;
    str: "󰍉";
    text-color: @pink;
    vertical-align: 0.5;
}

entry {
    cursor: text;
    placeholder: "Filter devices";
    placeholder-color: @dim;
}

listview {
    dynamic: true;
    scrollbar: true;
    spacing: 4px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: rgba(255, 126, 219, 0.55);
    border: 0;
    margin: 0 0 0 5px;
}

element {
    children: [ element-text ];
    padding: 9px 11px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.10);
}

element selected.normal,
element selected.active,
element selected.urgent {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.12);
}

element-text normal.normal,
element-text alternate.normal,
element-text selected.normal {
    text-color: @dim;
}

element-text normal.active,
element-text alternate.active,
element-text selected.active {
    text-color: @fg;
}

element-text normal.urgent,
element-text alternate.urgent,
element-text selected.urgent {
    text-color: @cyan;
}

message {
    padding: 5px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(242, 158, 116, 0.45);
    background-color: rgba(242, 158, 116, 0.07);
}

action-bar {
    expand: false;
    orientation: horizontal;
    spacing: 5px;
    children: [
        button-scan,
        button-forget,
        button-volume-up,
        button-volume-down,
        button-mute,
        button-route
    ];
}

button-scan,
button-forget,
button-volume-up,
button-volume-down,
button-mute,
button-route {
    cursor: pointer;
    expand: true;
    horizontal-align: 0.5;
    margin: 1px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
}

button-scan {
    content: " 󰑐 ";
    action: "kb-custom-1";
}

button-forget {
    content: " 󰆴 ";
    action: "kb-custom-2";
}

button-volume-up {
    content: " 󰝝 ";
    action: "kb-custom-3";
}

button-volume-down {
    content: " 󰝞 ";
    action: "kb-custom-4";
}

button-mute {
    content: " 󰝟 ";
    action: "kb-custom-6";
}

button-route {
    content: " 󰁔 ";
    action: "kb-custom-7";
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
