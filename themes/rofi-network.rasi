/* Network manager: Wi-Fi/Ethernet tabs, status message, and six actions. */

/* Rofi triggers this binding once the UI has been idle for `delay` seconds and
   re-arms the timer on every action, which is the only way a script mode can
   redraw itself without user input. This is only the value for the very first
   frame; from then on the script sets `delay` through its `theme` header, and
   keeps it non-zero throughout. It has to: Rofi arms the timer from the theme
   as it stood *before* the script ran, so the frame that starts a connect
   cannot start the ticking that reports its outcome — whichever frame the user
   pressed Enter on has to have done that already. */
configuration {
    timeout {
        delay: 0;
        action: "kb-custom-5";
    }
}

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    amber:    #F29E74;
    red:      #FF5C57;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 375px;
    height: 490px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    margin: 5px;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    children: [ mode-switcher, inputbar, listview, message, action-bar ];
}

mode-switcher {
    orientation: horizontal;
    spacing: 10px;
    padding: 2px 0 2px 0;
}

button {
    expand: true;
    cursor: pointer;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
    horizontal-align: 0.5;
}

button selected {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.16);
    text-color: @pink;
}

/* The `prompt` widget is deliberately left out of the children. Rofi drives it
   from the mode's display name, which is the same string the mode-switcher tab
   shows, so keeping it here would repeat "Wi-Fi" / "Ethernet" next to the tab
   that already says it. A static filter glyph goes in its place. */
inputbar {
    spacing: 10px;
    padding: 7px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(255, 126, 219, 0.25);
    background-color: @bg-mod;
    children: [ textbox-filter-icon, entry ];
}

textbox-filter-icon {
    expand: false;
    str: "󰍉";
    text-color: @pink;
    vertical-align: 0.5;
}

entry {
    cursor: text;
    placeholder: "Filter networks";
    placeholder-color: @dim;
}

listview {
    lines: 5;
    eh: 1;
    dynamic: false;
    scrollbar: true;
    spacing: 4px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: rgba(255, 126, 219, 0.55);
    border: 0;
    margin: 0 0 0 5px;
}

element {
    children: [ element-text ];
    padding: 9px 11px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.10);
}

element selected.normal,
element selected.active,
element selected.urgent {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.12);
}

/* Unsaved is dim, saved is foreground, connected/connecting is cyan. */
element-text normal.normal,
element-text alternate.normal,
element-text selected.normal {
    text-color: @dim;
}

element-text normal.active,
element-text alternate.active,
element-text selected.active {
    text-color: @fg;
}

element-text normal.urgent,
element-text alternate.urgent,
element-text selected.urgent {
    text-color: @cyan;
}

status-panel {
    orientation: vertical;
    padding: 8px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(242, 158, 116, 0.45);
    background-color: rgba(242, 158, 116, 0.07);
    children: [ message ];
}

message {
    padding: 8px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(242, 158, 116, 0.45);
    background-color: rgba(242, 158, 116, 0.07);
}

action-bar {
    expand: false;
    orientation: horizontal;
    spacing: 7px;
    children: [
        button-scan,
        button-connect,
        button-forget,
        button-info
    ];
}

button-scan,
button-connect,
button-forget,
button-info {
    cursor: pointer;
    expand: true;
    horizontal-align: 0.5;
    margin: 1px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
}

button-scan {
    content: " 󰑐 ";
    action: "kb-custom-1";
}

button-connect {
    content: " 󰖩 ";
    action: "kb-custom-2";
}

button-forget {
    content: " 󰆴 ";
    action: "kb-custom-3";
}

button-info {
    content: " 󰋼 ";
    action: "kb-custom-4";
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
