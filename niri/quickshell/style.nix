# Shared presentation for the desktop and audio shells; no service dependencies.
{
  config,
  pkgs,
  repoRoot,
  ...
}:
let
  palette = import ../../themes/palette.nix;
  colorsQml = pkgs.writeText "Colors.qml" ''
    // Generated by niri/quickshell/style.nix from themes/palette.nix.
    import QtQuick

    QtObject {
        readonly property color background: "${palette.background}"
        readonly property color secondaryBackground: "${palette.secondaryBackground}"
        readonly property color surface: "${palette.alternateBackground}"
        readonly property color elevated: "${palette.elevated}"
        readonly property color chrome: "${palette.chromeBackground}"
        readonly property color text: "${palette.foreground}"
        readonly property color muted: "${palette.separator}"
        readonly property color accent: "${palette.cyan}"
        readonly property color metadata: "${palette.foreground}"
        readonly property color primary: "${palette.pink}"
        readonly property color dimPrimary: "${palette.dimPink}"
        readonly property color destructive: "${palette.red}"
        readonly property color warning: "${palette.yellow}"

    }
  '';
  liveLink = path: config.lib.file.mkOutOfStoreSymlink "${repoRoot}/${path}";
  qmlFiles = [
    "ControlButton.qml"
    "IconButton.qml"
    "PopupFrame.qml"
    "StyledSlider.qml"
  ];
in
{
  # Quickshell only scans imports within each configuration's root. These
  # aliases all point to the same source files, not separate style copies.
  xdg.configFile = builtins.listToAttrs (
    builtins.concatMap
      (
        shell:
        map (name: {
          name = "quickshell/${shell}/shared/${name}";
          value.source = liveLink "themes/quickshell/${name}";
        }) qmlFiles
        ++ [
          {
            name = "quickshell/${shell}/shared/Colors.qml";
            value.source = colorsQml;
          }
        ]
      )
      [
        "media"
        "audio-control"
      ]
  );
}
