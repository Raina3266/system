# The media panel: a small resident Quickshell config whose card Waybar's
# centre button toggles. QML sources link live out of the repository (save to
# reload, like niri/config.kdl); only Colors.qml comes from the store,
# rendered from the same themes/palette.nix the Daemon themes are built with,
# so the panel cannot drift from the desktop's colours.
{
  config,
  lib,
  pkgs,
  repoRoot,
  repoPackages,
  ...
}:
let
  palette = import ../../themes/palette.nix;

  colorsQml = pkgs.writeText "Colors.qml" ''
    // Generated by niri/quickshell/default.nix from themes/palette.nix.
    // Edit the .nix file; this file is rebuilt, not live-linked.
    import QtQuick

    QtObject {
        readonly property color background: "${palette.background}"
        readonly property color surface: "${palette.alternateBackground}"
        readonly property color elevated: "${palette.elevated}"
        readonly property color chrome: "${palette.chromeBackground}"
        readonly property color text: "${palette.foreground}"
        readonly property color muted: "${palette.separator}"
        readonly property color accent: "${palette.cyan}"
        readonly property color primary: "${palette.pink}"
        readonly property color dimPrimary: "${palette.dimPink}"
        readonly property color destructive: "${palette.red}"
        readonly property color warning: "${palette.yellow}"
        readonly property color ok: "${palette.green}"
    }
  '';

  liveLink = path: config.lib.file.mkOutOfStoreSymlink "${repoRoot}/${path}";
  qmlFiles = [
    "shell.qml"
    "MediaPanel.qml"
    "PlayerCard.qml"
    "Artwork.qml"
    "IconButton.qml"
    "SeekBar.qml"
    "VolumeSlider.qml"
    "OutputList.qml"
    "SourcesList.qml"
  ];
in
{
  home.packages = [
    pkgs.quickshell
    # WebP/JP2/ICO decoders for browser-published cover art (bilibili serves
    # .webp; Qt's base JPEG/PNG plugins already cover YouTube).
    pkgs.qt6.qtimageformats
  ];

  # One symlink per file, not a directory link, so the generated Colors.qml
  # can sit next to the live-linked sources.
  xdg.configFile = builtins.listToAttrs (
    map (name: {
      name = "quickshell/media/${name}";
      value.source = liveLink "themes/quickshell/${name}";
    }) qmlFiles
  ) // {
    "quickshell/media/Colors.qml".source = colorsQml;
  };

  systemd.user.services.quickshell-media = {
    Unit = {
      Description = "Quickshell media panel";
      ConditionEnvironment = lib.mkForce [ "XDG_CURRENT_DESKTOP=niri" ];
      PartOf = [ "graphical-session.target" ];
      After = [ "graphical-session.target" ];
    };
    Service = {
      ExecStart = "${lib.getExe pkgs.quickshell} -c media";
      Restart = lib.mkForce "on-failure";
      RestartSec = 3;
      # The panel spawns audio-control for route choices and the profile-aware
      # stream move; hand it the exact binary rather than relying on PATH.
      Environment = [ "AUDIO_CONTROL=${repoPackages.audioControl}/bin/audio-control" ];
    };
    Install.WantedBy = [ "graphical-session.target" ];
  };
}
