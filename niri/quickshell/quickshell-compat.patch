+	const QString mapName = "802-11-wireless-security";
+	if (!settings.contains(mapName)) return WifiSecurityType::Open;
+	const QVariantMap& security = settings.value(mapName);
+	if (security.isEmpty()) return WifiSecurityType::Unknown;

@@ -49,6 +49,6 @@
-	} else if (keyMgmt == "owe") {
-		return WifiSecurityType::Owe;
-	}
-	return WifiSecurityType::Open;
+	} else if (keyMgmt == "owe") {
