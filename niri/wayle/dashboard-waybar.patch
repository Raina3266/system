+    pub(super) fn cycle_power_profile(&self, sender: &ComponentSender<Self>) {
         let Some(power_profiles) = self.power_profiles.get() else {
             return;
         };
 
-        let target = if self.power_saver_active {
-            PowerProfile::Balanced
-        } else {
-            PowerProfile::PowerSaver
