+/// Removes PulseAudio profile boilerplate while retaining the device model.
+pub(crate) fn short_device_name(description: &str) -> String {
+    let mut short = description.to_owned();
+    for noise in DESCRIPTION_NOISE {
+        while let Some(at) = short.find(noise) {
+            short.replace_range(at..at + noise.len(), " ");
+        }
+    }
+    let tokens: Vec<&str> = short.split_whitespace().collect();
+    let short = tokens
+        .iter()
+        .enumerate()
+        .filter(|(index, token)| {
+            let family_label = **token == "Family"
+                && tokens
+                    .get(index + 1)
+                    .is_some_and(|next| is_pci_family(next));
+            !(is_pci_family(token) || family_label)
+        })
+        .map(|(_, token)| *token)
+        .collect::<Vec<_>>()
+        .join(" ");
+    let short = short.trim_matches(|character: char| {
+        character.is_whitespace() || matches!(character, '-' | ',' | ':')
+    });
+    if short.is_empty() {
+        description.to_owned()
+    } else {
+        short.to_owned()
+    }
+}
+
+/// The built-in controller name is identical across Speaker, Headphones and
+/// HDMI nodes. Show its active port; retain a shortened model name for USB,
+/// Bluetooth and other genuinely different hardware.
+pub(crate) fn active_device_name(
+    description: &str,
+    active_port: &Option<String>,
+    ports: &[wayle_audio::types::device::DevicePort],
+) -> String {
+    let port = active_port_description(active_port, ports);
+    let lower = description.to_lowercase();
+    if (lower.contains("audio controller") || lower.contains("built-in audio"))
+        && let Some(port) = port.filter(|port| !port.is_empty())
+    {
+        return port;
+    }
+    short_device_name(description)
+}
+
+fn is_pci_family(token: &str) -> bool {
+    !token.is_empty()
+        && token.split('/').all(|part| {
+            let Some(digits) = part.strip_suffix('h') else {
+                return false;
+            };
+            (2..=3).contains(&digits.len())
+                && digits.starts_with(|character: char| character.is_ascii_digit())
+                && digits
+                    .chars()
+                    .all(|character| character.is_ascii_hexdigit())
+        })
