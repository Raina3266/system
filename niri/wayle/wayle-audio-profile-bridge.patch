diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/audio/device_picker/helper.rs b/crates/wayle-shell/src/shell/bar/dropdowns/audio/device_picker/helper.rs
new file mode 100644
index 0000000..cf99d47
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/audio/device_picker/helper.rs
@@ -0,0 +1,141 @@
+//! Adapter to the audio profile logic shared with the former Rofi panel.
+
+use std::{env, str};
+
+use tokio::process::Command;
+
+use crate::shell::bar::dropdowns::audio::VolumeSectionKind;
+
+const FIELD_COUNT: usize = 5;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct HelperRow {
+    pub key: String,
+    pub label: String,
+    pub description: String,
+    pub name: String,
+    pub is_default: bool,
+}
+
+pub(super) async fn load(kind: VolumeSectionKind) -> Result<Vec<HelperRow>, String> {
+    let output = command()?
+        .arg("wayle-list")
+        .arg(kind_name(kind))
+        .output()
+        .await
+        .map_err(|error| format!("cannot run audio helper: {error}"))?;
+
+    if !output.status.success() {
+        return Err(command_error(&output.stderr, output.status.to_string()));
+    }
+    parse_output(&output.stdout)
+}
+
+pub(super) async fn set_default(kind: VolumeSectionKind, key: &str) -> Result<(), String> {
+    let output = command()?
+        .arg("wayle-set-default")
+        .arg(kind_name(kind))
+        .arg(key)
+        .output()
+        .await
+        .map_err(|error| format!("cannot run audio helper: {error}"))?;
+
+    if output.status.success() {
+        Ok(())
+    } else {
+        Err(command_error(&output.stderr, output.status.to_string()))
+    }
+}
+
+fn command() -> Result<Command, String> {
+    let executable = env::var_os("WAYLE_AUDIO_HELPER")
+        .ok_or_else(|| "WAYLE_AUDIO_HELPER is not configured".to_owned())?;
+    let mut command = Command::new(executable);
+    command.kill_on_drop(true);
+    Ok(command)
+}
+
+const fn kind_name(kind: VolumeSectionKind) -> &'static str {
+    match kind {
+        VolumeSectionKind::Output => "output",
+        VolumeSectionKind::Input => "input",
+    }
+}
+
+fn command_error(stderr: &[u8], status: String) -> String {
+    let message = String::from_utf8_lossy(stderr);
+    let message = message.trim();
+    if message.is_empty() {
+        format!("audio helper exited with {status}")
+    } else {
+        message.to_owned()
+    }
+}
+
+fn parse_output(output: &[u8]) -> Result<Vec<HelperRow>, String> {
+    let mut fields: Vec<&[u8]> = output.split(|byte| *byte == 0).collect();
+    if fields.last().is_some_and(|field| field.is_empty()) {
+        fields.pop();
+    }
+    if !fields.len().is_multiple_of(FIELD_COUNT) {
+        return Err(format!(
+            "audio helper returned {} fields, expected a multiple of {FIELD_COUNT}",
+            fields.len()
+        ));
+    }
+
+    fields
+        .chunks_exact(FIELD_COUNT)
+        .map(|fields| {
+            let text = |index| {
+                str::from_utf8(fields[index])
+                    .map(str::to_owned)
+                    .map_err(|error| format!("audio helper returned invalid UTF-8: {error}"))
+            };
+            let default = text(4)?;
+            let is_default = match default.as_str() {
+                "0" => false,
+                "1" => true,
+                value => {
+                    return Err(format!(
+                        "audio helper returned invalid default flag {value:?}"
+                    ));
+                }
+            };
+            Ok(HelperRow {
+                key: text(0)?,
+                label: text(1)?,
+                description: text(2)?,
+                name: text(3)?,
+                is_default,
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_nul_delimited_rows() {
+        let rows = parse_output(
+            b"speaker\0Speaker\0Controller Speaker\0speaker-sink\0\x31\0\
+              headphones\0Headphones\0Controller Headphones\0\0\x30\0",
+        )
+        .unwrap();
+
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[0].label, "Speaker");
+        assert!(rows[0].is_default);
+        assert_eq!(rows[1].name, "");
+        assert!(!rows[1].is_default);
+    }
+
+    #[test]
+    fn rejects_partial_and_invalid_rows() {
+        assert!(parse_output(b"only-one-field\0").is_err());
+        assert!(parse_output(b"key\0label\0description\0name\0maybe\0").is_err());
+        assert!(parse_output(b"key\0\xff\0description\0name\0\x31\0").is_err());
+    }
+}
