diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/info.rs b/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/info.rs
new file mode 100644
index 0000000..bf4e032
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/info.rs
@@ -0,0 +1,343 @@
+use std::{collections::HashSet, sync::Arc};
+
+use wayle_network::{
+    NetworkService,
+    core::{
+        access_point::{AccessPoint, SecurityType, Ssid},
+        settings_connection::ConnectionSettings,
+    },
+    types::{
+        flags::{NM80211ApFlags, NM80211ApSecurityFlags},
+        wifi::NM80211Mode,
+    },
+    wifi::Wifi,
+};
+use zbus::zvariant::OwnedValue;
+
+const SECURITY_SETTING: &str = "802-11-wireless-security";
+
+pub(super) async fn load(
+    network: Arc<NetworkService>,
+    expected_ssid: String,
+) -> Result<String, String> {
+    let wifi = network
+        .wifi
+        .get()
+        .ok_or_else(|| String::from("No WiFi adapter is available."))?;
+    let ssid = wifi
+        .ssid
+        .get()
+        .filter(|ssid| ssid == &expected_ssid)
+        .ok_or_else(|| String::from("The WiFi connection changed while reading its details."))?;
+
+    let access_point = active_access_point(&wifi, &ssid);
+    let profile = active_profile(&network, &ssid).await;
+
+    let profile_line = profile
+        .as_ref()
+        .map(|profile| format!("{} ({})", profile.id.get(), profile.uuid.get()))
+        .unwrap_or_else(|| String::from("Not saved"));
+    let password = password_description(
+        profile.as_ref(),
+        access_point.as_ref().map(|point| point.security.get()),
+    )
+    .await;
+
+    let ipv4 = network
+        .ip4_config(wifi.device.core.ip4_config.get())
+        .await
+        .ok();
+    let ipv6 = network
+        .ip6_config(wifi.device.core.ip6_config.get())
+        .await
+        .ok();
+
+    let ipv4_address = ipv4
+        .as_ref()
+        .and_then(|config| config.address_data.get().into_iter().next())
+        .map(|address| address.address.to_string())
+        .or_else(|| wifi.ip4_address.get())
+        .unwrap_or_else(|| String::from("Not assigned"));
+    let ipv6_address = ipv6
+        .as_ref()
+        .and_then(|config| config.address_data.get().into_iter().next())
+        .map(|address| address.address.to_string())
+        .unwrap_or_else(|| String::from("Not assigned"));
+    let dns = dns_servers(ipv4.as_ref(), ipv6.as_ref());
+
+    // The signal and the frequency are also published by the WiFi model itself,
+    // which keeps following the active access point, so those two rows survive
+    // even when the access point object cannot be resolved at all.
+    let signal = access_point
+        .as_ref()
+        .map(|point| point.strength.get())
+        .or_else(|| wifi.strength.get())
+        .map(|strength| format!("{strength}%"))
+        .unwrap_or_else(unknown);
+    let frequency = access_point
+        .as_ref()
+        .map(|point| point.frequency.get())
+        .or_else(|| wifi.frequency.get());
+    let frequency_line = frequency
+        .map(|frequency| format!("{frequency} MHz ({})", frequency_band(frequency)))
+        .unwrap_or_else(unknown);
+    let channel = frequency
+        .and_then(channel_for_frequency)
+        .map(|channel| channel.to_string())
+        .unwrap_or_else(unknown);
+    let security = access_point
+        .as_ref()
+        .map(|point| String::from(security_label(point)))
+        .unwrap_or_else(unknown);
+    let bssid = access_point
+        .as_ref()
+        .map(|point| point.bssid.get().to_string())
+        .unwrap_or_else(unknown);
+    let mode = access_point
+        .as_ref()
+        .map(|point| String::from(mode_label(point.mode.get())))
+        .unwrap_or_else(unknown);
+
+    let bitrate = wifi.device.bitrate.get();
+    let link_rate = if bitrate == 0 {
+        unknown()
+    } else {
+        format!("{:.1} Mbps", f64::from(bitrate) / 1000.0)
+    };
+
+    Ok(format!(
+        "Network (SSID: {ssid})\n\n\
+         Signal:     {signal}\n\
+         Profile:    {profile_line}\n\
+         Security:   {security}\n\
+         Interface:  {}\n\
+         Password:   {password}\n\n\
+         Addresses\n\n\
+         IPv4:       {ipv4_address}\n\
+         IPv6:       {ipv6_address}\n\
+         DNS:        {dns}\n\n\
+         Radio\n\n\
+         BSSID:      {bssid}\n\
+         Frequency:  {frequency_line}\n\
+         Channel:    {channel}\n\
+         Mode:       {mode}\n\
+         Link rate:  {link_rate}",
+        wifi.device.core.interface.get(),
+    ))
+}
+
+fn unknown() -> String {
+    String::from("Unknown")
+}
+
+/// Resolves the access point the device is associated with, from the live list
+/// the WiFi model maintains.
+///
+/// NetworkManager gives an access point a new object path whenever it recreates
+/// it, which it does after scans, roams and reconnects. `wayle-network` reads
+/// the device's `ActiveAccessPoint` path when it builds the WiFi model and does
+/// not refresh it afterwards, so asking NetworkManager for that path fails with
+/// "object not found" as soon as the network has moved on. Use the cached path
+/// only while it still names an access point that exists, and otherwise take the
+/// strongest access point advertising the network we are connected to.
+fn active_access_point(wifi: &Wifi, ssid: &str) -> Option<Arc<AccessPoint>> {
+    let active_path = wifi.device.active_access_point.get();
+    let access_points = wifi.access_points.get();
+
+    access_points
+        .iter()
+        .find(|access_point| *access_point.object_path() == active_path)
+        .or_else(|| {
+            access_points
+                .iter()
+                .filter(|access_point| access_point.ssid.get().to_string_lossy() == ssid)
+                .max_by_key(|access_point| access_point.strength.get())
+        })
+        .cloned()
+}
+
+pub(super) async fn active_profile(
+    network: &NetworkService,
+    ssid: &str,
+) -> Option<ConnectionSettings> {
+    let stored_ssid = Ssid::new(ssid.as_bytes().to_vec());
+    let profiles = network.settings.connections_for_ssid(&stored_ssid);
+    let wifi = network.wifi.get()?;
+    let active = network
+        .connection(wifi.device.core.active_connection.get())
+        .await
+        .ok();
+    let active_uuid = active.as_ref().map(|connection| connection.uuid.get());
+
+    active_uuid
+        .and_then(|uuid| {
+            profiles
+                .iter()
+                .find(|profile| profile.uuid.get() == uuid)
+                .cloned()
+        })
+        .or_else(|| profiles.into_iter().next())
+}
+
+async fn password_description(
+    profile: Option<&ConnectionSettings>,
+    security: Option<SecurityType>,
+) -> String {
+    match security {
+        Some(SecurityType::None) => return String::from("None (open network)"),
+        Some(SecurityType::Enterprise) => {
+            return String::from("Managed by the enterprise profile");
+        }
+        // Without an access point the saved profile is the only thing left to
+        // read, and it answers for itself whether the network has a password.
+        _ => {}
+    }
+
+    let Some(profile) = profile else {
+        return String::from("Unavailable (network is not saved)");
+    };
+
+    let Ok(secrets) = profile.get_secrets(SECURITY_SETTING).await else {
+        return String::from("Unavailable from NetworkManager");
+    };
+    secrets
+        .get(SECURITY_SETTING)
+        .and_then(|security| {
+            security
+                .get("psk")
+                .or_else(|| security.get("wep-key0"))
+                .and_then(string_value)
+        })
+        .filter(|password| !password.is_empty())
+        .unwrap_or_else(|| String::from("Unavailable from NetworkManager"))
+}
+
+fn dns_servers(
+    ipv4: Option<&wayle_network::core::config::ip4_config::Ip4Config>,
+    ipv6: Option<&wayle_network::core::config::ip6_config::Ip6Config>,
+) -> String {
+    let mut seen = HashSet::new();
+    let mut servers = Vec::new();
+
+    if let Some(ipv4) = ipv4 {
+        for server in ipv4.nameserver_data.get() {
+            let server = server.to_string();
+            if seen.insert(server.clone()) {
+                servers.push(server);
+            }
+        }
+    }
+    if let Some(ipv6) = ipv6 {
+        for server in ipv6.nameservers.get() {
+            let server = server.to_string();
+            if seen.insert(server.clone()) {
+                servers.push(server);
+            }
+        }
+    }
+
+    if servers.is_empty() {
+        String::from("Not assigned")
+    } else {
+        servers.join(", ")
+    }
+}
+
+fn security_label(access_point: &AccessPoint) -> &'static str {
+    let wpa = access_point.wpa_flags.get();
+    let rsn = access_point.rsn_flags.get();
+    let combined = wpa | rsn;
+    let enterprise = combined.contains(NM80211ApSecurityFlags::KEY_MGMT_802_1X);
+    let suite_b = combined.contains(NM80211ApSecurityFlags::KEY_MGMT_EAP_SUITE_B_192);
+    let sae = combined.contains(NM80211ApSecurityFlags::KEY_MGMT_SAE);
+    let psk = combined.contains(NM80211ApSecurityFlags::KEY_MGMT_PSK);
+
+    if suite_b {
+        "WPA3 Enterprise"
+    } else if enterprise && sae {
+        "WPA2/WPA3 Enterprise"
+    } else if enterprise {
+        "WPA2 Enterprise"
+    } else if sae && psk {
+        "WPA2/WPA3"
+    } else if sae {
+        "WPA3"
+    } else if combined
+        .intersects(NM80211ApSecurityFlags::KEY_MGMT_OWE | NM80211ApSecurityFlags::KEY_MGMT_OWE_TM)
+    {
+        "WPA3 OWE"
+    } else if wpa.contains(NM80211ApSecurityFlags::KEY_MGMT_PSK)
+        && rsn.contains(NM80211ApSecurityFlags::KEY_MGMT_PSK)
+    {
+        "WPA/WPA2"
+    } else if rsn.contains(NM80211ApSecurityFlags::KEY_MGMT_PSK) {
+        "WPA2"
+    } else if wpa.contains(NM80211ApSecurityFlags::KEY_MGMT_PSK) {
+        "WPA"
+    } else if access_point.flags.get().contains(NM80211ApFlags::PRIVACY) {
+        "WEP"
+    } else {
+        "Open"
+    }
+}
+
+fn frequency_band(frequency: u32) -> &'static str {
+    if frequency >= 59_400 {
+        "60 GHz"
+    } else if frequency >= 5_925 {
+        "6 GHz"
+    } else if frequency >= 4_900 {
+        "5 GHz"
+    } else {
+        "2.4 GHz"
+    }
+}
+
+fn channel_for_frequency(frequency: u32) -> Option<u32> {
+    match frequency {
+        2_484 => Some(14),
+        2_412..=2_472 if (frequency - 2_407).is_multiple_of(5) => Some((frequency - 2_407) / 5),
+        4_915..=4_980 if (frequency - 4_000).is_multiple_of(5) => Some((frequency - 4_000) / 5),
+        5_000..=5_895 if (frequency - 5_000).is_multiple_of(5) => Some((frequency - 5_000) / 5),
+        5_935 => Some(2),
+        5_955..=7_115 if (frequency - 5_950).is_multiple_of(5) => Some((frequency - 5_950) / 5),
+        58_320..=70_200 if (frequency - 56_160).is_multiple_of(2_160) => {
+            Some((frequency - 56_160) / 2_160)
+        }
+        _ => None,
+    }
+}
+
+const fn mode_label(mode: NM80211Mode) -> &'static str {
+    match mode {
+        NM80211Mode::Unknown => "Unknown",
+        NM80211Mode::Adhoc => "Ad-hoc",
+        NM80211Mode::Infra => "Infrastructure",
+        NM80211Mode::Ap => "Access point",
+        NM80211Mode::Mesh => "Mesh",
+    }
+}
+
+fn string_value(value: &OwnedValue) -> Option<String> {
+    String::try_from(value.clone()).ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn common_wifi_frequencies_map_to_channels() {
+        assert_eq!(channel_for_frequency(2_437), Some(6));
+        assert_eq!(channel_for_frequency(5_180), Some(36));
+        assert_eq!(channel_for_frequency(5_935), Some(2));
+        assert_eq!(channel_for_frequency(6_115), Some(33));
+    }
+
+    #[test]
+    fn frequency_bands_include_wifi_6e() {
+        assert_eq!(frequency_band(2_437), "2.4 GHz");
+        assert_eq!(frequency_band(5_180), "5 GHz");
+        assert_eq!(frequency_band(6_115), "6 GHz");
+    }
+}
diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/qr.rs b/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/qr.rs
new file mode 100644
index 0000000..86976aa
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/qr.rs
@@ -0,0 +1,192 @@
+use std::{env, ffi::OsString, process::Stdio, sync::Arc};
+
+use tokio::io::AsyncWriteExt;
+use wayle_network::{NetworkService, core::settings_connection::ConnectionSettings};
+use zbus::zvariant::OwnedValue;
+
+const SECURITY_SETTING: &str = "802-11-wireless-security";
+
+pub(super) async fn render(network: Arc<NetworkService>, ssid: String) -> Result<Vec<u8>, String> {
+    let profile = super::info::active_profile(&network, &ssid)
+        .await
+        .ok_or_else(|| {
+            String::from("No saved NetworkManager profile was found for this connection.")
+        })?;
+    let payload = payload_for_profile(&profile, &ssid).await?;
+    encode(&payload).await
+}
+
+async fn payload_for_profile(profile: &ConnectionSettings, ssid: &str) -> Result<String, String> {
+    let settings = profile
+        .get_settings()
+        .await
+        .map_err(|error| format!("Could not read the saved WiFi profile: {error}"))?;
+
+    let hidden = settings
+        .get("802-11-wireless")
+        .and_then(|wireless| wireless.get("hidden"))
+        .and_then(bool_value)
+        .unwrap_or(false);
+
+    let Some(security) = settings.get(SECURITY_SETTING) else {
+        return Ok(wifi_qr_payload(ssid, "nopass", None, hidden));
+    };
+
+    let key_mgmt = security.get("key-mgmt").and_then(string_value);
+    if matches!(key_mgmt.as_deref(), Some("owe")) {
+        return Err(String::from(
+            "Enhanced Open (OWE) networks are not supported by the WiFi QR format.",
+        ));
+    }
+    if matches!(
+        key_mgmt.as_deref(),
+        Some("wpa-eap" | "wpa-eap-suite-b-192" | "ieee8021x")
+    ) {
+        return Err(String::from(
+            "Enterprise WiFi credentials cannot be represented by this QR format.",
+        ));
+    }
+
+    let secrets = profile
+        .get_secrets(SECURITY_SETTING)
+        .await
+        .map_err(|error| format!("NetworkManager did not provide the saved password: {error}"))?;
+    let secrets = secrets.get(SECURITY_SETTING).ok_or_else(|| {
+        String::from("NetworkManager did not return a saved password for this profile.")
+    })?;
+
+    let (authentication, password) = match key_mgmt.as_deref() {
+        Some("wpa-psk" | "wpa-none" | "sae") => {
+            ("WPA", secret_string(secrets.get("psk"), "WPA password")?)
+        }
+        Some("none") => ("WEP", secret_string(secrets.get("wep-key0"), "WEP key")?),
+        Some(other) => {
+            return Err(format!(
+                "The saved WiFi security type ({other}) cannot be shared as a QR code."
+            ));
+        }
+        None => {
+            if let Some(password) = secrets.get("psk").and_then(string_value) {
+                ("WPA", password)
+            } else if let Some(password) = secrets.get("wep-key0").and_then(string_value) {
+                ("WEP", password)
+            } else {
+                return Err(String::from(
+                    "NetworkManager did not return a saved password for this profile.",
+                ));
+            }
+        }
+    };
+
+    Ok(wifi_qr_payload(
+        ssid,
+        authentication,
+        Some(&password),
+        hidden,
+    ))
+}
+
+fn secret_string(value: Option<&OwnedValue>, name: &str) -> Result<String, String> {
+    value
+        .and_then(string_value)
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| format!("NetworkManager did not return the saved {name}."))
+}
+
+fn string_value(value: &OwnedValue) -> Option<String> {
+    String::try_from(value.clone()).ok()
+}
+
+fn bool_value(value: &OwnedValue) -> Option<bool> {
+    bool::try_from(value.clone()).ok()
+}
+
+async fn encode(payload: &str) -> Result<Vec<u8>, String> {
+    let mut child = tokio::process::Command::new(qrencode_binary())
+        .args(["-t", "PNG", "-s", "10", "-m", "4", "-o", "-"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|error| format!("Could not start qrencode: {error}"))?;
+
+    let mut input = child
+        .stdin
+        .take()
+        .ok_or_else(|| String::from("qrencode standard input is unavailable."))?;
+    input
+        .write_all(payload.as_bytes())
+        .await
+        .map_err(|error| format!("Could not send WiFi details to qrencode: {error}"))?;
+    drop(input);
+
+    let output = child
+        .wait_with_output()
+        .await
+        .map_err(|error| format!("Could not read the QR image: {error}"))?;
+    if !output.status.success() {
+        let detail = String::from_utf8_lossy(&output.stderr);
+        return Err(format!("qrencode failed: {}", detail.trim()));
+    }
+    if output.stdout.is_empty() {
+        return Err(String::from("qrencode returned an empty image."));
+    }
+
+    Ok(output.stdout)
+}
+
+fn qrencode_binary() -> OsString {
+    env::var_os("WAYLE_QRENCODE").unwrap_or_else(|| OsString::from("qrencode"))
+}
+
+fn wifi_qr_payload(
+    ssid: &str,
+    authentication: &str,
+    password: Option<&str>,
+    hidden: bool,
+) -> String {
+    let mut payload = format!(
+        "WIFI:T:{};S:{};",
+        wifi_qr_escape(authentication),
+        wifi_qr_escape(ssid)
+    );
+    if let Some(password) = password {
+        payload.push_str("P:");
+        payload.push_str(&wifi_qr_escape(password));
+        payload.push(';');
+    }
+    payload.push_str(if hidden { "H:true;;" } else { "H:false;;" });
+    payload
+}
+
+fn wifi_qr_escape(value: &str) -> String {
+    let mut escaped = String::with_capacity(value.len());
+    for character in value.chars() {
+        if matches!(character, '\\' | ';' | ',' | ':' | '"') {
+            escaped.push('\\');
+        }
+        escaped.push(character);
+    }
+    escaped
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn payload_escapes_wifi_qr_delimiters() {
+        assert_eq!(
+            wifi_qr_payload("Cafe;Guest", "WPA", Some("a:b,c\\d"), false),
+            "WIFI:T:WPA;S:Cafe\\;Guest;P:a\\:b\\,c\\\\d;H:false;;"
+        );
+    }
+
+    #[test]
+    fn payload_marks_hidden_open_networks() {
+        assert_eq!(
+            wifi_qr_payload("Hidden", "nopass", None, true),
+            "WIFI:T:nopass;S:Hidden;H:true;;"
+        );
+    }
+}
