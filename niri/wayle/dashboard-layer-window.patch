+    /// Toggles the dashboard in a real layer-shell window.
+    ///
+    /// A request initiated by Waybar cannot safely create a GTK popover: the
+    /// input serial belongs to another client. A normal layer surface has no
+    /// popup grab requirement, so it can be shown reliably from D-Bus.
+    fn toggle_external_window(&self, monitor: &gdk::Monitor, style: DropdownStyle) -> bool {
+        if let Some(window) = self.external_window.borrow().as_ref() {
+            if window.is_visible() {
+                window.set_visible(false);
+            } else {
+                window.set_keyboard_mode(KeyboardMode::OnDemand);
+                window.present();
+            }
+            return true;
+        }
+
+        let Some(controller) = self
+            .controller
+            .downcast_ref::<Controller<DashboardDropdown>>()
+        else {
+            warn!("external layer window is only supported by the dashboard dropdown");
+            return false;
+        };
+
+        let Some(content) = self.popover.child() else {
+            warn!("dashboard popover has no content for its external layer window");
+            return false;
+        };
+        self.popover.set_child(Option::<&gtk::Widget>::None);
+
+        let window = gtk::Window::new();
+        window.set_application(Some(&relm4::main_application()));
+        window.set_decorated(false);
+        window.set_resizable(false);
+        window.add_css_class("dashboard-dropdown");
+        window.add_css_class("dashboard-layer-window");
+        window.set_opacity(style.opacity);
+        if style.shadow_enabled {
+            window.add_css_class("shadow");
+        }
+
+        window.init_layer_shell();
+        window.set_namespace(Some("wayle-dashboard"));
+        window.set_layer(Layer::Overlay);
+        window.set_keyboard_mode(KeyboardMode::OnDemand);
+        window.set_exclusive_zone(0);
+        window.set_monitor(Some(monitor));
+        Self::position_external_window(&window, style.location);
+        window.set_child(Some(&content));
+
+        controller.emit(DashboardDropdownMsg::SetExternalHost(window.clone()));
+        window.present();
+        self.external_window.replace(Some(window));
+        true
+    }
+
+    fn position_external_window(window: &gtk::Window, location: Location) {
+        const WAYBAR_SIZE: i32 = 40;
+        const GAP: i32 = 6;
+        const OFFSET: i32 = WAYBAR_SIZE + GAP;
+
+        match location {
+            Location::Top => {
+                window.set_anchor(Edge::Top, true);
+                window.set_anchor(Edge::Left, true);
+                window.set_margin(Edge::Top, OFFSET);
+                window.set_margin(Edge::Left, GAP);
+            }
+            Location::Bottom => {
+                window.set_anchor(Edge::Bottom, true);
+                window.set_anchor(Edge::Left, true);
+                window.set_margin(Edge::Bottom, OFFSET);
+                window.set_margin(Edge::Left, GAP);
+            }
+            Location::Left => {
+                window.set_anchor(Edge::Top, true);
+                window.set_anchor(Edge::Left, true);
+                window.set_margin(Edge::Top, GAP);
+                window.set_margin(Edge::Left, OFFSET);
+            }
+            Location::Right => {
+                window.set_anchor(Edge::Top, true);
+                window.set_anchor(Edge::Right, true);
+                window.set_margin(Edge::Top, GAP);
+                window.set_margin(Edge::Right, OFFSET);
+            }
+        }
+    }
