new file mode 100644
index 0000000000000000000000000000000000000000..66f187065af917153f84c0f2e2721ccc084106a4
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/network/active_connections/qr.rs
@@ -0,0 +1,206 @@
+use std::{env, ffi::OsString, process::Stdio, sync::Arc};
+
+use tokio::io::AsyncWriteExt;
+use wayle_network::{
+    NetworkService,
+    core::{access_point::Ssid, settings_connection::ConnectionSettings},
+};
+use zbus::zvariant::OwnedValue;
+
+const SECURITY_SETTING: &str = "802-11-wireless-security";
+
+pub(super) async fn render(network: Arc<NetworkService>, ssid: String) -> Result<Vec<u8>, String> {
+    let stored_ssid = Ssid::new(ssid.as_bytes().to_vec());
+    let profiles = network.settings.connections_for_ssid(&stored_ssid);
+
+    if profiles.is_empty() {
+        return Err(String::from(
+            "No saved NetworkManager profile was found for this connection.",
+        ));
+    }
+
+    let mut last_error = None;
+    for profile in profiles {
+        match payload_for_profile(&profile, &ssid).await {
+            Ok(payload) => return encode(&payload).await,
+            Err(error) => last_error = Some(error),
+        }
+    }
+
+    Err(last_error.unwrap_or_else(|| String::from("This WiFi profile cannot be shared.")))
+}
+
+async fn payload_for_profile(profile: &ConnectionSettings, ssid: &str) -> Result<String, String> {
+    let settings = profile
+        .get_settings()
+        .await
+        .map_err(|error| format!("Could not read the saved WiFi profile: {error}"))?;
+
+    let hidden = settings
+        .get("802-11-wireless")
+        .and_then(|wireless| wireless.get("hidden"))
+        .and_then(bool_value)
+        .unwrap_or(false);
+
+    let Some(security) = settings.get(SECURITY_SETTING) else {
+        return Ok(wifi_qr_payload(ssid, "nopass", None, hidden));
+    };
+
+    let key_mgmt = security.get("key-mgmt").and_then(string_value);
+    if matches!(key_mgmt.as_deref(), Some("owe")) {
+        return Err(String::from(
+            "Enhanced Open (OWE) networks are not supported by the WiFi QR format.",
+        ));
+    }
+    if matches!(
+        key_mgmt.as_deref(),
+        Some("wpa-eap" | "wpa-eap-suite-b-192" | "ieee8021x")
+    ) {
+        return Err(String::from(
+            "Enterprise WiFi credentials cannot be represented by this QR format.",
+        ));
+    }
+
+    let secrets = profile
+        .get_secrets(SECURITY_SETTING)
+        .await
+        .map_err(|error| format!("NetworkManager did not provide the saved password: {error}"))?;
+    let secrets = secrets.get(SECURITY_SETTING).ok_or_else(|| {
+        String::from("NetworkManager did not return a saved password for this profile.")
+    })?;
+
+    let (authentication, password) = match key_mgmt.as_deref() {
+        Some("wpa-psk" | "wpa-none" | "sae") => {
+            ("WPA", secret_string(secrets.get("psk"), "WPA password")?)
+        }
+        Some("none") => ("WEP", secret_string(secrets.get("wep-key0"), "WEP key")?),
+        Some(other) => {
+            return Err(format!(
+                "The saved WiFi security type ({other}) cannot be shared as a QR code."
+            ));
+        }
+        None => {
+            if let Some(password) = secrets.get("psk").and_then(string_value) {
+                ("WPA", password)
+            } else if let Some(password) = secrets.get("wep-key0").and_then(string_value) {
+                ("WEP", password)
+            } else {
+                return Err(String::from(
+                    "NetworkManager did not return a saved password for this profile.",
+                ));
+            }
+        }
+    };
+
+    Ok(wifi_qr_payload(
+        ssid,
+        authentication,
+        Some(&password),
+        hidden,
+    ))
+}
+
+fn secret_string(value: Option<&OwnedValue>, name: &str) -> Result<String, String> {
+    value
+        .and_then(string_value)
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| format!("NetworkManager did not return the saved {name}."))
+}
+
+fn string_value(value: &OwnedValue) -> Option<String> {
+    String::try_from(value.clone()).ok()
+}
+
+fn bool_value(value: &OwnedValue) -> Option<bool> {
+    bool::try_from(value.clone()).ok()
+}
+
+async fn encode(payload: &str) -> Result<Vec<u8>, String> {
+    let mut child = tokio::process::Command::new(qrencode_binary())
+        .args(["-t", "PNG", "-s", "7", "-m", "3", "-o", "-"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|error| format!("Could not start qrencode: {error}"))?;
+
+    let mut input = child
+        .stdin
+        .take()
+        .ok_or_else(|| String::from("qrencode standard input is unavailable."))?;
+    input
+        .write_all(payload.as_bytes())
+        .await
+        .map_err(|error| format!("Could not send WiFi details to qrencode: {error}"))?;
+    drop(input);
+
+    let output = child
+        .wait_with_output()
+        .await
+        .map_err(|error| format!("Could not read the QR image: {error}"))?;
+    if !output.status.success() {
+        let detail = String::from_utf8_lossy(&output.stderr);
+        return Err(format!("qrencode failed: {}", detail.trim()));
+    }
+    if output.stdout.is_empty() {
+        return Err(String::from("qrencode returned an empty image."));
+    }
+
+    Ok(output.stdout)
+}
+
+fn qrencode_binary() -> OsString {
+    env::var_os("WAYLE_QRENCODE").unwrap_or_else(|| OsString::from("qrencode"))
+}
+
+fn wifi_qr_payload(
+    ssid: &str,
+    authentication: &str,
+    password: Option<&str>,
+    hidden: bool,
+) -> String {
+    let mut payload = format!(
+        "WIFI:T:{};S:{};",
+        wifi_qr_escape(authentication),
+        wifi_qr_escape(ssid)
+    );
+    if let Some(password) = password {
+        payload.push_str("P:");
+        payload.push_str(&wifi_qr_escape(password));
+        payload.push(';');
+    }
+    payload.push_str(if hidden { "H:true;;" } else { "H:false;;" });
+    payload
+}
+
+fn wifi_qr_escape(value: &str) -> String {
+    let mut escaped = String::with_capacity(value.len());
+    for character in value.chars() {
+        if matches!(character, '\\' | ';' | ',' | ':' | '"') {
+            escaped.push('\\');
+        }
+        escaped.push(character);
+    }
+    escaped
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn payload_escapes_wifi_qr_delimiters() {
+        assert_eq!(
+            wifi_qr_payload("Cafe;Guest", "WPA", Some("a:b,c\\d"), false),
+            "WIFI:T:WPA;S:Cafe\\;Guest;P:a\\:b\\,c\\\\d;H:false;;"
+        );
+    }
+
+    #[test]
+    fn payload_marks_hidden_open_networks() {
+        assert_eq!(
+            wifi_qr_payload("Hidden", "nopass", None, true),
+            "WIFI:T:nopass;S:Hidden;H:true;;"
+        );
+    }
+}
