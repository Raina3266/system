@@ -0,0 +1,29 @@
+use std::sync::Arc;
+
+use wayle_network::NetworkService;
+
+pub(super) async fn render(
+    _network: Arc<NetworkService>,
+    ssid: String,
+) -> Result<Vec<u8>, String> {
+    let output = tokio::process::Command::new(super::info::network_manager_binary())
+        .arg("wayle-qr")
+        .arg(&ssid)
+        .output()
+        .await
+        .map_err(|error| format!("Could not start network-manager: {error}"))?;
+
+    if !output.status.success() {
+        let detail = String::from_utf8_lossy(&output.stderr);
+        return Err(if detail.trim().is_empty() {
+            format!("network-manager exited with {}", output.status)
+        } else {
+            detail.trim().to_owned()
+        });
+    }
+    if output.stdout.is_empty() {
+        return Err(String::from("network-manager returned an empty QR image."));
+    }
+
+    Ok(output.stdout)
+}
