+    /// Hides the bar without unmapping it, so it stays usable as the GTK
+    /// anchor for dropdowns opened from an external bar.
+    ///
+    /// Unmapping is what upstream does for `show = false`, but a GTK popover
+    /// can only be presented from a surface the compositor has already mapped,
+    /// and mapping a layer surface costs a configure round-trip plus a frame.
+    /// Anchor-only mode keeps the window mapped and makes it invisible
+    /// instead: the sections are hidden, the CSS below drops the background,
+    /// borders, shadow and padding, the exclusive zone is released, and an
+    /// empty input region lets clicks through to whatever is underneath.
+    pub(super) fn apply_anchor_only(
+        window: &gtk::Window,
+        right_factory: &gtk::Box,
+        anchor_only: bool,
+        exclusive: bool,
+    ) {
+        if anchor_only {
+            window.add_css_class(ANCHOR_ONLY_CLASS);
+            window.set_exclusive_zone(0);
+        } else {
+            window.remove_css_class(ANCHOR_ONLY_CLASS);
+            Self::apply_exclusive_zone(window, exclusive);
+        }
+
+        // The right section keeps its own visibility so the anchor widget
+        // appended after it stays mapped; only the factory content is hidden.
+        if let Some(center_box) = window
+            .child()
+            .and_then(|child| child.downcast::<gtk::CenterBox>().ok())
+        {
+            if let Some(start) = center_box.start_widget() {
+                start.set_visible(!anchor_only);
+            }
+            if let Some(center) = center_box.center_widget() {
+                center.set_visible(!anchor_only);
+            }
+        }
+        right_factory.set_visible(!anchor_only);
+
+        Self::apply_input_region(window, anchor_only);
+    }
+
+    /// Makes the window click-through while it is only an anchor.
+    ///
+    /// Re-applied from the window's `map` handler because the surface does not
+    /// exist before the window is realized.
+    pub(super) fn apply_input_region(window: &gtk::Window, anchor_only: bool) {
+        let Some(surface) = window.surface() else {
+            return;
+        };
+
+        if anchor_only {
+            surface.set_input_region(Some(&gtk::cairo::Region::create()));
+        } else {
+            surface.set_input_region(None);
+        }
+    }
