+++ b/crates/wayle-shell/src/shell/bar/dropdowns/notification/network_stats.rs
@@ -0,0 +1,237 @@
+use std::sync::Arc;
+
+use gtk::prelude::*;
+use relm4::{gtk, prelude::*};
+use wayle_sysinfo::{SysinfoService, types::NetworkData};
+use wayle_widgets::watch;
+
+pub(super) struct NetworkStatsInit {
+    pub sysinfo: Arc<SysinfoService>,
+}
+
+/// Formatted figures for the busiest interface, pushed by the sysinfo watcher.
+///
+/// `watch!` feeds the command channel, so the formatting happens off the
+/// widget tree and the component only swaps strings.
+#[derive(Debug)]
+pub(super) struct NetworkStatsCmd {
+    interface: String,
+    download_speed: String,
+    upload_speed: String,
+    total_download: String,
+    total_upload: String,
+}
+
+impl NetworkStatsCmd {
+    fn from_data(networks: &[NetworkData]) -> Self {
+        let Some(network) = networks
+            .iter()
+            .filter(|network| !network.interface.starts_with("lo"))
+            .max_by_key(|network| network.rx_bytes_per_sec + network.tx_bytes_per_sec)
+        else {
+            return Self {
+                interface: String::from("--"),
+                download_speed: format_rate(0),
+                upload_speed: format_rate(0),
+                total_download: format_bytes(0),
+                total_upload: format_bytes(0),
+            };
+        };
+
+        Self {
+            interface: network.interface.clone(),
+            download_speed: format_rate(network.rx_bytes_per_sec),
+            upload_speed: format_rate(network.tx_bytes_per_sec),
+            total_download: format_bytes(network.rx_bytes),
+            total_upload: format_bytes(network.tx_bytes),
+        }
+    }
+}
+
+pub(super) struct NetworkStatsSection {
+    /// Held only to keep the service alive: dropping the last handle cancels
+    /// its polling tasks, which would freeze these figures.
+    _sysinfo: Arc<SysinfoService>,
+    interface: String,
+    download_speed: String,
+    upload_speed: String,
+    total_download: String,
+    total_upload: String,
+}
+
+#[relm4::component(pub(super))]
+impl Component for NetworkStatsSection {
+    type Init = NetworkStatsInit;
+    type Input = ();
+    type Output = ();
+    type CommandOutput = NetworkStatsCmd;
+
+    view! {
+        #[root]
+        gtk::Box {
+            set_css_classes: &["card", "dashboard-card", "control-center-system"],
+            set_orientation: gtk::Orientation::Vertical,
+
+            gtk::Box {
+                add_css_class: "card-header",
+
+                gtk::Box {
+                    add_css_class: "card-title",
+
+                    gtk::Image {
+                        set_icon_name: Some("ld-network-symbolic"),
+                    },
+
+                    gtk::Label {
+                        set_label: "Network",
+                    },
+                },
+
+                gtk::Label {
+                    add_css_class: "control-center-calendar-date",
+                    set_hexpand: true,
+                    set_halign: gtk::Align::End,
+                    #[watch]
+                    set_label: &model.interface,
+                },
+            },
+
+            gtk::Box {
+                set_orientation: gtk::Orientation::Vertical,
+
+                gtk::Box {
+                    add_css_class: "stat-row",
+
+                    gtk::Label {
+                        add_css_class: "stat-label",
+                        set_hexpand: true,
+                        set_halign: gtk::Align::Start,
+                        set_label: "Download",
+                    },
+
+                    gtk::Label {
+                        add_css_class: "ring-text",
+                        #[watch]
+                        set_label: &model.download_speed,
+                    },
+                },
+
+                gtk::Box {
+                    add_css_class: "stat-row",
+
+                    gtk::Label {
+                        add_css_class: "stat-label",
+                        set_hexpand: true,
+                        set_halign: gtk::Align::Start,
+                        set_label: "Upload",
+                    },
+
+                    gtk::Label {
+                        add_css_class: "ring-text",
+                        #[watch]
+                        set_label: &model.upload_speed,
+                    },
+                },
+
+                gtk::Box {
+                    add_css_class: "stat-row",
+
+                    gtk::Label {
+                        add_css_class: "stat-label",
+                        set_hexpand: true,
+                        set_halign: gtk::Align::Start,
+                        set_label: "Downloaded",
+                    },
+
+                    gtk::Label {
+                        add_css_class: "ring-text",
+                        #[watch]
+                        set_label: &model.total_download,
+                    },
+                },
+
+                gtk::Box {
+                    add_css_class: "stat-row",
+
+                    gtk::Label {
+                        add_css_class: "stat-label",
+                        set_hexpand: true,
+                        set_halign: gtk::Align::Start,
+                        set_label: "Uploaded",
+                    },
+
+                    gtk::Label {
+                        add_css_class: "ring-text",
+                        #[watch]
+                        set_label: &model.total_upload,
+                    },
+                },
+            },
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let network = init.sysinfo.network.clone();
+        let initial = NetworkStatsCmd::from_data(&network.get());
+
+        // The sysinfo service only polls interfaces while the property has a
+        // subscriber, so this watcher is what keeps the figures moving.
+        watch!(sender, [network.watch()], |out| {
+            let _ = out.send(NetworkStatsCmd::from_data(&network.get()));
+        });
+
+        let model = Self {
+            _sysinfo: init.sysinfo,
+            interface: initial.interface,
+            download_speed: initial.download_speed,
+            upload_speed: initial.upload_speed,
+            total_download: initial.total_download,
+            total_upload: initial.total_upload,
+        };
+
+        let widgets = view_output!();
+        ComponentParts { model, widgets }
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        _sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        self.interface = msg.interface;
+        self.download_speed = msg.download_speed;
+        self.upload_speed = msg.upload_speed;
+        self.total_download = msg.total_download;
+        self.total_upload = msg.total_upload;
+    }
+}
+
+fn format_rate(bytes_per_sec: u64) -> String {
+    format!("{}/s", format_bytes(bytes_per_sec))
+}
+
+/// Formats a byte count with three significant figures, so the column width
+/// stays put as the value climbs through the units.
+fn format_bytes(bytes: u64) -> String {
+    const UNITS: [&str; 5] = ["B", "KiB", "MiB", "GiB", "TiB"];
+
+    let mut value = bytes as f64;
+    let mut unit = 0;
+    while value >= 1024.0 && unit < UNITS.len() - 1 {
+        value /= 1024.0;
+        unit += 1;
+    }
+
+    if unit == 0 || value >= 100.0 {
+        format!("{value:.0} {}", UNITS[unit])
+    } else if value >= 10.0 {
+        format!("{value:.1} {}", UNITS[unit])
+    } else {
+        format!("{value:.2} {}", UNITS[unit])
+    }
+}
