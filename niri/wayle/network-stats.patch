diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/notification/network_stats.rs b/crates/wayle-shell/src/shell/bar/dropdowns/notification/network_stats.rs
new file mode 100644
index 0000000..3a3d75f
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/notification/network_stats.rs
@@ -0,0 +1,181 @@
+use std::sync::Arc;
+
+use gtk::prelude::*;
+use relm4::{gtk, prelude::*};
+use wayle_sysinfo::{SysinfoService, types::NetworkData};
+use wayle_widgets::watch;
+
+const DOWN_ARROW: &str = "\u{2193}";
+const UP_ARROW: &str = "\u{2191}";
+
+pub(super) struct NetworkStatsInit {
+    pub sysinfo: Arc<SysinfoService>,
+}
+
+/// One line of figures for the busiest interface, pushed by the sysinfo
+/// watcher so the formatting happens off the widget tree.
+///
+/// The card is a single row, so the session totals do not fit on it; they go
+/// to the tooltip rather than being dropped.
+#[derive(Debug)]
+pub(super) struct NetworkStatsCmd {
+    interface: String,
+    download: String,
+    upload: String,
+    totals: String,
+}
+
+impl NetworkStatsCmd {
+    fn from_data(networks: &[NetworkData]) -> Self {
+        let Some(network) = networks
+            .iter()
+            .filter(|network| !network.interface.starts_with("lo"))
+            .max_by_key(|network| network.rx_bytes_per_sec + network.tx_bytes_per_sec)
+        else {
+            return Self {
+                interface: String::from("--"),
+                download: format_rate(DOWN_ARROW, 0),
+                upload: format_rate(UP_ARROW, 0),
+                totals: format_totals(0, 0),
+            };
+        };
+
+        Self {
+            interface: network.interface.clone(),
+            download: format_rate(DOWN_ARROW, network.rx_bytes_per_sec),
+            upload: format_rate(UP_ARROW, network.tx_bytes_per_sec),
+            totals: format_totals(network.rx_bytes, network.tx_bytes),
+        }
+    }
+}
+
+pub(super) struct NetworkStatsSection {
+    /// Held only to keep the service alive: dropping the last handle cancels
+    /// its polling tasks, which would freeze these figures.
+    _sysinfo: Arc<SysinfoService>,
+    interface: String,
+    download: String,
+    upload: String,
+    totals: String,
+}
+
+#[relm4::component(pub(super))]
+impl Component for NetworkStatsSection {
+    type Init = NetworkStatsInit;
+    type Input = ();
+    type Output = ();
+    type CommandOutput = NetworkStatsCmd;
+
+    view! {
+        #[root]
+        gtk::Box {
+            set_css_classes: &["card", "dashboard-card", "control-center-network"],
+            set_orientation: gtk::Orientation::Horizontal,
+            #[watch]
+            set_tooltip_text: Some(&model.totals),
+
+            gtk::Image {
+                add_css_class: "control-center-network-icon",
+                set_icon_name: Some("ld-network-symbolic"),
+            },
+
+            gtk::Label {
+                add_css_class: "control-center-network-interface",
+                set_ellipsize: gtk::pango::EllipsizeMode::End,
+                set_max_width_chars: 1,
+                set_xalign: 0.0,
+                #[watch]
+                set_label: &model.interface,
+            },
+
+            gtk::Box {
+                add_css_class: "control-center-network-rates",
+                set_hexpand: true,
+                set_halign: gtk::Align::End,
+
+                gtk::Label {
+                    add_css_class: "control-center-network-rate",
+                    #[watch]
+                    set_label: &model.download,
+                },
+
+                gtk::Label {
+                    add_css_class: "control-center-network-rate",
+                    #[watch]
+                    set_label: &model.upload,
+                },
+            },
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let network = init.sysinfo.network.clone();
+        let initial = NetworkStatsCmd::from_data(&network.get());
+
+        // The sysinfo service only polls interfaces while the property has a
+        // subscriber, so this watcher is what keeps the figures moving.
+        watch!(sender, [network.watch()], |out| {
+            let _ = out.send(NetworkStatsCmd::from_data(&network.get()));
+        });
+
+        let model = Self {
+            _sysinfo: init.sysinfo,
+            interface: initial.interface,
+            download: initial.download,
+            upload: initial.upload,
+            totals: initial.totals,
+        };
+
+        let widgets = view_output!();
+        ComponentParts { model, widgets }
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        _sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        self.interface = msg.interface;
+        self.download = msg.download;
+        self.upload = msg.upload;
+        self.totals = msg.totals;
+    }
+}
+
+fn format_rate(arrow: &str, bytes_per_sec: u64) -> String {
+    format!("{arrow} {}/s", format_bytes(bytes_per_sec))
+}
+
+fn format_totals(rx_bytes: u64, tx_bytes: u64) -> String {
+    format!(
+        "{} down, {} up since Wayle started",
+        format_bytes(rx_bytes),
+        format_bytes(tx_bytes)
+    )
+}
+
+/// Formats a byte count with three significant figures, so the row's width
+/// stays put as the value climbs through the units.
+fn format_bytes(bytes: u64) -> String {
+    const UNITS: [&str; 5] = ["B", "KiB", "MiB", "GiB", "TiB"];
+
+    let mut value = bytes as f64;
+    let mut unit = 0;
+    while value >= 1024.0 && unit < UNITS.len() - 1 {
+        value /= 1024.0;
+        unit += 1;
+    }
+
+    if unit == 0 || value >= 100.0 {
+        format!("{value:.0} {}", UNITS[unit])
+    } else if value >= 10.0 {
+        format!("{value:.1} {}", UNITS[unit])
+    } else {
+        format!("{value:.2} {}", UNITS[unit])
+    }
+}
