+/// One row's text, checked state and port, without the device handle.
+#[derive(Debug, PartialEq, Eq)]
+struct RowShape {
+    description: String,
+    subtitle: Option<String>,
+    is_active: bool,
+    port: Option<String>,
+}
+
+/// Splits a device into the rows that stand for its outputs.
+///
+/// A device whose profile exposes several plugged-in ports becomes one row per
+/// port, because speakers and a headphone jack are separate destinations to
+/// choose between. Ports the card reports as unplugged are left out; ports of
+/// unknown availability stay selectable. Anything else stays a single device
+/// row subtitled with the port it is currently using.
+fn port_rows(
+    description: &str,
+    ports: &[DevicePort],
+    active_port: &Option<String>,
+    device_is_target: bool,
+) -> Vec<RowShape> {
+    let mut selectable: Vec<&DevicePort> = ports.iter().filter(|port| port.available).collect();
+
+    if selectable.len() < 2 {
+        return vec![RowShape {
+            description: description.to_owned(),
+            subtitle: helpers::active_port_description(active_port, ports),
+            is_active: device_is_target,
+            port: None,
+        }];
+    }
+
+    selectable.sort_by(|left, right| right.priority.cmp(&left.priority));
+
+    selectable
+        .into_iter()
+        .map(|port| RowShape {
+            description: port.description.clone(),
+            subtitle: Some(description.to_owned()),
+            is_active: device_is_target && active_port.as_deref() == Some(port.name.as_str()),
+            port: Some(port.name.clone()),
         })
         .collect()
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn port(name: &str, description: &str, priority: u32, available: bool) -> DevicePort {
+        DevicePort {
+            name: name.to_owned(),
+            description: description.to_owned(),
+            priority,
+            available,
+        }
+    }
+
+    fn shapes(ports: &[DevicePort], active: Option<&str>, is_target: bool) -> Vec<RowShape> {
+        port_rows(
+            "Built-in Audio",
+            ports,
+            &active.map(str::to_owned),
+            is_target,
+        )
+    }
+
+    #[test]
+    fn single_port_device_stays_one_row() {
+        let ports = [port("analog-output-speaker", "Speaker", 10_000, true)];
+        let rows = shapes(&ports, Some("analog-output-speaker"), true);
+
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].description, "Built-in Audio");
+        assert_eq!(rows[0].subtitle.as_deref(), Some("Speaker"));
+        assert_eq!(rows[0].port, None);
+        assert!(rows[0].is_active);
+    }
+
+    #[test]
+    fn device_without_ports_has_no_subtitle() {
+        let rows = shapes(&[], None, false);
+
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].subtitle, None);
+        assert!(!rows[0].is_active);
+    }
+
+    #[test]
+    fn plugged_ports_become_their_own_rows() {
+        let ports = [
+            port("analog-output-speaker", "Speaker", 10_000, true),
+            port("analog-output-headphones", "Headphones", 9_000, true),
+        ];
+        let rows = shapes(&ports, Some("analog-output-headphones"), true);
+
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[0].description, "Speaker");
+        assert_eq!(rows[0].subtitle.as_deref(), Some("Built-in Audio"));
+        assert_eq!(rows[1].description, "Headphones");
+    }
+
+    #[test]
+    fn only_the_active_port_of_the_target_device_is_checked() {
+        let ports = [
+            port("analog-output-speaker", "Speaker", 10_000, true),
+            port("analog-output-headphones", "Headphones", 9_000, true),
+        ];
+        let rows = shapes(&ports, Some("analog-output-headphones"), true);
+
+        assert!(!rows[0].is_active);
+        assert!(rows[1].is_active);
+    }
+
+    #[test]
+    fn ports_of_a_device_that_is_not_the_target_are_unchecked() {
+        let ports = [
+            port("analog-output-speaker", "Speaker", 10_000, true),
+            port("analog-output-headphones", "Headphones", 9_000, true),
+        ];
+        let rows = shapes(&ports, Some("analog-output-headphones"), false);
+
+        assert!(rows.iter().all(|row| !row.is_active));
+    }
+
+    #[test]
+    fn unplugged_ports_are_hidden() {
+        let ports = [
+            port("analog-output-speaker", "Speaker", 10_000, true),
+            port("analog-output-headphones", "Headphones", 9_000, false),
+        ];
+        let rows = shapes(&ports, Some("analog-output-speaker"), true);
+
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].description, "Built-in Audio");
+        assert_eq!(rows[0].subtitle.as_deref(), Some("Speaker"));
+    }
+
+    #[test]
+    fn rows_follow_port_priority() {
+        let ports = [
+            port("hdmi-output-1", "HDMI / DisplayPort 2", 100, true),
+            port("analog-output-speaker", "Speaker", 10_000, true),
+            port("hdmi-output-0", "HDMI / DisplayPort 1", 500, true),
+        ];
+        let rows = shapes(&ports, None, false);
+
+        let order: Vec<&str> = rows.iter().map(|row| row.description.as_str()).collect();
+        assert_eq!(
+            order,
+            ["Speaker", "HDMI / DisplayPort 1", "HDMI / DisplayPort 2"]
+        );
+    }
+}
