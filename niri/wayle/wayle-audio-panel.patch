+// The tab bar stands in for the dropdown header, so it carries the header's
+// padding and its separating border.
+.audio-tabs {
+    padding: var(--space-sm) var(--space-md);
+    border-spacing: var(--space-xs);
+    border-bottom: 1px solid var(--border-default);
+    background: var(--bg-elevated);
+    border-top-left-radius: var(--rounding-container);
+    border-top-right-radius: var(--rounding-container);
+
+    button.audio-tab {
+        border-radius: var(--rounding-element);
+        background: transparent;
+        padding: var(--space-xs) var(--space-sm);
+        transition:
+            background var(--duration-fast),
+            color var(--duration-fast);
+
+        label {
+            font-size: var(--text-md);
+            font-weight: var(--weight-medium);
+            color: var(--fg-muted);
+        }
+
+        &:hover {
+            background: var(--bg-overlay);
+
+            label {
+                color: var(--fg-default);
+            }
+        }
+
+        &.active {
+            background: var(--accent-subtle);
+
+            label {
+                color: var(--accent);
+                font-weight: var(--weight-semibold);
+            }
+        }
+    }
+}
+
+// The default-device row sits directly above the list it is chosen from, so it
+// spans the page rather than sitting in its own card.
+.audio-page {
+    .audio-device {
+        padding-left: 0;
+        padding-right: 0;
+    }
+
+    .picker-header {
+        padding-top: var(--space-sm);
+    }
+}
+
+// The Pair tab hosts the Bluetooth dropdown's own content, which arrives with
+// the container chrome and padding it uses when it is a dropdown of its own.
+.bluetooth-section > .dropdown {
+    background: transparent;
+    border: none;
+    box-shadow: none;
+    border-radius: 0;
+    min-width: 0;
+
+    > .dropdown-content {
+        padding: 0;
+    }
+
+    > .dropdown-header {
+        border-radius: var(--rounding-element);
+        margin-bottom: var(--space-sm);
+    }
+}
+
+button.audio-route-btn {
+    background: var(--bg-overlay);
+    color: var(--fg-muted);
+    margin-right: var(--space-xs);
+    transition:
+        background var(--duration-fast),
+        color var(--duration-fast);
+
+    image.audio-route-icon {
+        -gtk-icon-size: var(--icon-md);
+        margin: calc(var(--space-xs) * 1.5);
+    }
+
+    &:hover {
+        color: var(--fg-default);
+        background: var(--bg-hover);
+    }
+}
