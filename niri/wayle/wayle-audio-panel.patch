+impl DevicePicker {
+    /// Re-arms the per-device port watchers after the device list changed.
+    fn resume_device_watchers(&mut self, sender: &ComponentSender<Self>) {
+        let token = self.device_watcher.reset();
+        watchers::spawn_per_device(sender, &self.audio, self.kind, token);
+    }
+
+    /// Follows the routed stream's destination so the checked row is the one
+    /// the audio server actually chose.
+    fn resume_stream_watcher(&mut self, sender: &ComponentSender<Self>) {
+        let token = self.stream_watcher.reset();
+        if let Some(stream) = &self.stream {
+            watchers::spawn_stream(sender, stream, token);
+        }
