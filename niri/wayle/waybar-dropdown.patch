+//! External dropdown integration.
+
+use super::proxy::{format_ipc_error, shell_ipc_proxy};
+use crate::cli::CliAction;
+
+pub async fn execute(name: String, monitor: Option<String>) -> CliAction {
+    let (_connection, proxy) = shell_ipc_proxy().await?;
+    let monitor = monitor.unwrap_or_default();
+
+    proxy
+        .dropdown_toggle(&name, &monitor)
+        .await
+        .map_err(|err| format_ipc_error("toggle dropdown", err))?;
+
+    Ok(())
+}
