+    /// Toggles a dropdown on a monitor for integration with external bars.
+    pub async fn dropdown_toggle(&self, name: &str, monitor: &str, offset: i32) -> fdo::Result<()> {
+        if !crate::shell::bar::dropdowns::DROPDOWN_NAMES.contains(&name) {
+            return Err(fdo::Error::InvalidArgs(format!("unknown dropdown: {name}")));
+        }
+
+        let mut connectors = self.state.connectors.get();
+        connectors.sort();
+
+        // An external bar cannot name a monitor, so an empty argument means
+        // "wherever the user is". Fall back to the first connector only when
+        // no compositor reports focus, which at least stays deterministic.
+        let focused = self.state.focused_connector.get();
+        let monitor = if !monitor.is_empty() {
+            monitor
+        } else if let Some(connector) = focused
+            .as_deref()
+            .filter(|connector| connectors.iter().any(|item| item == connector))
+        {
+            connector
+        } else {
+            connectors.first().map(String::as_str).unwrap_or_default()
+        };
+
+        if !connectors.iter().any(|item| item == monitor) {
+            return Err(fdo::Error::InvalidArgs(format!(
+                "unknown monitor: {monitor}"
+            )));
+        }
+
+        let serial = self.state.dropdown_request.get().serial.wrapping_add(1);
+        self.state.dropdown_request.set(DropdownRequest {
+            serial,
+            name: name.to_owned(),
+            monitor: monitor.to_owned(),
+            offset: offset.max(0),
+        });
+        Ok(())
+    }
