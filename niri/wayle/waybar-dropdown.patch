+/// `GtkPopover` is an `xdg_popup` and must belong to a mapped surface in the
+/// same process. Waybar cannot provide that parent to Wayle, so external
+/// requests use a real layer surface and reuse only the dropdown's content.
+struct ExternalDropdownInstance {
+    window: gtk::Window,
+    content: gtk::Widget,
+    _source: Rc<DropdownInstance>,
+}
+
+impl ExternalDropdownInstance {
+    fn new(name: &str, source: Rc<DropdownInstance>, monitor: &gdk::Monitor) -> Option<Self> {
+        let Some(content) = source.popover.child() else {
+            warn!(
+                dropdown = name,
+                "dropdown has no content to host externally"
+            );
+            return None;
+        };
+        source.popover.set_child(None::<&gtk::Widget>);
+
+        // The component updates size requests on its original popover root.
+        // Mirror those properties onto the detached content so scale changes
+        // continue to resize the standalone surface.
+        content.set_width_request(source.popover.width_request());
+        content.set_height_request(source.popover.height_request());
+
+        let weak_content = content.downgrade();
+        source.popover.connect_width_request_notify(move |popover| {
+            if let Some(content) = weak_content.upgrade() {
+                content.set_width_request(popover.width_request());
+            }
+        });
+
+        let weak_content = content.downgrade();
+        source
+            .popover
+            .connect_height_request_notify(move |popover| {
+                if let Some(content) = weak_content.upgrade() {
+                    content.set_height_request(popover.height_request());
+                }
+            });
+
+        // Module-specific selectors such as `.notification-dropdown` used to
+        // live on the popover root. Preserve them on the standalone content.
+        for class in source.popover.css_classes() {
+            content.add_css_class(class.as_str());
+        }
+
+        let window = gtk::Window::builder()
+            .decorated(false)
+            .resizable(false)
+            .build();
+        window.add_css_class("external-dropdown-window");
+        window.init_layer_shell();
+        window.set_namespace(Some(&format!("wayle-external-{name}")));
+        // Ignore other exclusive zones and use the explicit external-bar
+        // offset. This keeps placement deterministic even when Waybar and
+        // Wayle use different layer-shell layers.
+        window.set_exclusive_zone(-1);
+        window.set_keyboard_mode(KeyboardMode::None);
+        window.set_monitor(Some(monitor));
+        window.set_child(Some(&content));
+
+        let visibility_source = source.clone();
+        window.connect_visible_notify(move |window| {
+            visibility_source.notify_visibility(window.is_visible());
+        });
+
+        window.connect_map(|window| {
+            debug!(
+                width = window.width(),
+                height = window.height(),
+                "external dropdown mapped"
+            );
+        });
+
+        let weak_window = window.downgrade();
+        let keys = gtk::EventControllerKey::new();
+        keys.connect_key_pressed(move |_, key, _, _| {
+            if key != gdk::Key::Escape {
+                return gtk::glib::Propagation::Proceed;
+            }
+
+            if let Some(window) = weak_window.upgrade() {
+                window.set_keyboard_mode(KeyboardMode::None);
+                window.set_visible(false);
+            }
+            gtk::glib::Propagation::Stop
+        });
+        window.add_controller(keys);
+
+        Some(Self {
+            window,
+            content,
+            _source: source,
+        })
+    }
+
+    fn show(&self, style: DropdownStyle, location: Location, offset: i32) {
+        reset_anchors(&self.window);
+
+        let position_class = match location {
+            Location::Top => {
+                self.window.set_anchor(Edge::Top, true);
+                self.window.set_margin(Edge::Top, offset);
+                "position-bottom"
+            }
+            Location::Bottom => {
+                self.window.set_anchor(Edge::Bottom, true);
+                self.window.set_margin(Edge::Bottom, offset);
+                "position-top"
+            }
+            Location::Left => {
+                self.window.set_anchor(Edge::Left, true);
+                self.window.set_margin(Edge::Left, offset);
+                "position-right"
+            }
+            Location::Right => {
+                self.window.set_anchor(Edge::Right, true);
+                self.window.set_margin(Edge::Right, offset);
+                "position-left"
+            }
+        };
+
+        for class in [
+            "position-top",
+            "position-bottom",
+            "position-left",
+            "position-right",
+        ] {
+            self.window.remove_css_class(class);
+        }
+        self.window.add_css_class(position_class);
+
+        self.content.set_margin_top(style.margins.top);
+        self.content.set_margin_bottom(style.margins.bottom);
+        self.content.set_margin_start(style.margins.start);
+        self.content.set_margin_end(style.margins.end);
+        self.window.set_opacity(style.opacity);
+
+        if style.shadow_enabled {
+            self.window.add_css_class("shadow");
+        } else {
+            self.window.remove_css_class("shadow");
+        }
+
+        self.window.set_keyboard_mode(KeyboardMode::OnDemand);
+        debug!(
+            offset,
+            position = position_class,
+            "opening external dropdown layer surface"
+        );
+        self.window.present();
+    }
+
+    fn hide(&self) {
+        self.window.set_keyboard_mode(KeyboardMode::None);
+        self.window.set_visible(false);
+    }
+}
+
+impl Drop for ExternalDropdownInstance {
+    fn drop(&mut self) {
+        self.window.destroy();
+    }
+}
