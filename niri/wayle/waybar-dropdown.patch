@@ -0,0 +1,45 @@
+//! Tracks which output holds compositor focus.
+//!
+//! IPC callers that toggle a dropdown from an external bar cannot name a
+//! monitor: a bar such as Waybar knows nothing about Wayle's connectors, and
+//! Wayland gives a client no way to ask where the pointer is. Publishing the
+//! focused connector lets the shell IPC daemon route those requests to the
+//! screen the user is on instead of whichever connector happens to sort first.
+
+use futures::StreamExt;
+use wayle_niri::NiriService;
+
+use crate::shell::ShellServices;
+
+/// Publishes the focused connector for as long as a compositor reports one.
+///
+/// Only niri is wired up; under any other compositor the property stays
+/// `None` and the daemon keeps its previous first-connector behaviour.
+pub(crate) fn spawn(services: &ShellServices) {
+    let Some(niri) = services.niri.clone() else {
+        return;
+    };
+
+    let focused = services.shell_ipc.state().focused_connector;
+    focused.set(focused_output(&niri));
+
+    tokio::spawn(async move {
+        let mut events = niri.events();
+
+        // Focus lives in a `Property` on each workspace rather than on the
+        // workspace map, so the map alone does not report focus moving. Every
+        // event is a cheap rescan, which keeps this independent of which
+        // event variants niri uses to describe a focus change.
+        while events.next().await.is_some() {
+            focused.set(focused_output(&niri));
+        }
+    });
+}
+
+fn focused_output(niri: &NiriService) -> Option<String> {
+    niri.workspaces
+        .get()
+        .values()
+        .find(|workspace| workspace.is_focused.get())
+        .and_then(|workspace| workspace.output.get())
+}
