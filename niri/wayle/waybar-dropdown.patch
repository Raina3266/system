+pub(super) fn calendar_summary() -> CalendarSummary {
+    let start = Local::now().date_naive();
+    let end = start + Duration::days(CALENDAR_DAYS - 1);
+    let date = format!("{} – {}", start.format("%-d %b"), end.format("%-d %b"));
+    let cache = fs::read_to_string(calendar_cache_path()).unwrap_or_default();
+    let parsed = serde_json::from_str::<Value>(&cache).unwrap_or(Value::Null);
+    let days = parsed.as_object();
+
+    let mut lines = Vec::new();
+    for offset in 0..CALENDAR_DAYS {
+        let day = start + Duration::days(offset);
+        let key = day.format("%Y-%m-%d").to_string();
+        let entries = days.map_or_else(Vec::new, |days| calendar_entries(days, &key));
+        if entries.is_empty() {
+            continue;
+        }
+
+        if !lines.is_empty() {
+            lines.push(String::new());
+        }
+        lines.push(if offset == 0 {
+            String::from("Today")
+        } else {
+            day.format("%A %-d %b").to_string()
+        });
+        lines.extend(
+            entries
+                .iter()
+                .map(|entry| format!("{}  {}", entry.icon, entry.title)),
+        );
+    }
+
+    if lines.is_empty() {
+        return CalendarSummary {
+            date,
+            entries: String::from("Nothing scheduled in the next 7 days"),
+            has_entries: false,
+        };
+    }
+
+    CalendarSummary {
+        date,
+        entries: lines.join("\n"),
+        has_entries: true,
+    }
+}
+
+pub(super) fn system_summary(sysinfo: &SysinfoService) -> SystemSummary {
+    let cpu = sysinfo.cpu.get();
+    let memory = sysinfo.memory.get();
+    let disks = sysinfo.disks.get();
+    let networks = sysinfo.network.get();
+
+    let frequency = cpu.avg_frequency_mhz as f64 / 1000.0;
+    let cpu_text = if cpu.avg_frequency_mhz == 0 {
+        format!("{:.0}%", cpu.usage_percent)
+    } else {
+        format!("{:.0}%  ·  {frequency:.1} GHz", cpu.usage_percent)
+    };
+
+    let memory_text = format!(
+        "{} / {}  ·  {:.0}%",
+        gibibytes(memory.used_bytes),
+        gibibytes(memory.total_bytes),
+        memory.usage_percent
+    );
+
+    let temperature = cpu.temperature_celsius.map_or_else(
+        || String::from("Unavailable"),
+        |value| format!("{value:.0} °C"),
+    );
+
+    let disk = disks
+        .iter()
+        .find(|disk| disk.mount_point.as_os_str() == "/")
+        .map_or_else(
+            || String::from("Unavailable"),
+            |disk| {
+                format!(
+                    "{} / {}  ·  {:.0}%",
+                    gibibytes(disk.used_bytes),
+                    gibibytes(disk.total_bytes),
+                    disk.usage_percent
+                )
+            },
+        );
+
+    let network = networks
+        .iter()
+        .filter(|network| network.interface != "lo")
+        .max_by_key(|network| network.rx_bytes_per_sec + network.tx_bytes_per_sec)
+        .map_or_else(
+            || String::from("↓ 0 B/s    ↑ 0 B/s"),
+            |network| {
+                format!(
+                    "↓ {}    ↑ {}",
+                    byte_rate(network.rx_bytes_per_sec),
+                    byte_rate(network.tx_bytes_per_sec)
+                )
+            },
+        );
+
+    SystemSummary {
+        cpu: cpu_text,
+        memory: memory_text,
+        temperature,
+        disk,
+        network,
+    }
+}
+
+fn calendar_cache_path() -> PathBuf {
+    if let Some(path) = std::env::var_os("WAYLE_CALENDAR_CACHE").filter(|value| !value.is_empty()) {
+        return PathBuf::from(path);
+    }
+
+    std::env::var_os("HOME")
+        .map_or_else(PathBuf::new, PathBuf::from)
+        .join(".cache/waybar-ycal/events.json")
+}
+
+fn calendar_entries(days: &Map<String, Value>, date: &str) -> Vec<CalendarEntry> {
+    let Some(Value::Array(items)) = days.get(date) else {
+        return Vec::new();
+    };
+
+    let mut entries = items
+        .iter()
+        .filter_map(|item| match item {
+            Value::String(title) => Some(CalendarEntry {
+                order: 1,
+                icon: "󰃭",
+                title: title.clone(),
+            }),
+            Value::Object(task) => {
+                let done = task.get("done").and_then(Value::as_bool).unwrap_or(false);
+                Some(CalendarEntry {
+                    order: if done { 2 } else { 0 },
+                    icon: if done { "󰄲" } else { "󰄱" },
+                    title: task.get("title").and_then(Value::as_str)?.to_owned(),
+                })
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    entries.sort_by_key(|entry| entry.order);
+    entries
+}
+
+fn gibibytes(bytes: u64) -> String {
+    format!("{:.1} GiB", bytes as f64 / BYTES_PER_GIBIBYTE)
+}
+
+fn byte_rate(bytes: u64) -> String {
+    let mut value = bytes as f64;
+    let mut unit = "B/s";
+    for candidate in ["KiB/s", "MiB/s", "GiB/s"] {
+        if value < BYTES_PER_KIBIBYTE {
+            break;
+        }
+        value /= BYTES_PER_KIBIBYTE;
+        unit = candidate;
+    }
+
+    if value >= 100.0 || unit == "B/s" {
+        format!("{value:.0} {unit}")
+    } else {
+        format!("{value:.1} {unit}")
+    }
+}
