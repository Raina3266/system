+//! External dropdown requests delivered by the shell IPC service.
+
+use futures::StreamExt;
+use relm4::ComponentSender;
+
+use crate::{
+    services::shell_ipc::ShellIpcState,
+    shell::bar::{Bar, BarCmd},
+};
+
+pub(crate) fn spawn(sender: &ComponentSender<Bar>, ipc: &ShellIpcState, connector: String) {
+    let request = ipc.dropdown_request.clone();
+    let mut requests = request.watch();
+
+    sender.command(move |out, shutdown| async move {
+        let shutdown_fut = shutdown.wait();
+        tokio::pin!(shutdown_fut);
+
+        loop {
+            tokio::select! {
+                () = &mut shutdown_fut => break,
+                Some(current) = requests.next() => {
+                    if current.serial != 0 && current.monitor == connector {
+                        let _ = out.send(BarCmd::ToggleDropdown {
+                            name: current.name,
+                            offset: current.offset,
+                        });
+                    }
+                }
+            }
+        }
+    });
+}
