+        // the surface to resize. Keeping this false leaves the transparent
+        // host at its tiny natural size and clips most of the dropdown off the
+        // left edge of the monitor.
+        window.set_resizable(true);
         window.add_css_class(&format!("{name}-dropdown"));
         window.add_css_class(&format!("{name}-layer-window"));
