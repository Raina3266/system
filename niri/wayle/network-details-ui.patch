@@ -2,10 +2,85 @@ use relm4::ComponentSender;
 use tracing::warn;
 use wayle_network::core::access_point::Ssid;
 
-use super::ActiveConnections;
+use super::{
+    ActiveConnections,
+    messages::{ActiveConnectionsCmd, DetailPage},
+};
 use crate::{i18n::t, shell::bar::dropdowns::network::helpers};
 
 impl ActiveConnections {
+    pub(super) fn show_wifi_info(&mut self, sender: &ComponentSender<Self>) {
+        let Some(ssid) = self.wifi.ssid.clone().filter(|_| self.wifi.connected) else {
+            return;
+        };
+
+        self.begin_details(DetailPage::Info, &ssid);
+
+        let network = self.network.clone();
+        sender.oneshot_command(async move {
+            let result = super::info::load(network, ssid.clone()).await;
+            ActiveConnectionsCmd::InfoLoaded { ssid, result }
+        });
+    }
+
+    pub(super) fn show_wifi_qr(&mut self, sender: &ComponentSender<Self>) {
+        let Some(ssid) = self.wifi.ssid.clone().filter(|_| self.wifi.connected) else {
+            return;
+        };
+
+        self.begin_details(DetailPage::Qr, &ssid);
+
+        let network = self.network.clone();
+        sender.oneshot_command(async move {
+            let result = super::qr::render(network, ssid.clone()).await;
+            ActiveConnectionsCmd::QrRendered { ssid, result }
+        });
+    }
+
+    fn begin_details(&mut self, page: DetailPage, ssid: &str) {
+        self.detail_page = page;
+        self.detail_loading = true;
+        self.detail_ssid = ssid.to_owned();
+        self.detail_error = None;
+        self.info_text.clear();
+        self.qr_paintable = None;
+    }
+
+    pub(super) fn hide_details(&mut self) {
+        self.detail_page = DetailPage::Hidden;
+        self.detail_loading = false;
+        self.detail_ssid.clear();
+        self.detail_error = None;
+        self.info_text.clear();
+        self.qr_paintable = None;
+    }
+
+    pub(super) const fn details_visible(&self) -> bool {
+        !matches!(self.detail_page, DetailPage::Hidden)
+    }
+
+    pub(super) const fn details_page_name(&self) -> &'static str {
+        match self.detail_page {
+            DetailPage::Hidden => "loading",
+            DetailPage::Info => "info",
+            DetailPage::Qr => "qr",
+        }
+    }
+
+    pub(super) fn details_title(&self) -> String {
+        match self.detail_page {
+            DetailPage::Qr => t!("dropdown-network-qr-title", ssid = self.detail_ssid.clone()),
+            DetailPage::Info | DetailPage::Hidden => t!("dropdown-network-info-title"),
+        }
+    }
+
+    pub(super) fn details_loading_label(&self) -> String {
+        match self.detail_page {
+            DetailPage::Qr => t!("dropdown-network-qr-loading"),
+            DetailPage::Info | DetailPage::Hidden => t!("dropdown-network-info-loading"),
+        }
+    }
+
     pub(super) fn has_wifi_error(&self) -> bool {
         self.connection.error.is_some() && !self.wifi.connected
     }
