+    format!("{usage:.0}%")
+}
+
+pub(super) fn temp_text(celsius: f32) -> String {
+    format!("{celsius:.0}\u{00b0}")
+}
+
 pub(super) fn update_usage_ring(ring: &Controller<ProgressRing>, usage: f32) {
