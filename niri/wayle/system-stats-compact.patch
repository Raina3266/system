     ring.emit(ProgressRingMsg::SetFraction(fraction));
-    ring.emit(ProgressRingMsg::SetLabel(format!("{celsius:.0}\u{00b0}")));
+    ring.emit(ProgressRingMsg::SetLabel(temp_text(celsius)));
