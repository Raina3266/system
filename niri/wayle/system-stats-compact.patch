 use std::sync::Arc;
 
 use wayle_sysinfo::SysinfoService;
+use wayle_widgets::primitives::progress_ring::Size;
 
 pub(crate) struct SystemStatsInit {
     pub sysinfo: Arc<SysinfoService>,
+
+    /// Diameter of the four rings. The dashboard has a card to itself and uses
+    /// `Lg`; the control centre shares a column and asks for something smaller.
+    pub ring_size: Size,
+
+    /// Whether to draw the card's own title row. The control centre packs
+    /// several cards into one column and does without it.
+    pub show_header: bool,
+
+    /// Render the four readings as one line of text rather than ring dials.
+    /// A dial stacks a 2rem circle over its caption, which is nearly all of
+    /// the card's height; the control centre only has room for the numbers.
+    pub compact: bool,
 }
 
