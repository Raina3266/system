+//! Cover art carried inside the track file.
+//!
+//! Three container formats cover a local library: FLAC's PICTURE block, an
+//! ID3v2 APIC frame in an MP3, and MP4's `covr` atom. Each keeps the picture
+//! whole and says how long it is, so pulling one out is a walk over lengths
+//! rather than a decode; that is why this does not pull in a tag-reading
+//! crate, which the pinned Cargo.lock could not take anyway.
+
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom},
+    path::Path,
+};
+
+/// A picture, and enough of its type to name the file it is written to.
+pub(in crate::shell::bar::dropdowns::media) struct Picture {
+    pub bytes: Vec<u8>,
+}
+
+impl Picture {
+    /// Read from the picture itself rather than from the MIME type beside it,
+    /// which taggers get wrong often enough to matter.
+    pub fn extension(&self) -> &'static str {
+        match self.bytes.as_slice() {
+            [0x89, b'P', b'N', b'G', ..] => "png",
+            [b'G', b'I', b'F', ..] => "gif",
+            [b'R', b'I', b'F', b'F', _, _, _, _, b'W', b'E', b'B', b'P', ..] => "webp",
+            [b'B', b'M', ..] => "bmp",
+            _ => "jpg",
+        }
+    }
+}
+
+/// Pulls the cover out of a track, if the format is one of the three that
+/// carry one and the file actually has one.
+pub(super) fn extract(path: &Path, max_bytes: usize) -> Option<Picture> {
+    let mut file = File::open(path).ok()?;
+    let mut magic = [0u8; 12];
+    let read = read_upto(&mut file, &mut magic)?;
+    let magic = &magic[..read];
+
+    let bytes = if magic.starts_with(b"fLaC") {
+        flac(&mut file, max_bytes)
+    } else if magic.starts_with(b"ID3") {
+        id3(&mut file, max_bytes)
+    } else if magic.len() >= 8 && &magic[4..8] == b"ftyp" {
+        mp4(&mut file, max_bytes)
+    } else {
+        None
+    }?;
+
+    (!bytes.is_empty()).then_some(Picture { bytes })
+}
+
+// --- FLAC -------------------------------------------------------------------
+
+const FLAC_PICTURE_BLOCK: u8 = 6;
+/// Room for the MIME type and description that sit in front of a picture, so
+/// a block is not read short of the picture the cap would allow.
+const HEADROOM: usize = 8 * 1024;
+
+/// Walks the metadata blocks that follow `fLaC` looking for a PICTURE.
+fn flac(file: &mut File, max_bytes: usize) -> Option<Vec<u8>> {
+    file.seek(SeekFrom::Start(4)).ok()?;
+
+    loop {
+        let mut header = [0u8; 4];
+        file.read_exact(&mut header).ok()?;
+        let last = header[0] & 0x80 != 0;
+        let kind = header[0] & 0x7F;
+        let length = u32::from_be_bytes([0, header[1], header[2], header[3]]) as usize;
+
+        if kind == FLAC_PICTURE_BLOCK {
+            let block = read_exact_vec(file, length.min(max_bytes.saturating_add(HEADROOM)))?;
+            return flac_picture(&block, max_bytes);
+        }
+        if last {
+            return None;
+        }
+        file.seek(SeekFrom::Current(length as i64)).ok()?;
+    }
+}
+
+/// A PICTURE block is a run of big-endian lengths: type, MIME, description,
+/// four image dimensions, then the picture.
+fn flac_picture(block: &[u8], max_bytes: usize) -> Option<Vec<u8>> {
+    let mut cursor = 4usize; // picture type
+    cursor += 4 + be_u32(block, cursor)? as usize; // MIME
+    cursor += 4 + be_u32(block, cursor)? as usize; // description
+    cursor += 16; // width, height, colour depth, indexed colours
+    let length = be_u32(block, cursor)? as usize;
+    cursor += 4;
+    slice(block, cursor, length, max_bytes)
+}
+
+// --- ID3v2 (MP3) ------------------------------------------------------------
+
+/// Walks the frames of an ID3v2 tag looking for an APIC.
+fn id3(file: &mut File, max_bytes: usize) -> Option<Vec<u8>> {
+    file.seek(SeekFrom::Start(0)).ok()?;
+    let mut header = [0u8; 10];
+    file.read_exact(&mut header).ok()?;
+    let major = header[3];
+    let tag_length = syncsafe(&header[6..10])?;
+
+    let tag = read_exact_vec(file, tag_length.min(max_bytes.saturating_add(HEADROOM)))?;
+    let mut cursor = 0usize;
+
+    while cursor + 10 <= tag.len() {
+        let id = tag.get(cursor..cursor + 4)?;
+        if id == [0, 0, 0, 0] {
+            return None; // padding
+        }
+        // Only 2.4 stores frame lengths syncsafe; 2.3 writes them plainly, and
+        // reading a 2.3 length the 2.4 way walks off into the audio.
+        let length = if major >= 4 {
+            syncsafe(tag.get(cursor + 4..cursor + 8)?)?
+        } else {
+            be_u32(&tag, cursor + 4)? as usize
+        };
+        let body = cursor + 10;
+        if id == b"APIC" {
+            let frame = tag.get(body..body.checked_add(length)?)?;
+            return apic(frame, max_bytes);
+        }
+        cursor = body.checked_add(length)?;
+    }
+    None
+}
+
+/// APIC is: encoding, a null-terminated MIME string, a picture type, a
+/// description in that encoding, then the picture.
+fn apic(frame: &[u8], max_bytes: usize) -> Option<Vec<u8>> {
+    let encoding = *frame.first()?;
+    let mime_end = frame.iter().skip(1).position(|byte| *byte == 0)? + 1;
+    let mut cursor = mime_end + 1 + 1; // MIME terminator, picture type
+
+    // UTF-16 descriptions terminate with two zero bytes on an even boundary.
+    cursor += if encoding == 1 || encoding == 2 {
+        let start = cursor;
+        let mut index = start;
+        loop {
+            let pair = frame.get(index..index + 2)?;
+            index += 2;
+            if pair == [0, 0] {
+                break index - start;
+            }
+        }
+    } else {
+        frame.get(cursor..)?.iter().position(|byte| *byte == 0)? + 1
+    };
+
+    slice(frame, cursor, frame.len().checked_sub(cursor)?, max_bytes)
+}
+
+// --- MP4 / M4A --------------------------------------------------------------
+
+/// Descends `moov > udta > meta > ilst > covr > data` to the picture.
+fn mp4(file: &mut File, max_bytes: usize) -> Option<Vec<u8>> {
+    let end = file.seek(SeekFrom::End(0)).ok()?;
+    let ilst = descend(file, 0, end, &[b"moov", b"udta", b"meta", b"ilst"])?;
+    let (covr_start, covr_end) = boxes(file, ilst.0, ilst.1, b"covr")?;
+    let (data_start, data_end) = boxes(file, covr_start, covr_end, b"data")?;
+
+    // A `data` payload opens with a version/flags word and a reserved word.
+    let start = data_start.checked_add(8)?;
+    let length = data_end.checked_sub(start)? as usize;
+    if length > max_bytes {
+        return None;
+    }
+    file.seek(SeekFrom::Start(start)).ok()?;
+    read_exact_vec(file, length)
+}
+
+fn descend(file: &mut File, mut start: u64, mut end: u64, path: &[&[u8; 4]]) -> Option<(u64, u64)> {
+    for (depth, name) in path.iter().enumerate() {
+        let (child_start, child_end) = boxes(file, start, end, name)?;
+        // `meta` is a full box: four bytes of version and flags sit in front
+        // of its children, unlike every other container on this path.
+        start = if *name == b"meta" {
+            child_start.checked_add(4)?
+        } else {
+            child_start
+        };
+        end = child_end;
+        let _ = depth;
+    }
+    Some((start, end))
+}
+
+/// Finds one child box by name, returning where its payload starts and ends.
+fn boxes(file: &mut File, start: u64, end: u64, name: &[u8; 4]) -> Option<(u64, u64)> {
+    let mut cursor = start;
+    while cursor + 8 <= end {
+        file.seek(SeekFrom::Start(cursor)).ok()?;
+        let mut header = [0u8; 8];
+        file.read_exact(&mut header).ok()?;
+        let mut size = u32::from_be_bytes([header[0], header[1], header[2], header[3]]) as u64;
+        let mut payload = cursor + 8;
+
+        if size == 1 {
+            // A 64-bit size follows the header instead.
+            let mut large = [0u8; 8];
+            file.read_exact(&mut large).ok()?;
+            size = u64::from_be_bytes(large);
+            payload += 8;
+        } else if size == 0 {
+            size = end - cursor; // runs to the end of its parent
+        }
+        if size < 8 {
+            return None;
+        }
+
+        let box_end = cursor.checked_add(size)?.min(end);
+        if &header[4..8] == name {
+            return Some((payload, box_end));
+        }
+        cursor = box_end.max(cursor + 8);
+    }
+    None
+}
+
+// --- shared -----------------------------------------------------------------
+
+fn be_u32(bytes: &[u8], at: usize) -> Option<u32> {
+    let word = bytes.get(at..at + 4)?;
+    Some(u32::from_be_bytes([word[0], word[1], word[2], word[3]]))
+}
+
+/// ID3 stores lengths seven bits to the byte, so a length can never contain a
+/// run of bits that looks like an MPEG frame sync.
+fn syncsafe(bytes: &[u8]) -> Option<usize> {
+    let word = bytes.get(0..4)?;
+    if word.iter().any(|byte| byte & 0x80 != 0) {
+        return None;
+    }
+    Some(word
+        .iter()
+        .fold(0usize, |total, byte| (total << 7) | *byte as usize))
+}
+
+/// A picture larger than the cap is refused rather than cut short: half a
+/// JPEG draws as nothing, so a truncated one is worse than none.
+fn slice(bytes: &[u8], at: usize, length: usize, max_bytes: usize) -> Option<Vec<u8>> {
+    if length > max_bytes {
+        return None;
+    }
+    Some(bytes.get(at..at.checked_add(length)?)?.to_vec())
+}
+
+fn read_upto(file: &mut File, buffer: &mut [u8]) -> Option<usize> {
+    let mut filled = 0;
+    while filled < buffer.len() {
+        match file.read(&mut buffer[filled..]) {
+            Ok(0) => break,
+            Ok(read) => filled += read,
+            Err(_) => return None,
+        }
+    }
+    Some(filled)
+}
+
+fn read_exact_vec(file: &mut File, length: usize) -> Option<Vec<u8>> {
+    let mut buffer = vec![0u8; length];
+    file.read_exact(&mut buffer).ok()?;
+    Some(buffer)
+}
+
+#[cfg(test)]
+mod tests {
+    use std::io::Write;
+
+    use super::*;
+
+    const PNG: &[u8] = &[0x89, b'P', b'N', b'G', 0x0D, 0x0A, 0x1A, 0x0A, 1, 2, 3, 4];
+    const JPEG: &[u8] = &[0xFF, 0xD8, 0xFF, 0xE0, 9, 9, 9, 9];
+
+    fn write(name: &str, bytes: &[u8]) -> std::path::PathBuf {
+        let path = std::env::temp_dir().join(format!(
+            "wayle-embedded-{}-{:?}-{name}",
+            std::process::id(),
+            std::thread::current().id()
+        ));
+        let mut file = std::fs::File::create(&path).expect("temp file");
+        file.write_all(bytes).expect("write");
+        path
+    }
+
+    fn flac_file(picture: &[u8], mime: &[u8]) -> Vec<u8> {
+        let mut block = Vec::new();
+        block.extend_from_slice(&3u32.to_be_bytes()); // front cover
+        block.extend_from_slice(&(mime.len() as u32).to_be_bytes());
+        block.extend_from_slice(mime);
+        block.extend_from_slice(&4u32.to_be_bytes());
+        block.extend_from_slice(b"desc");
+        block.extend_from_slice(&[0u8; 16]); // dimensions
+        block.extend_from_slice(&(picture.len() as u32).to_be_bytes());
+        block.extend_from_slice(picture);
+
+        let mut out = Vec::from(*b"fLaC");
+        // A STREAMINFO block first, so the walk has to skip one to get there.
+        out.push(0);
+        out.extend_from_slice(&[0, 0, 34]);
+        out.extend_from_slice(&[0u8; 34]);
+        out.push(0x80 | FLAC_PICTURE_BLOCK);
+        let length = block.len() as u32;
+        out.extend_from_slice(&length.to_be_bytes()[1..]);
+        out.extend_from_slice(&block);
+        out
+    }
+
+    fn id3_file(picture: &[u8], major: u8) -> Vec<u8> {
+        let mut frame = vec![0u8]; // latin-1 description
+        frame.extend_from_slice(b"image/png\0");
+        frame.push(3); // front cover
+        frame.extend_from_slice(b"cover\0");
+        frame.extend_from_slice(picture);
+
+        let mut tag = Vec::from(*b"APIC");
+        let length = frame.len() as u32;
+        if major >= 4 {
+            tag.extend_from_slice(&[
+                ((length >> 21) & 0x7F) as u8,
+                ((length >> 14) & 0x7F) as u8,
+                ((length >> 7) & 0x7F) as u8,
+                (length & 0x7F) as u8,
+            ]);
+        } else {
+            tag.extend_from_slice(&length.to_be_bytes());
+        }
+        tag.extend_from_slice(&[0, 0]); // frame flags
+        tag.extend_from_slice(&frame);
+
+        let mut out = Vec::from(*b"ID3");
+        out.extend_from_slice(&[major, 0, 0]);
+        let size = tag.len() as u32;
+        out.extend_from_slice(&[
+            ((size >> 21) & 0x7F) as u8,
+            ((size >> 14) & 0x7F) as u8,
+            ((size >> 7) & 0x7F) as u8,
+            (size & 0x7F) as u8,
+        ]);
+        out.extend_from_slice(&tag);
+        out.extend_from_slice(&[0xFF, 0xFB, 0x90, 0x00]); // an audio frame
+        out
+    }
+
+    fn mp4_box(name: &[u8; 4], payload: &[u8]) -> Vec<u8> {
+        let mut out = ((payload.len() + 8) as u32).to_be_bytes().to_vec();
+        out.extend_from_slice(name);
+        out.extend_from_slice(payload);
+        out
+    }
+
+    fn mp4_file(picture: &[u8]) -> Vec<u8> {
+        let mut data = vec![0, 0, 0, 13, 0, 0, 0, 0]; // version/flags, reserved
+        data.extend_from_slice(picture);
+        let covr = mp4_box(b"covr", &mp4_box(b"data", &data));
+        let ilst = mp4_box(b"ilst", &covr);
+        let mut meta_payload = vec![0u8; 4]; // meta's version and flags
+        meta_payload.extend_from_slice(&ilst);
+        let meta = mp4_box(b"meta", &meta_payload);
+        let udta = mp4_box(b"udta", &meta);
+        let moov = mp4_box(b"moov", &udta);
+
+        let mut out = mp4_box(b"ftyp", b"M4A \0\0\0\0");
+        out.extend_from_slice(&mp4_box(b"free", &[0u8; 8]));
+        out.extend_from_slice(&moov);
+        out
+    }
+
+    #[test]
+    fn a_flac_picture_block_is_found_past_streaminfo() {
+        let path = write("a.flac", &flac_file(PNG, b"image/png"));
+        let picture = extract(&path, 1 << 20).expect("picture");
+
+        assert_eq!(picture.bytes, PNG);
+        assert_eq!(picture.extension(), "png");
+        let _ = std::fs::remove_file(path);
+    }
+
+    #[test]
+    fn an_id3v23_apic_frame_is_found() {
+        let path = write("b.mp3", &id3_file(JPEG, 3));
+        let picture = extract(&path, 1 << 20).expect("picture");
+
+        assert_eq!(picture.bytes, JPEG);
+        assert_eq!(picture.extension(), "jpg");
+        let _ = std::fs::remove_file(path);
+    }
+
+    #[test]
+    fn an_id3v24_apic_frame_is_found() {
+        let path = write("c.mp3", &id3_file(PNG, 4));
+        let picture = extract(&path, 1 << 20).expect("picture");
+
+        assert_eq!(picture.bytes, PNG);
+        let _ = std::fs::remove_file(path);
+    }
+
+    #[test]
+    fn an_mp4_covr_atom_is_found_past_a_sibling_box() {
+        let path = write("d.m4a", &mp4_file(JPEG));
+        let picture = extract(&path, 1 << 20).expect("picture");
