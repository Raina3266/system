diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/media/transport.rs b/crates/wayle-shell/src/shell/bar/dropdowns/media/transport.rs
new file mode 100644
index 0000000..9069b1d
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/media/transport.rs
@@ -0,0 +1,255 @@
+//! Play and pause commands that name what they want.
+//!
+//! `PlayPause` leaves the decision to the player. A bridge that republishes a
+//! browser tab decides from its own copy of the tab's state, and when the two
+//! disagree the toggle resolves to the state the tab is already in, so the
+//! press does nothing at all. Naming the command removes the disagreement, and
+//! it also makes the command idempotent, which is what lets a card send it to
+//! every player it stands for.
+
+use std::{collections::HashMap, sync::Arc, time::Duration};
+
+use tokio::{sync::OnceCell, time::sleep};
+use tracing::warn;
+use wayle_media::{core::player::Player, types::PlaybackState};
+use zbus::{
+    Connection,
+    zvariant::{ObjectPath, OwnedValue},
+};
+
+const MPRIS_PATH: &str = "/org/mpris/MediaPlayer2";
+const PLAYER_INTERFACE: &str = "org.mpris.MediaPlayer2.Player";
+
+/// How long a player is given to reach the state it was asked for. Long
+/// enough that a browser tab waking up is not mistaken for one that ignored
+/// the command.
+const SETTLE_TIMEOUT: Duration = Duration::from_millis(1200);
+const SETTLE_POLL: Duration = Duration::from_millis(50);
+
+/// How long a player is given to act on a seek before it is judged to have
+/// ignored it. Generous, because the cost of judging too early is seeking a
+/// second time, which is audible: a browser tab reached through a bridge and a
+/// native-messaging hop can take over a second to report where it landed.
+const SEEK_TIMEOUT: Duration = Duration::from_millis(2500);
+const SEEK_POLL: Duration = Duration::from_millis(120);
+/// A player that landed this close to where it was sent has obeyed.
+const SEEK_TOLERANCE: Duration = Duration::from_secs(2);
+
+static SESSION: OnceCell<Connection> = OnceCell::const_new();
+
+/// Plays or pauses every player the card stands for.
+///
+/// Pausing an already-paused player, or playing an already-playing one, is a
+/// no-op, so a card backed by a bridge and the player it mirrors can send to
+/// both and let whichever one is listening act.
+pub(super) async fn set_playing(players: Vec<Arc<Player>>, play: bool) {
+    let method = if play { "Play" } else { "Pause" };
+    let mut players = players.into_iter();
+    let Some(card_player) = players.next() else {
+        return;
+    };
+
+    for player in players {
+        request(&player, method).await;
+    }
+    request(&card_player, method).await;
+
+    // MPRIS asks a player that cannot honour a command to ignore it rather
+    // than report an error, and some publishers answer `Play` and `Pause`
+    // that way while still acting on `PlayPause`. Only the card's own player
+    // is toggled, and only once it has had time to settle, so a player that
+    // was merely slow is not sent back where it came from.
+    if settles(&card_player, play).await {
+        return;
+    }
+
+    warn!(
+        player = %card_player.id,
+        "{method} left the player where it was, toggling instead"
+    );
+    if let Err(error) = card_player.play_pause().await {
+        warn!(player = %card_player.id, %error, "play/pause failed");
+    }
+}
+
+async fn request(player: &Player, method: &str) {
+    let Err(error) = send(player, method).await else {
+        return;
+    };
+
+    warn!(
+        player = %player.id,
+        %error,
+        "{method} failed, asking the player to toggle instead"
+    );
+    if let Err(error) = player.play_pause().await {
+        warn!(player = %player.id, %error, "play/pause failed");
+    }
+}
+
+/// Waits for a player to reach the requested state, up to [`SETTLE_TIMEOUT`].
+///
+/// A player asked to pause has obeyed whether it reports itself paused or
+/// stopped; only playing means the press was ignored.
+async fn settles(player: &Player, play: bool) -> bool {
+    let mut waited = Duration::ZERO;
+    loop {
+        if (player.playback_state.get() == PlaybackState::Playing) == play {
+            return true;
+        }
+        if waited >= SETTLE_TIMEOUT {
+            return false;
+        }
+        sleep(SETTLE_POLL).await;
+        waited += SETTLE_POLL;
+    }
+}
+
+/// Moves a card's playback to an absolute position.
+///
+/// `SetPosition` carries the track it applies to, and MPRIS tells a player to
+/// ignore the call when that identifier is not the one it is playing.
+/// `wayle-media` reads `mpris:trackid` as a string, but the spec types it as
+/// an object path, so it parses none from a compliant player and sends `/`
+/// instead — which every such player is required to ignore. Reading the
+/// identifier off the bus fixes that, and a relative `Seek` covers a player
+/// that publishes no usable identifier at all.
+///
+/// Only one player is moved. A card can stand for several publishers of one
+/// playback, and seeking each of them in turn seeks the same audio repeatedly:
+/// the destination is the same but the stutter is real. The rest are tried
+/// only if the first did not move at all.
+pub(super) async fn seek_to(players: Vec<Arc<Player>>, target: Duration) {
+    for player in &players {
+        if seek_one(player, target).await {
+            return;
+        }
+    }
+}
+
+/// Seeks one player, and says whether it acted on it.
+async fn seek_one(player: &Player, target: Duration) -> bool {
+    let Ok(proxy) = proxy(player).await else {
+        return false;
+    };
+    let before = player.position().await.ok();
+
+    if let Some(track) = track_id(&proxy).await
+        && let Err(error) = proxy
+            .call_method("SetPosition", &(&track, micros(target)))
+            .await
+    {
+        warn!(player = %player.id, %error, "SetPosition failed");
+    } else if acted(player, target, before).await {
+        return true;
+    }
+
+    seek_by_offset(&proxy, player, target).await && acted(player, target, before).await
+}
+
+/// Relative seek names no track, so it is what is left for a player that
+/// publishes no identifier or ignored the absolute call. The offset is
+/// measured from this player's own position, which keeps the destination
+/// absolute however far along it happens to be.
+async fn seek_by_offset(proxy: &zbus::Proxy<'static>, player: &Player, target: Duration) -> bool {
+    let Ok(current) = player.position().await else {
+        return false;
+    };
+    match proxy
+        .call_method("Seek", &(micros(target) - micros(current),))
+        .await
+    {
+        Ok(_) => true,
+        Err(error) => {
+            warn!(player = %player.id, %error, "seek failed");
+            false
+        }
+    }
+}
+
+/// Whether the player did something with the seek.
+///
+/// Not yet at the target is not the same as having ignored it. A player that
+/// streams buffers first and reports the old position for a moment, and
+/// seeking it again in that moment is what makes it stutter. Only a player
+/// still sitting exactly where it started has done nothing.
+async fn acted(player: &Player, target: Duration, before: Option<Duration>) -> bool {
+    let mut waited = Duration::ZERO;
+    loop {
+        let Ok(now) = player.position().await else {
+            // Nothing to judge it by, so do not seek it a second time.
+            return true;
+        };
+        if now.abs_diff(target) <= SEEK_TOLERANCE {
+            return true;
+        }
+        if waited >= SEEK_TIMEOUT {
+            return before.is_none_or(|before| now.abs_diff(before) > SEEK_TOLERANCE);
+        }
+        sleep(SEEK_POLL).await;
+        waited += SEEK_POLL;
+    }
+}
+
+/// The current track's identifier, as the object path MPRIS says it is.
+///
+/// A few players publish it as a plain string instead; both are accepted,
+/// because either one still names the track the player is on.
+async fn track_id(proxy: &zbus::Proxy<'static>) -> Option<ObjectPath<'static>> {
+    let metadata: HashMap<String, OwnedValue> = proxy.get_property("Metadata").await.ok()?;
+    let value = metadata.get("mpris:trackid")?.try_clone().ok()?;
+
+    let path = ObjectPath::try_from(value.clone())
+        .map(ObjectPath::into_owned)
+        .ok()
+        .or_else(|| {
+            String::try_from(value)
+                .ok()
+                .and_then(|text| ObjectPath::try_from(text).ok())
+        })?;
+
+    // The spec's "no track" sentinel, and the bare root wayle-media falls back
+    // to, both name no track and are ignored by every player that follows it.
+    let text = path.as_str();
+    (text != "/" && !text.ends_with("/NoTrack")).then_some(path)
+}
+
+fn micros(value: Duration) -> i64 {
+    i64::try_from(value.as_micros()).unwrap_or(i64::MAX)
+}
+
+/// The file or address a player says it is playing.
+///
+/// `wayle-media` does not carry `xesam:url`, and it is the only thing that
+/// says where a local track lives, which is where its cover art is when the
+/// player publishes none.
+pub(super) async fn track_url(player: &Player) -> Option<String> {
+    let proxy = proxy(player).await.ok()?;
+    let metadata: HashMap<String, OwnedValue> = proxy.get_property("Metadata").await.ok()?;
+    String::try_from(metadata.get("xesam:url")?.try_clone().ok()?).ok()
+}
+
+async fn send(player: &Player, method: &str) -> Result<(), String> {
+    proxy(player)
+        .await?
+        .call_method(method, &())
+        .await
+        .map(|_| ())
+        .map_err(|error| error.to_string())
+}
+
+async fn proxy(player: &Player) -> Result<zbus::Proxy<'static>, String> {
+    let connection = SESSION
+        .get_or_try_init(Connection::session)
+        .await
+        .map_err(|error| format!("session bus unavailable: {error}"))?;
+
+    zbus::Proxy::new(
+        connection,
+        player.id.bus_name().to_owned(),
+        MPRIS_PATH,
+        PLAYER_INTERFACE,
+    )
+    .await
+    .map_err(|error| error.to_string())
+}
