+impl MediaDropdown {
+    fn update_player_list(&mut self, players: Vec<Arc<Player>>, sender: &ComponentSender<Self>) {
+        let token = self.player_state_watcher.reset();
+        watchers::spawn_playback_state(sender, &players, token);
+        self.sync_player_views(players);
+    }
+
+    fn sync_player_views(&mut self, players: Vec<Arc<Player>>) {
+        let mut groups = deduplicate_players(
+            players
+                .into_iter()
+                .filter(|player| player.playback_state.get() != PlaybackState::Stopped)
+                .collect(),
+        );
+        groups.sort_by_key(|group| playback_rank(group.player.playback_state.get()));
+
+        if same_groups(&self.groups, &groups) {
+            return;
+        }
+
+        while let Some(child) = self.player_list.first_child() {
+            self.player_list.remove(&child);
+        }
+        self.player_views.clear();
+
+        for group in &groups {
+            let player_view = PlayerView::builder()
+                .launch(PlayerViewInit {
+                    player: Arc::clone(&group.player),
+                    duplicates: group.duplicates.clone(),
+                })
+                .detach();
+            player_view.emit(PlayerViewInput::SetActive(self.is_active));
+            self.player_list.append(player_view.widget());
+            self.player_views.push(player_view);
+        }
+
+        self.groups = groups;
+        self.list_height = self.measure_list_height();
+    }
+
+    /// The height of a full list: `VISIBLE_CARDS` cards and the gaps between
+    /// them. Every card is the same size, so one of them gives the height of
+    /// all of them. Before the list is in a window GTK has no styling to
+    /// measure against and reports a card as far shorter than it will be
+    /// drawn, so an unrooted list keeps the fallback until it is shown.
+    fn measure_list_height(&self) -> i32 {
+        let card_height = self
+            .player_list
+            .first_child()
+            .filter(|_| self.player_list.root().is_some())
+            .map(|card| card.measure(gtk::Orientation::Vertical, -1).1)
+            .filter(|height| *height > 0)
+            .unwrap_or(self.fallback_card_height);
+
+        card_height * VISIBLE_CARDS + self.card_gap * (VISIBLE_CARDS - 1)
+    }
+}
+
+/// Whether the cards already on screen stand for exactly the same players.
+///
+/// The players themselves are compared, not their bus names: a bridge that
+/// republishes a browser tab claims the same name each time it recreates a
+/// player, and a card holding the replaced one is frozen — its state never
+/// changes again, so its play/pause button keeps sending the command the
+/// player is already in and the press does nothing.
+fn same_groups(current: &[PlayerGroup], next: &[PlayerGroup]) -> bool {
+    current.len() == next.len()
+        && current.iter().zip(next).all(|(current, next)| {
+            Arc::ptr_eq(&current.player, &next.player)
+                && current.duplicates.len() == next.duplicates.len()
+                && current
+                    .duplicates
+                    .iter()
+                    .zip(&next.duplicates)
+                    .all(|(current, next)| Arc::ptr_eq(current, next))
+        })
+}
+
+fn playback_rank(state: PlaybackState) -> u8 {
+    match state {
+        PlaybackState::Playing => 0,
+        PlaybackState::Paused => 1,
+        PlaybackState::Stopped => 2,
+    }
+}
+
+/// One card's players: the one it shows, and the duplicates it stands in for.
+pub(crate) struct PlayerGroup {
+    pub player: Arc<Player>,
+    pub duplicates: Vec<Arc<Player>>,
+}
+
+fn deduplicate_players(players: Vec<Arc<Player>>) -> Vec<PlayerGroup> {
+    let mut seen_ids = HashSet::new();
+    let players: Vec<_> = players
+        .into_iter()
+        .filter(|player| seen_ids.insert(player.id.clone()))
+        .collect();
+
+    // Which card each dropped player was folded into, recorded as it is
+    // dropped. Re-deriving it afterwards from a resemblance test loses the
+    // pairs the bridge rule matched, which are exactly the ones that disagree
+    // about their own state and so most need both ends to hear a command.
+    let mut merged_into: Vec<Option<usize>> = vec![None; players.len()];
+    let mut keep = vec![true; players.len()];
+    for left_index in 0..players.len() {
+        if !keep[left_index] {
+            continue;
+        }
+        for right_index in (left_index + 1)..players.len() {
+            if !keep[right_index]
+                || !same_player_snapshot(&players[left_index], &players[right_index])
+            {
+                continue;
+            }
+            let left_playing = players[left_index].playback_state.get() == PlaybackState::Playing;
+            let right_playing = players[right_index].playback_state.get() == PlaybackState::Playing;
+            if left_playing && !right_playing {
+                keep[right_index] = false;
+                merged_into[right_index] = Some(left_index);
+            } else {
+                keep[left_index] = false;
+                merged_into[left_index] = Some(right_index);
+                break;
             }
         }
     }
+
+    for bridge_index in 0..players.len() {
+        if !keep[bridge_index] || !is_mprisence(&players[bridge_index]) {
+            continue;
+        }
+        let Some(proxy_index) = (0..players.len()).find(|&index| {
+            keep[index]
+                && index != bridge_index
+                && is_browser_or_proxy(&players[index])
+                && matching_metadata(&players[bridge_index], &players[index])
+        }) else {
+            continue;
+        };
+        let bridge = &players[bridge_index];
+        let proxy = &players[proxy_index];
+        let bridge_playing = bridge.playback_state.get() == PlaybackState::Playing;
+        let proxy_playing = proxy.playback_state.get() == PlaybackState::Playing;
+        let (dropped, kept) = if proxy_playing && !bridge_playing {
+            (bridge_index, proxy_index)
+        } else if (bridge_playing && !proxy_playing)
+            || metadata_richness(bridge) >= metadata_richness(proxy)
+        {
+            (proxy_index, bridge_index)
+        } else {
+            (bridge_index, proxy_index)
+        };
+        keep[dropped] = false;
+        merged_into[dropped] = Some(kept);
+    }
+
+    // Everything a card replaced is still a way to reach the same playback,
+    // including a player folded into one that was itself folded into a third.
+    let mut duplicates: Vec<Vec<Arc<Player>>> = vec![Vec::new(); players.len()];
+    for index in 0..players.len() {
+        if keep[index] {
+            continue;
+        }
+        if let Some(card) = surviving_card(index, &merged_into, &keep) {
+            duplicates[card].push(Arc::clone(&players[index]));
+        }
+    }
+
+    players
+        .into_iter()
+        .zip(keep)
+        .zip(duplicates)
+        .filter_map(|((player, keep), duplicates)| {
+            keep.then_some(PlayerGroup {
+                player,
+                duplicates,
+            })
+        })
+        .collect()
+}
+
+/// Follows the chain of merges from a dropped player to the card that ended up
+/// standing for it, stopping if the records ever form a loop.
+fn surviving_card(start: usize, merged_into: &[Option<usize>], keep: &[bool]) -> Option<usize> {
+    let mut index = merged_into[start]?;
+    for _ in 0..merged_into.len() {
+        if keep[index] {
+            return Some(index);
+        }
+        index = merged_into[index]?;
+    }
+    None
+}
+
+fn same_player_snapshot(left: &Player, right: &Player) -> bool {
+    same_non_empty(&left.identity.get(), &right.identity.get())
+        && matching_metadata(left, right)
+}
+
+fn is_mprisence(player: &Player) -> bool {
+    player.id.bus_name().to_ascii_lowercase().contains("mprisence")
+}
+
+fn is_browser_or_proxy(player: &Player) -> bool {
+    let id = player.id.bus_name().to_ascii_lowercase();
+    [
+        "playerctld", "plasma-browser-integration", "chromium", "chrome",
+        "firefox", "brave", "vivaldi", "microsoft-edge", "opera", "zen",
+    ]
+    .iter()
+    .any(|candidate| id.contains(candidate))
+}
+
+fn matching_metadata(left: &Player, right: &Player) -> bool {
+    let left_title = normalized(&left.metadata.title.get());
+    if left_title.is_empty() || left_title != normalized(&right.metadata.title.get()) {
+        return false;
+    }
+    same_non_empty(&left.metadata.artist.get(), &right.metadata.artist.get())
+        || same_non_empty(&left.metadata.album.get(), &right.metadata.album.get())
+        || same_optional(&left.metadata.art_url.get(), &right.metadata.art_url.get())
+        || near_duration(left.metadata.length.get(), right.metadata.length.get())
+}
+
+fn normalized(value: &str) -> String {
+    value.split_whitespace().collect::<Vec<_>>().join(" ").to_lowercase()
+}
+
+fn same_non_empty(left: &str, right: &str) -> bool {
+    let left = normalized(left);
+    !left.is_empty() && left == normalized(right)
+}
+
+fn same_optional(left: &Option<String>, right: &Option<String>) -> bool {
+    left.as_deref()
+        .zip(right.as_deref())
+        .is_some_and(|(left, right)| same_non_empty(left, right))
+}
+
+fn near_duration(
+    left: Option<std::time::Duration>,
+    right: Option<std::time::Duration>,
+) -> bool {
+    left.zip(right)
+        .is_some_and(|(left, right)| left.abs_diff(right) <= std::time::Duration::from_secs(2))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::surviving_card;
+
+    #[test]
+    fn surviving_card_follows_a_chain_of_merges() {
+        // 0 was folded into 1, which was itself folded into 2.
+        let merged_into = [Some(1), Some(2), None];
+        let keep = [false, false, true];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), Some(2));
+    }
+
+    #[test]
+    fn surviving_card_stops_at_the_first_survivor() {
+        let merged_into = [Some(1), None, None];
+        let keep = [false, true, true];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), Some(1));
+    }
+
+    #[test]
+    fn surviving_card_gives_up_on_a_loop() {
+        let merged_into = [Some(1), Some(0)];
+        let keep = [false, false];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), None);
+    }
+
+    #[test]
+    fn surviving_card_gives_up_when_the_chain_ends_nowhere() {
+        let merged_into = [Some(1), None];
+        let keep = [false, false];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), None);
+    }
+}
+
+fn metadata_richness(player: &Player) -> usize {
+    [
+        !player.metadata.title.get().trim().is_empty(),
+        !player.metadata.artist.get().trim().is_empty(),
+        !player.metadata.album.get().trim().is_empty(),
+        player.metadata.art_url.get().is_some(),
+        player.metadata.length.get().is_some(),
+    ]
+    .into_iter()
+    .filter(|present| *present)
+    .count()
 }
