+    #[test]
+    fn a_flac_without_a_picture_yields_nothing() {
+        let mut bare = Vec::from(*b"fLaC");
+        bare.push(0x80); // a last STREAMINFO block and nothing else
+        bare.extend_from_slice(&[0, 0, 34]);
+        bare.extend_from_slice(&[0u8; 34]);
