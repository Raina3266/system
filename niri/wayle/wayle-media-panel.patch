diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/mod.rs b/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/mod.rs
new file mode 100644
index 0000000..e61a161
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/mod.rs
@@ -0,0 +1,139 @@
+//! Cover art for players that publish a local file but no picture.
+//!
+//! `wayle-media` resolves `mpris:artUrl`, downloading and caching an HTTP one,
+//! and gives up when a player publishes none. Local players often do: a track
+//! carries its cover inside the file, or beside it in the folder, and a player
+//! that never extracts one has nothing to put in `mpris:artUrl`. The panel can
+//! look in both places itself, because `xesam:url` says where the file is.
+
+mod embedded;
+mod sidecar;
+
+use std::{
+    hash::{DefaultHasher, Hash, Hasher},
+    path::{Path, PathBuf},
+};
+
+use tokio::task;
+use tracing::debug;
+use wayle_media::core::player::Player;
+
+pub(super) use self::embedded::Picture;
+
+const CACHE_DIR: &str = "wayle/media-art";
+/// Cover art larger than this is a file that is not really cover art.
+const MAX_PICTURE_BYTES: usize = 24 * 1024 * 1024;
+
+/// Finds a cover for a player whose own art URL led nowhere.
+///
+/// Returns a path a `background-image` can point at, or `None` when the track
+/// is not a local file or has no picture to find.
+pub(super) async fn find(player: &Player) -> Option<String> {
+    let url = super::transport::track_url(player).await?;
+    let path = local_path(&url)?;
+
+    task::spawn_blocking(move || find_blocking(&path))
+        .await
+        .inspect_err(|error| debug!(%error, "cover art lookup panicked"))
+        .ok()
+        .flatten()
+}
+
+fn find_blocking(path: &Path) -> Option<String> {
+    if let Some(beside) = sidecar::beside(path) {
+        return beside.to_str().map(String::from);
+    }
+
+    let picture = embedded::extract(path, MAX_PICTURE_BYTES)?;
+    cache(path, &picture)
+}
+
+/// Turns a `file://` URL into a path, undoing the percent-encoding a player
+/// applies to spaces and to anything non-ASCII in a filename.
+fn local_path(url: &str) -> Option<PathBuf> {
+    let encoded = url.strip_prefix("file://")?;
+    // A `file://host/path` URL is not something a media player publishes, but
+    // an empty authority (`file:///path`) leaves the path starting at the
+    // third slash, which is what the strip above already left behind.
+    let decoded = percent_decode(encoded)?;
+    let path = PathBuf::from(decoded);
+    path.is_absolute().then_some(path)
+}
+
+fn percent_decode(value: &str) -> Option<String> {
+    let bytes = value.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut index = 0;
+    while index < bytes.len() {
+        if bytes[index] == b'%' {
+            let hex = value.get(index + 1..index + 3)?;
+            out.push(u8::from_str_radix(hex, 16).ok()?);
+            index += 3;
+        } else {
+            out.push(bytes[index]);
+            index += 1;
+        }
+    }
+    String::from_utf8(out).ok()
+}
+
+/// Writes an extracted picture next to the covers `wayle-media` downloads, so
+/// the two kinds of art age out of the same place.
+fn cache(track: &Path, picture: &Picture) -> Option<String> {
+    let mut hasher = DefaultHasher::new();
+    track.hash(&mut hasher);
+    picture.bytes.len().hash(&mut hasher);
+    let name = format!("embedded-{:016x}.{}", hasher.finish(), picture.extension());
+
+    let destination = cache_dir()?.join(name);
+    if !destination.exists() {
+        std::fs::create_dir_all(destination.parent()?).ok()?;
+        std::fs::write(&destination, &picture.bytes)
+            .inspect_err(|error| debug!(%error, "could not cache extracted cover art"))
+            .ok()?;
+    }
+    destination.to_str().map(String::from)
+}
+
+fn cache_dir() -> Option<PathBuf> {
+    let base = std::env::var_os("XDG_CACHE_HOME")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".cache")))?;
+    Some(base.join(CACHE_DIR))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn local_path_decodes_percent_escapes() {
+        let path = local_path("file:///music/Bj%C3%B6rk/J%C3%B3ga%20-%20live.flac");
+
+        assert_eq!(path, Some(PathBuf::from("/music/Björk/Jóga - live.flac")));
+    }
+
+    #[test]
+    fn local_path_keeps_a_plain_path() {
+        assert_eq!(
+            local_path("file:///music/track.mp3"),
+            Some(PathBuf::from("/music/track.mp3"))
+        );
+    }
+
+    #[test]
+    fn local_path_rejects_other_schemes() {
+        assert_eq!(local_path("https://example.com/track.mp3"), None);
+        assert_eq!(local_path("spotify:track:abc"), None);
+    }
+
+    #[test]
+    fn local_path_rejects_a_truncated_escape() {
+        assert_eq!(local_path("file:///music/track%2.mp3"), None);
+    }
+
+    #[test]
+    fn percent_decode_leaves_ordinary_text_alone() {
+        assert_eq!(percent_decode("plain/path.flac"), Some(String::from("plain/path.flac")));
+    }
+}
diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/sidecar.rs b/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/sidecar.rs
new file mode 100644
index 0000000..69dbb8a
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/media/artwork/sidecar.rs
@@ -0,0 +1,161 @@
+//! Cover art stored as its own file next to the track.
+
+use std::path::{Path, PathBuf};
+
+/// Names a ripper or a tagger gives the folder's cover, best first.
+const COVER_STEMS: &[&str] = &["cover", "folder", "front", "album", "albumart", "thumb"];
+const IMAGE_EXTENSIONS: &[&str] = &["jpg", "jpeg", "png", "webp", "avif", "bmp", "gif"];
+
+/// Looks for a cover in the track's own folder.
+///
+/// A file named after the track wins over the folder's cover, because a folder
+/// holding one album still gets a per-track picture when the tracks differ.
+pub(super) fn beside(track: &Path) -> Option<PathBuf> {
+    let folder = track.parent()?;
+    let entries = read_names(folder)?;
+
+    if let Some(stem) = track.file_stem().and_then(|stem| stem.to_str())
+        && let Some(found) = matching(&entries, folder, &[stem])
+    {
+        return Some(found);
+    }
+
+    matching(&entries, folder, COVER_STEMS)
+}
+
+/// The folder read once, so a folder of a thousand tracks is not walked once
+/// per candidate name.
+fn read_names(folder: &Path) -> Option<Vec<String>> {
+    let mut names: Vec<String> = std::fs::read_dir(folder)
+        .ok()?
+        .flatten()
+        .filter(|entry| entry.file_type().is_ok_and(|kind| kind.is_file()))
+        .filter_map(|entry| entry.file_name().to_str().map(String::from))
+        .collect();
+    names.sort();
+    Some(names)
+}
+
+fn matching(entries: &[String], folder: &Path, stems: &[&str]) -> Option<PathBuf> {
+    // Ordered by the caller's preference, not by what the folder happens to
+    // list first, so `cover.jpg` beats `thumb.png` wherever they sit.
+    for stem in stems {
+        for extension in IMAGE_EXTENSIONS {
+            let wanted = format!("{stem}.{extension}");
+            if let Some(found) = entries
+                .iter()
+                .find(|entry| entry.eq_ignore_ascii_case(&wanted))
+            {
+                return Some(folder.join(found));
+            }
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn folder() -> tempdir::TempDir {
+        tempdir::TempDir::new()
+    }
+
+    #[test]
+    fn a_cover_in_the_folder_is_found() {
+        let dir = folder();
+        std::fs::write(dir.path().join("01 - song.flac"), b"x").unwrap();
+        std::fs::write(dir.path().join("cover.jpg"), b"x").unwrap();
+
+        assert_eq!(
+            beside(&dir.path().join("01 - song.flac")),
+            Some(dir.path().join("cover.jpg"))
+        );
+    }
+
+    #[test]
+    fn the_tracks_own_picture_wins_over_the_folder_cover() {
+        let dir = folder();
+        std::fs::write(dir.path().join("song.mp3"), b"x").unwrap();
+        std::fs::write(dir.path().join("song.png"), b"x").unwrap();
+        std::fs::write(dir.path().join("cover.jpg"), b"x").unwrap();
+
+        assert_eq!(
+            beside(&dir.path().join("song.mp3")),
+            Some(dir.path().join("song.png"))
+        );
+    }
+
+    #[test]
+    fn the_name_is_matched_whatever_its_case() {
+        let dir = folder();
+        std::fs::write(dir.path().join("song.flac"), b"x").unwrap();
+        std::fs::write(dir.path().join("Folder.JPG"), b"x").unwrap();
+
+        assert_eq!(
+            beside(&dir.path().join("song.flac")),
+            Some(dir.path().join("Folder.JPG"))
+        );
+    }
+
+    #[test]
+    fn cover_is_preferred_to_the_other_folder_names() {
+        let dir = folder();
+        std::fs::write(dir.path().join("song.flac"), b"x").unwrap();
+        std::fs::write(dir.path().join("thumb.png"), b"x").unwrap();
+        std::fs::write(dir.path().join("cover.png"), b"x").unwrap();
+
+        assert_eq!(
+            beside(&dir.path().join("song.flac")),
+            Some(dir.path().join("cover.png"))
+        );
+    }
+
+    #[test]
+    fn a_folder_without_a_picture_yields_nothing() {
+        let dir = folder();
+        std::fs::write(dir.path().join("song.flac"), b"x").unwrap();
+        std::fs::write(dir.path().join("notes.txt"), b"x").unwrap();
+
+        assert_eq!(beside(&dir.path().join("song.flac")), None);
+    }
+
+    #[test]
+    fn a_directory_named_like_a_cover_is_not_one() {
+        let dir = folder();
+        std::fs::write(dir.path().join("song.flac"), b"x").unwrap();
+        std::fs::create_dir(dir.path().join("cover.jpg")).unwrap();
+
+        assert_eq!(beside(&dir.path().join("song.flac")), None);
+    }
+
+    /// A directory that removes itself, so the tests leave nothing behind.
+    mod tempdir {
+        use std::path::{Path, PathBuf};
+
+        pub struct TempDir(PathBuf);
+
+        impl TempDir {
+            pub fn new() -> Self {
+                let base = std::env::temp_dir().join(format!(
+                    "wayle-sidecar-{}-{:?}",
+                    std::process::id(),
+                    std::thread::current().id()
+                ));
+                let _ = std::fs::remove_dir_all(&base);
+                std::fs::create_dir_all(&base).expect("temp dir");
+                Self(base)
+            }
+
+            pub fn path(&self) -> &Path {
+                &self.0
+            }
+        }
+
+        impl Drop for TempDir {
+            fn drop(&mut self) {
+                let _ = std::fs::remove_dir_all(&self.0);
+            }
+        }
+    }
+}
