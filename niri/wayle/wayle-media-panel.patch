+
+impl MediaDropdown {
+    fn update_player_list(&mut self, players: Vec<Arc<Player>>, sender: &ComponentSender<Self>) {
+        let token = self.player_state_watcher.reset();
+        watchers::spawn_playback_state(sender, &players, token);
+        self.sync_player_views(players);
+    }
+
+    fn sync_player_views(&mut self, players: Vec<Arc<Player>>) {
+        let mut players = deduplicate_players(
+            players
+                .into_iter()
+                .filter(|player| player.playback_state.get() != PlaybackState::Stopped)
+                .collect(),
+        );
+        players.sort_by_key(|player| playback_rank(player.playback_state.get()));
+        let player_ids: Vec<_> = players.iter().map(|player| player.id.clone()).collect();
+
+        if player_ids == self.player_ids {
+            return;
         }
+
+        while let Some(child) = self.player_list.first_child() {
+            self.player_list.remove(&child);
+        }
+        self.player_views.clear();
+
+        for player in players {
+            let player_view = PlayerView::builder()
+                .launch(PlayerViewInit { player })
+                .detach();
+            player_view.emit(PlayerViewInput::SetActive(self.is_active));
+            self.player_list.append(player_view.widget());
+            self.player_views.push(player_view);
+        }
+
+        self.player_ids = player_ids;
     }
 }
+
+fn playback_rank(state: PlaybackState) -> u8 {
+    match state {
+        PlaybackState::Playing => 0,
+        PlaybackState::Paused => 1,
+        PlaybackState::Stopped => 2,
+    }
+}
+
+fn deduplicate_players(players: Vec<Arc<Player>>) -> Vec<Arc<Player>> {
+    let mut seen_ids = HashSet::new();
+    let players: Vec<_> = players
+        .into_iter()
+        .filter(|player| seen_ids.insert(player.id.clone()))
+        .collect();
+
+    let mut keep = vec![true; players.len()];
+    for left_index in 0..players.len() {
+        if !keep[left_index] {
+            continue;
+        }
+        for right_index in (left_index + 1)..players.len() {
+            if !keep[right_index]
+                || !same_player_snapshot(&players[left_index], &players[right_index])
+            {
+                continue;
+            }
+            let left_playing = players[left_index].playback_state.get() == PlaybackState::Playing;
+            let right_playing = players[right_index].playback_state.get() == PlaybackState::Playing;
+            if left_playing && !right_playing {
+                keep[right_index] = false;
+            } else {
+                keep[left_index] = false;
+                break;
+            }
+        }
+    }
+
+    for bridge_index in 0..players.len() {
+        if !keep[bridge_index] || !is_mprisence(&players[bridge_index]) {
+            continue;
+        }
+        let Some(proxy_index) = (0..players.len()).find(|&index| {
+            keep[index]
+                && index != bridge_index
+                && is_browser_or_proxy(&players[index])
+                && matching_metadata(&players[bridge_index], &players[index])
+        }) else {
+            continue;
+        };
+        let bridge = &players[bridge_index];
+        let proxy = &players[proxy_index];
+        let bridge_playing = bridge.playback_state.get() == PlaybackState::Playing;
+        let proxy_playing = proxy.playback_state.get() == PlaybackState::Playing;
+        if proxy_playing && !bridge_playing {
+            keep[bridge_index] = false;
+        } else if (bridge_playing && !proxy_playing)
+            || metadata_richness(bridge) >= metadata_richness(proxy)
+        {
+            keep[proxy_index] = false;
+        } else {
+            keep[bridge_index] = false;
+        }
+    }
+    players
+        .into_iter()
+        .zip(keep)
+        .filter_map(|(player, keep)| keep.then_some(player))
+        .collect()
+}
+
+fn same_player_snapshot(left: &Player, right: &Player) -> bool {
+    same_non_empty(&left.identity.get(), &right.identity.get())
+        && matching_metadata(left, right)
+}
+
+fn is_mprisence(player: &Player) -> bool {
+    player.id.bus_name().to_ascii_lowercase().contains("mprisence")
+}
+
+fn is_browser_or_proxy(player: &Player) -> bool {
+    let id = player.id.bus_name().to_ascii_lowercase();
+    [
+        "playerctld", "plasma-browser-integration", "chromium", "chrome",
+        "firefox", "brave", "vivaldi", "microsoft-edge", "opera", "zen",
+    ]
+    .iter()
+    .any(|candidate| id.contains(candidate))
+}
+
+fn matching_metadata(left: &Player, right: &Player) -> bool {
+    let left_title = normalized(&left.metadata.title.get());
+    if left_title.is_empty() || left_title != normalized(&right.metadata.title.get()) {
+        return false;
+    }
+    same_non_empty(&left.metadata.artist.get(), &right.metadata.artist.get())
+        || same_non_empty(&left.metadata.album.get(), &right.metadata.album.get())
+        || same_optional(&left.metadata.art_url.get(), &right.metadata.art_url.get())
+        || near_duration(left.metadata.length.get(), right.metadata.length.get())
+}
+
+fn normalized(value: &str) -> String {
+    value.split_whitespace().collect::<Vec<_>>().join(" ").to_lowercase()
+}
+
+fn same_non_empty(left: &str, right: &str) -> bool {
+    let left = normalized(left);
+    !left.is_empty() && left == normalized(right)
+}
+
+fn same_optional(left: &Option<String>, right: &Option<String>) -> bool {
+    left.as_deref()
+        .zip(right.as_deref())
+        .is_some_and(|(left, right)| same_non_empty(left, right))
+}
+
+fn near_duration(
+    left: Option<std::time::Duration>,
+    right: Option<std::time::Duration>,
+) -> bool {
+    left.zip(right).is_some_and(|(left, right)| {
+        let difference = if left >= right { left - right } else { right - left };
+        difference <= std::time::Duration::from_secs(2)
+    })
+}
+
+fn metadata_richness(player: &Player) -> usize {
+    [
+        !player.metadata.title.get().trim().is_empty(),
+        !player.metadata.artist.get().trim().is_empty(),
+        !player.metadata.album.get().trim().is_empty(),
+        player.metadata.art_url.get().is_some(),
+        player.metadata.length.get().is_some(),
+    ]
+    .into_iter()
+    .filter(|present| *present)
+    .count()
+}
