+impl MediaDropdown {
+    fn update_player_list(&mut self, players: Vec<Arc<Player>>, sender: &ComponentSender<Self>) {
+        let token = self.player_state_watcher.reset();
+        watchers::spawn_playback_state(sender, &players, token);
+        self.sync_player_views(players);
+    }
+
+    fn sync_player_views(&mut self, players: Vec<Arc<Player>>) {
+        let mut groups = deduplicate_players(
+            players
+                .into_iter()
+                .filter(|player| player.playback_state.get() != PlaybackState::Stopped)
+                .filter(|player| !is_proxy_only(player))
+                .collect(),
+        );
+        groups.sort_by_key(|group| playback_rank(group.player.playback_state.get()));
+
+        if same_groups(&self.groups, &groups) {
+            return;
+        }
+
+        while let Some(child) = self.player_list.first_child() {
+            self.player_list.remove(&child);
+        }
+        self.player_views.clear();
+
+        for group in &groups {
+            let player_view = PlayerView::builder()
+                .launch(PlayerViewInit {
+                    player: Arc::clone(&group.player),
+                    duplicates: group.duplicates.clone(),
+                })
+                .detach();
+            player_view.emit(PlayerViewInput::SetActive(self.is_active));
+            self.player_list.append(player_view.widget());
+            self.player_views.push(player_view);
+        }
+
+        self.groups = groups;
+        self.list_height = self.measure_list_height();
+    }
+
+    /// The height of a full list: `VISIBLE_CARDS` cards and the gaps between
+    /// them. Every card is the same size, so one of them gives the height of
+    /// all of them. Before the list is in a window GTK has no styling to
+    /// measure against and reports a card as far shorter than it will be
+    /// drawn, so an unrooted list keeps the fallback until it is shown.
+    fn measure_list_height(&self) -> i32 {
+        let card_height = self
+            .player_list
+            .first_child()
+            .filter(|_| self.player_list.root().is_some())
+            .map(|card| card.measure(gtk::Orientation::Vertical, -1).1)
+            .filter(|height| *height > 0)
+            .unwrap_or(self.fallback_card_height);
+
+        card_height * VISIBLE_CARDS + self.card_gap * (VISIBLE_CARDS - 1)
+    }
+}
+
+/// Whether the cards already on screen stand for exactly the same players.
+///
+/// The players themselves are compared, not their bus names: a bridge that
+/// republishes a browser tab claims the same name each time it recreates a
+/// player, and a card holding the replaced one is frozen — its state never
+/// changes again, so its play/pause button keeps sending the command the
+/// player is already in and the press does nothing.
+fn same_groups(current: &[PlayerGroup], next: &[PlayerGroup]) -> bool {
+    current.len() == next.len()
+        && current.iter().zip(next).all(|(current, next)| {
+            Arc::ptr_eq(&current.player, &next.player)
+                && current.duplicates.len() == next.duplicates.len()
+                && current
+                    .duplicates
+                    .iter()
+                    .zip(&next.duplicates)
+                    .all(|(current, next)| Arc::ptr_eq(current, next))
+        })
+}
+
+fn playback_rank(state: PlaybackState) -> u8 {
+    match state {
+        PlaybackState::Playing => 0,
+        PlaybackState::Paused => 1,
+        PlaybackState::Stopped => 2,
+    }
+}
+
+/// One card's players: the one it shows, and the duplicates it stands in for.
+pub(crate) struct PlayerGroup {
+    pub player: Arc<Player>,
+    pub duplicates: Vec<Arc<Player>>,
+}
+
+fn deduplicate_players(players: Vec<Arc<Player>>) -> Vec<PlayerGroup> {
+    let mut seen_ids = HashSet::new();
+    let players: Vec<_> = players
+        .into_iter()
+        .filter(|player| seen_ids.insert(player.id.clone()))
+        .collect();
+
+    // Which card each dropped player was folded into, recorded as it is
+    // dropped, so a command reaches every player the card stands for.
+    let tracks: Vec<TrackSnapshot> = players.iter().map(|p| TrackSnapshot::of(p)).collect();
+    let mut merged_into: Vec<Option<usize>> = vec![None; players.len()];
+    let mut keep = vec![true; players.len()];
+    for left_index in 0..players.len() {
+        if !keep[left_index] {
+            continue;
+        }
+        for right_index in (left_index + 1)..players.len() {
+            if !keep[right_index]
+                || !same_playback(&tracks[left_index], &tracks[right_index])
+            {
+                continue;
+            }
+            if candidate_rank(&players[left_index], &tracks[left_index])
+                >= candidate_rank(&players[right_index], &tracks[right_index])
+            {
+                keep[right_index] = false;
+                merged_into[right_index] = Some(left_index);
+            } else {
+                keep[left_index] = false;
+                merged_into[left_index] = Some(right_index);
+                break;
+            }
+        }
+    }
+
+    // Everything a card replaced is still a way to reach the same playback,
+    // including a player folded into one that was itself folded into a third.
+    let mut duplicates: Vec<Vec<Arc<Player>>> = vec![Vec::new(); players.len()];
+    for index in 0..players.len() {
+        if keep[index] {
+            continue;
+        }
+        if let Some(card) = surviving_card(index, &merged_into, &keep) {
+            duplicates[card].push(Arc::clone(&players[index]));
+        }
+    }
+
+    players
+        .into_iter()
+        .zip(keep)
+        .zip(duplicates)
+        .filter_map(|((player, keep), duplicates)| {
+            keep.then_some(PlayerGroup {
+                player,
+                duplicates,
+            })
+        })
+        .collect()
+}
+
+/// How good a candidate a player is for the card that stands for a piece of
+/// playback; the highest wins. Larger is better in every position.
+///
+/// Control comes first because the panel is a control surface: a publisher
+/// that answers `CanControl=false` is telling every client its buttons will do
+/// nothing, and `playerctl` will not even send to it. Such a publisher is also
+/// usually the one that has lost sight of what it is publishing — the browser
+/// bridge that cannot reach its tab reports no duration and a frozen position
+/// while the tab plays on — so preferring the controllable one also picks the
+/// one whose state is worth believing.
+fn candidate_rank(player: &Player, track: &TrackSnapshot) -> (bool, bool, bool, usize) {
+    (
+        player.can_control.get(),
+        player.playback_state.get() == PlaybackState::Playing,
+        !is_mirror(player),
+        track.richness(),
+    )
+}
+
+/// A player that only ever mirrors another one already on the bus.
+///
+/// `playerctld` proxies whichever player was last active and copies its
+/// identity and metadata wholesale, so it appears as a second card under the
+/// real player's own name — an "Elisa" card beside Elisa, or a second "YouTube
+/// Music" beside the tab. Nothing it shows is absent from the bus, and
+/// anything it can do is one hop further from the audio than asking the player
+/// itself, so the panel leaves it out rather than relying on the metadata
+/// still matching closely enough to merge the two.
+fn is_proxy_only(player: &Player) -> bool {
+    player.id.bus_name() == PLAYERCTLD_BUS_NAME
+}
+
+/// A player that republishes someone else's playback rather than owning it.
+///
+/// Only ever a tie-break: a browser tab's bridge is the only publisher there
+/// is, and still wins by being the only candidate. It matters when a mirror
+/// stands beside the player it mirrors, where showing the mirror puts an extra
+/// hop between the button and the audio.
+fn is_mirror(player: &Player) -> bool {
+    player.id.bus_name().to_ascii_lowercase().contains("mprisence")
+}
+
+/// Follows the chain of merges from a dropped player to the card that ended up
+/// standing for it, stopping if the records ever form a loop.
+fn surviving_card(start: usize, merged_into: &[Option<usize>], keep: &[bool]) -> Option<usize> {
+    let mut index = merged_into[start]?;
+    for _ in 0..merged_into.len() {
+        if keep[index] {
+            return Some(index);
+        }
+        index = merged_into[index]?;
+    }
+    None
+}
+
+/// The fields deduplication compares, read off a player once.
+///
+/// Lifting them out keeps the rules below free of the bus, which is what lets
+/// them be tested, and reads each property once instead of once per pairing.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct TrackSnapshot {
+    identity: String,
+    title: String,
+    artist: String,
+    album: String,
+    art_url: Option<String>,
+    length: Option<Duration>,
+    position: Duration,
+}
+
+impl TrackSnapshot {
+    fn of(player: &Player) -> Self {
+        let metadata = &player.metadata;
+        Self {
+            identity: player.identity.get(),
+            title: metadata.title.get(),
+            artist: metadata.artist.get(),
+            album: metadata.album.get(),
+            art_url: metadata.art_url.get(),
+            length: metadata.length.get(),
+            position: player.position.get(),
+        }
+    }
+
+    /// How much this player knows about what it is playing.
+    fn richness(&self) -> usize {
+        [
+            !self.title.trim().is_empty(),
+            !self.artist.trim().is_empty(),
+            !self.album.trim().is_empty(),
+            self.art_url.is_some(),
+            self.length.is_some(),
+        ]
+        .into_iter()
+        .filter(|present| *present)
+        .count()
+    }
+}
+
+/// Whether two players are publishing the same playback.
+///
+/// Identity is deliberately not part of this. Two publishers of one piece of
+/// playback routinely disagree about who they are — a bridge names the app or
+/// site it mirrors while the player names itself — and requiring them to agree
+/// is what left a local player and its mirror side by side as two cards
+/// showing the same track at the same second.
+///
+/// Dropping it means the rest of the metadata has to carry more weight. A
+/// title alone is something a mirror and an unrelated player can share, so two
+/// further fields have to line up, and a position the two disagree about
+/// settles it the other way. Position is only evidence when both report one:
+/// `wayle-media` stops polling it for a player nothing is watching, so a zero
+/// there means unknown rather than the start of the track.
+fn same_playback(left: &TrackSnapshot, right: &TrackSnapshot) -> bool {
+    same_title(left, right)
+        && corroborating_fields(left, right) >= required_corroboration(left, right)
+        && !positions_disagree(left, right)
+}
+
+/// How much of the metadata has to agree before two players are treated as one
+/// playback.
+///
+/// Two publishers that agree on who they are need less: one app publishing
+/// itself twice is not a coincidence to be guarded against, and holding out
+/// for more leaves the pair unmerged whenever the second one's metadata has
+/// not fully arrived. The pair that has to be told apart from a genuine
+/// coincidence is the one where a bridge and the player it mirrors name
+/// themselves differently, and that pair is asked for more.
+fn required_corroboration(left: &TrackSnapshot, right: &TrackSnapshot) -> usize {
+    if same_non_empty(&left.identity, &right.identity) {
+        1
+    } else {
+        2
+    }
+}
+
+fn same_title(left: &TrackSnapshot, right: &TrackSnapshot) -> bool {
+    let title = normalized(&left.title);
+    !title.is_empty() && title == normalized(&right.title)
+}
+
+fn corroborating_fields(left: &TrackSnapshot, right: &TrackSnapshot) -> usize {
+    [
+        same_non_empty(&left.artist, &right.artist),
+        same_non_empty(&left.album, &right.album),
+        same_optional(&left.art_url, &right.art_url),
+        near_duration(left.length, right.length),
+    ]
+    .into_iter()
+    .filter(|agrees| *agrees)
+    .count()
+}
+
+fn positions_disagree(left: &TrackSnapshot, right: &TrackSnapshot) -> bool {
+    !left.position.is_zero()
+        && !right.position.is_zero()
+        && left.position.abs_diff(right.position) > POSITION_TOLERANCE
+}
+
+fn normalized(value: &str) -> String {
+    value
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ")
+        .to_lowercase()
+}
+
+fn same_non_empty(left: &str, right: &str) -> bool {
+    let left = normalized(left);
+    !left.is_empty() && left == normalized(right)
+}
+
+fn same_optional(left: &Option<String>, right: &Option<String>) -> bool {
+    left.as_deref()
+        .zip(right.as_deref())
+        .is_some_and(|(left, right)| same_non_empty(left, right))
+}
+
+fn near_duration(left: Option<Duration>, right: Option<Duration>) -> bool {
+    left.zip(right)
+        .is_some_and(|(left, right)| left.abs_diff(right) <= Duration::from_secs(2))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{
+        Duration, PLAYERCTLD_BUS_NAME, TrackSnapshot, same_playback, surviving_card,
+    };
+
+    fn track(title: &str, artist: &str, album: &str) -> TrackSnapshot {
+        TrackSnapshot {
+            identity: String::from("Elisa"),
+            title: String::from(title),
+            artist: String::from(artist),
+            album: String::from(album),
+            length: Some(Duration::from_secs(160)),
+            ..TrackSnapshot::default()
+        }
+    }
+
+    #[test]
+    fn a_player_and_its_mirror_are_one_playback() {
+        // What the panel showed as an "Elisa" card and a "YouTube Music" card:
+        // the same track at the same second, published twice. Identity is the
+        // only thing they disagreed about, and it is no longer consulted.
+        let elisa = track("Summer Feelings", "Lennon Stella/Charlie Puth", "Summer Feelings");
+        let mirror = elisa.clone();
+
+        assert!(same_playback(&elisa, &mirror));
+    }
+
+    #[test]
+    fn one_app_publishing_itself_twice_is_one_playback() {
+        // Two "YouTube Music" cards for one song. They agree on who they are,
+        // so a single further field is enough — waiting for more leaves them
+        // side by side while the second one's metadata is still arriving.
+        let full = track("Back To Sleep", "Chris Brown", "Royalty (Deluxe Version)");
+        let arriving = TrackSnapshot {
+            identity: full.identity.clone(),
+            title: full.title.clone(),
+            artist: full.artist.clone(),
+            ..TrackSnapshot::default()
+        };
+
+        assert!(same_playback(&full, &arriving));
+    }
+
+    #[test]
+    fn a_mirror_naming_itself_differently_is_asked_for_more() {
+        // One agreeing field is not enough across a disagreement about
+        // identity, which is where a coincidence could otherwise slip in.
+        let elisa = track("Summer Feelings", "Lennon Stella", "Summer Feelings");
+        let thin_mirror = TrackSnapshot {
+            identity: String::from("YouTube Music"),
+            title: elisa.title.clone(),
+            artist: elisa.artist.clone(),
+            ..TrackSnapshot::default()
+        };
+        assert!(!same_playback(&elisa, &thin_mirror));
+
+        // With the album agreeing too, it is the same playback.
+        let full_mirror = TrackSnapshot {
+            identity: String::from("YouTube Music"),
+            ..elisa.clone()
+        };
+        assert!(same_playback(&elisa, &full_mirror));
+    }
+
+    #[test]
+    fn different_tracks_are_not_merged() {
+        let left = track("Summer Feelings", "Lennon Stella", "Summer Feelings");
+        let right = track("1999", "Charli xcx", "1999");
+
+        assert!(!same_playback(&left, &right));
+    }
+
+    #[test]
+    fn a_shared_title_alone_is_not_enough() {
+        // A cover, or two unrelated tracks that happen to share a name.
+        let left = track("Everlong", "Foo Fighters", "The Colour and the Shape");
+        let right = TrackSnapshot {
+            title: String::from("Everlong"),
+            length: Some(Duration::from_secs(600)),
+            ..TrackSnapshot::default()
+        };
+
+        assert!(!same_playback(&left, &right));
+    }
+
+    #[test]
+    fn two_players_at_different_points_are_separate() {
+        let left = TrackSnapshot {
+            position: Duration::from_secs(6),
+            ..track("Summer Feelings", "Lennon Stella", "Summer Feelings")
+        };
+        let right = TrackSnapshot {
+            position: Duration::from_secs(120),
+            ..track("Summer Feelings", "Lennon Stella", "Summer Feelings")
+        };
+
+        assert!(!same_playback(&left, &right));
+    }
+
+    #[test]
+    fn a_position_of_zero_is_unknown_rather_than_the_start() {
+        // wayle-media stops polling position for a player nothing watches, so
+        // zero must not be read as disagreement with a player midway through.
+        let watched = TrackSnapshot {
+            position: Duration::from_secs(120),
+            ..track("Summer Feelings", "Lennon Stella", "Summer Feelings")
+        };
+        let unwatched = track("Summer Feelings", "Lennon Stella", "Summer Feelings");
+
+        assert!(same_playback(&watched, &unwatched));
+    }
+
+    #[test]
+    fn positions_a_few_seconds_apart_still_match() {
+        // The two are polled at different moments, which is not disagreement.
+        let left = TrackSnapshot {
+            position: Duration::from_secs(60),
+            ..track("Summer Feelings", "Lennon Stella", "Summer Feelings")
+        };
+        let right = TrackSnapshot {
+            position: Duration::from_secs(62),
+            ..track("Summer Feelings", "Lennon Stella", "Summer Feelings")
+        };
+
+        assert!(same_playback(&left, &right));
+    }
+
+    #[test]
+    fn an_untitled_track_never_matches() {
+        let blank = TrackSnapshot::default();
+
+        assert!(!same_playback(&blank, &blank));
+    }
+
+    #[test]
+    fn the_proxy_is_named_exactly() {
+        // Matched whole, not by substring: a real player is free to have
+        // "playerctld" somewhere in its own name.
+        assert_eq!(PLAYERCTLD_BUS_NAME, "org.mpris.MediaPlayer2.playerctld");
+    }
+
+    #[test]
+    fn the_proxys_copy_would_have_merged_anyway() {
+        // What the bus actually showed: playerctld mirroring Elisa down to the
+        // metadata, a second apart. Excluding it is belt and braces over a
+        // merge that would also have caught it.
+        let elisa = TrackSnapshot {
+            identity: String::from("Elisa"),
+            title: String::from("Tomboy"),
+            artist: String::from("Destiny Rogers"),
+            album: String::from("Tomboy"),
+            length: Some(Duration::from_micros(203_496_000)),
+            position: Duration::from_micros(91_974_000),
+            ..TrackSnapshot::default()
+        };
+        let proxy = TrackSnapshot {
+            position: Duration::from_micros(92_550_000),
+            ..elisa.clone()
+        };
+
+        assert!(same_playback(&elisa, &proxy));
+    }
+
+    #[test]
+    fn richness_counts_what_a_player_knows() {
+        assert_eq!(track("t", "a", "b").richness(), 4);
+        assert_eq!(TrackSnapshot::default().richness(), 0);
+    }
+
+    #[test]
+    fn surviving_card_follows_a_chain_of_merges() {
+        // 0 was folded into 1, which was itself folded into 2.
+        let merged_into = [Some(1), Some(2), None];
+        let keep = [false, false, true];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), Some(2));
+    }
+
+    #[test]
+    fn surviving_card_stops_at_the_first_survivor() {
+        let merged_into = [Some(1), None, None];
+        let keep = [false, true, true];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), Some(1));
+    }
+
+    #[test]
+    fn surviving_card_gives_up_on_a_loop() {
+        let merged_into = [Some(1), Some(0)];
+        let keep = [false, false];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), None);
+    }
+
+    #[test]
+    fn surviving_card_gives_up_when_the_chain_ends_nowhere() {
+        let merged_into = [Some(1), None];
+        let keep = [false, false];
+
+        assert_eq!(surviving_card(0, &merged_into, &keep), None);
+    }
+}
