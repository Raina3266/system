+//! Toggle the native Wayle dashboard.
+
+use std::collections::HashMap;
+
+use super::proxy::{actions_proxy, connect, is_running};
+use crate::cli::CliAction;
+
+/// Toggles the native dashboard on the running shell via GTK's action bus.
+///
+/// # Errors
+///
+/// Returns an error if the panel is not running or action activation fails.
+pub async fn execute() -> CliAction {
+    if !is_running().await.unwrap_or(false) {
+        return Err("Panel is not running".to_string());
+    }
+
+    let connection = connect().await?;
+    let proxy = actions_proxy(&connection).await?;
+
+    proxy
+        .activate("dashboard", Vec::new(), HashMap::new())
+        .await
+        .map_err(|e| format!("Failed to toggle dashboard: {e}"))?;
+
+    Ok(())
+}
