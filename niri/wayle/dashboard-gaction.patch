+fn register_dashboard_action(dropdowns: &Rc<DropdownRegistry>, anchor: &gtk::Box) {
+    let action = gtk::gio::SimpleAction::new("dashboard", None);
+    let dropdowns = Rc::clone(dropdowns);
+    let anchor = anchor.clone();
+
+    action.connect_activate(move |_, _| {
+        let click = ClickAction::Dropdown(String::from("dashboard"));
+        dispatch_click_widget(&click, &dropdowns, &anchor);
+    });
+
+    main_application().add_action(&action);
+}
