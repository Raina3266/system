+        const WAYBAR_SIZE: i32 = 40;
+        const GAP: i32 = 6;
+        const OFFSET: i32 = WAYBAR_SIZE + GAP;
+        // Dashboard includes its battery percentage. Network is the button
+        // immediately to its left in Waybar.
+        const DASHBOARD_SLOT: i32 = 90;
+        let along_bar = if name == "network" {
+            GAP + DASHBOARD_SLOT
+        } else {
+            GAP
+        };
+
+        content.set_margin_top(0);
+        content.set_margin_bottom(0);
+        content.set_margin_start(0);
+        content.set_margin_end(0);
+
+        match location {
+            Location::Top => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(OFFSET);
+                content.set_margin_end(along_bar);
+            }
+            Location::Bottom => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::End);
+                content.set_margin_bottom(OFFSET);
+                content.set_margin_end(along_bar);
+            }
+            Location::Left => {
+                content.set_halign(gtk::Align::Start);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(along_bar);
+                content.set_margin_start(OFFSET);
+            }
+            Location::Right => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(along_bar);
+                content.set_margin_end(OFFSET);
+            }
+        }
+    }
