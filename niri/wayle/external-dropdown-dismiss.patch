+
+        // A content-sized layer surface cannot observe clicks outside itself.
+        // Stretch a transparent host across the monitor and place the visible
+        // dropdown above a click target. The click is intentionally consumed:
+        // it dismisses the panel without activating whatever is underneath.
+        for edge in [Edge::Top, Edge::Bottom, Edge::Left, Edge::Right] {
+            window.set_anchor(edge, true);
+            window.set_margin(edge, 0);
+        }
+
+        let overlay = gtk::Overlay::new();
+        overlay.set_hexpand(true);
+        overlay.set_vexpand(true);
+
+        let backdrop = gtk::Box::new(gtk::Orientation::Vertical, 0);
+        backdrop.set_hexpand(true);
+        backdrop.set_vexpand(true);
+        let dismiss = gtk::GestureClick::new();
+        let weak_window = window.downgrade();
+        dismiss.connect_released(move |_, _, _, _| {
+            if let Some(window) = weak_window.upgrade() {
+                window.set_visible(false);
+            }
+        });
+        backdrop.add_controller(dismiss);
+        overlay.set_child(Some(&backdrop));
+
+        content.add_css_class("external-dropdown-panel");
+        Self::position_external_content(&content, style.location, name);
+        overlay.add_overlay(&content);
+        window.set_child(Some(&overlay));
 
         if let Some(controller) = self
             .controller
             .downcast_ref::<Controller<DashboardDropdown>>()
         {
             controller.emit(DashboardDropdownMsg::SetExternalHost(window.clone()));
+        } else if let Some(controller) = self
+            .controller
+            .downcast_ref::<Controller<NetworkDropdown>>()
+        {
+            controller.emit(NetworkDropdownMsg::SetExternalHost(window.clone()));
         }
         window.present();
         self.external_window.replace(Some(window));
         self.external_visibility_changed(true);
         true
     }
 
     fn external_visibility_changed(&self, visible: bool) {
         let Some(controller) = self
             .controller
             .downcast_ref::<Controller<NetworkDropdown>>()
         else {
             return;
         };
 
         if visible {
             controller.emit(NetworkDropdownMsg::ScanRequested);
         } else {
             controller.emit(NetworkDropdownMsg::Reset);
         }
     }
 
     fn hide_external_window(&self) {
         let external_window = self.external_window.borrow();
         let Some(window) = external_window.as_ref() else {
             return;
         };
         if window.is_visible() {
             window.set_visible(false);
             self.external_visibility_changed(false);
         }
     }
 
     fn position_external_window(window: &gtk::Window, location: Location, name: &str) {
         const WAYBAR_SIZE: i32 = 40;
         const GAP: i32 = 6;
         const OFFSET: i32 = WAYBAR_SIZE + GAP;
         const WAYBAR_BUTTON_STEP: i32 = 50;
         let along_bar = if name == "network" {
             GAP + WAYBAR_BUTTON_STEP
         } else {
             GAP
         };
 
         match location {
             Location::Top => {
                 window.set_anchor(Edge::Top, true);
                 window.set_anchor(Edge::Left, true);
                 window.set_margin(Edge::Top, OFFSET);
                 window.set_margin(Edge::Left, along_bar);
             }
             Location::Bottom => {
                 window.set_anchor(Edge::Bottom, true);
                 window.set_anchor(Edge::Left, true);
                 window.set_margin(Edge::Bottom, OFFSET);
                 window.set_margin(Edge::Left, along_bar);
             }
             Location::Left => {
                 window.set_anchor(Edge::Top, true);
                 window.set_anchor(Edge::Left, true);
                 window.set_margin(Edge::Top, along_bar);
                 window.set_margin(Edge::Left, OFFSET);
             }
             Location::Right => {
                 window.set_anchor(Edge::Top, true);
                 window.set_anchor(Edge::Right, true);
                 window.set_margin(Edge::Top, along_bar);
                 window.set_margin(Edge::Right, OFFSET);
             }
         }
     }
+
+    fn position_external_content(content: &gtk::Widget, location: Location, name: &str) {
+        const WAYBAR_SIZE: i32 = 40;
+        const GAP: i32 = 6;
+        const OFFSET: i32 = WAYBAR_SIZE + GAP;
+        // Dashboard includes its battery percentage. Network is the button
+        // immediately to its left in Waybar.
+        const DASHBOARD_SLOT: i32 = 90;
+        let along_bar = if name == "network" {
+            GAP + DASHBOARD_SLOT
+        } else {
+            GAP
+        };
+
+        content.set_margin_top(0);
+        content.set_margin_bottom(0);
+        content.set_margin_start(0);
+        content.set_margin_end(0);
+
+        match location {
+            Location::Top => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(OFFSET);
+                content.set_margin_end(along_bar);
+            }
+            Location::Bottom => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::End);
+                content.set_margin_bottom(OFFSET);
+                content.set_margin_end(along_bar);
+            }
+            Location::Left => {
+                content.set_halign(gtk::Align::Start);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(along_bar);
+                content.set_margin_start(OFFSET);
+            }
+            Location::Right => {
+                content.set_halign(gtk::Align::End);
+                content.set_valign(gtk::Align::Start);
+                content.set_margin_top(along_bar);
+                content.set_margin_end(OFFSET);
+            }
+        }
+    }
