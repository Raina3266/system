+            let Some(digits) = part.strip_suffix('h') else {
+                return false;
+            };
+            (2..=3).contains(&digits.len())
+                && digits.starts_with(|character: char| character.is_ascii_digit())
+                && digits
+                    .chars()
+                    .all(|character| character.is_ascii_hexdigit())
+        })
