diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/calendar_section.rs b/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/calendar_section.rs
new file mode 100644
index 0000000..15019e7
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/calendar_section.rs
@@ -0,0 +1,317 @@
+use std::{env, fs, path::PathBuf};
+
+use chrono::{Duration, Local, NaiveDate};
+use gtk::prelude::*;
+use relm4::{gtk, prelude::*};
+use serde_json::Value;
+
+use crate::i18n::t;
+
+const DAYS: i64 = 7;
+const WRAP_CHARS: i32 = 34;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct AgendaEntry {
+    order: u8,
+    icon: &'static str,
+    title: String,
+    /// `HH:MM-HH:MM`, split off the title so it can be shown above the entry.
+    /// `None` for all-day events and tasks.
+    time: Option<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct AgendaDay {
+    heading: String,
+    entries: Vec<AgendaEntry>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct Agenda {
+    range: String,
+    days: Vec<AgendaDay>,
+}
+
+#[derive(Debug)]
+pub(crate) enum CalendarSectionInput {
+    Refresh,
+}
+
+pub(crate) struct CalendarSection {
+    agenda: Agenda,
+    body: gtk::Box,
+}
+
+#[relm4::component(pub(crate))]
+impl Component for CalendarSection {
+    type Init = ();
+    type Input = CalendarSectionInput;
+    type Output = ();
+    type CommandOutput = ();
+
+    view! {
+        #[root]
+        gtk::Box {
+            set_css_classes: &["card", "dashboard-card", "dashboard-calendar-section"],
+            set_orientation: gtk::Orientation::Vertical,
+
+            gtk::Box {
+                add_css_class: "card-header",
+
+                gtk::Box {
+                    add_css_class: "card-title",
+                    set_hexpand: true,
+
+                    gtk::Image {
+                        set_icon_name: Some("tb-calendar-time-symbolic"),
+                    },
+
+                    gtk::Label {
+                        set_label: &t!("dropdown-dashboard-calendar"),
+                    },
+                },
+
+                gtk::Label {
+                    add_css_class: "dashboard-calendar-range",
+                    set_halign: gtk::Align::End,
+                    #[watch]
+                    set_label: &model.agenda.range,
+                },
+            },
+
+            gtk::Label {
+                add_css_class: "dashboard-section-empty",
+                set_halign: gtk::Align::Start,
+                set_label: &t!("dropdown-dashboard-calendar-empty"),
+                #[watch]
+                set_visible: model.agenda.days.is_empty(),
+            },
+
+            gtk::ScrolledWindow {
+                add_css_class: "dashboard-calendar-scroll",
+                set_hscrollbar_policy: gtk::PolicyType::Never,
+                set_vscrollbar_policy: gtk::PolicyType::Automatic,
+                set_max_content_height: 320,
+                set_propagate_natural_height: true,
+                #[watch]
+                set_visible: !model.agenda.days.is_empty(),
+
+                #[local_ref]
+                body_widget -> gtk::Box {
+                    add_css_class: "dashboard-calendar-body",
+                    set_orientation: gtk::Orientation::Vertical,
+                },
+            },
+        }
+    }
+
+    fn init(
+        _init: Self::Init,
+        _root: Self::Root,
+        _sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let body = gtk::Box::new(gtk::Orientation::Vertical, 0);
+        let model = Self {
+            agenda: read_agenda(),
+            body,
+        };
+        model.rebuild_body();
+
+        let body_widget = &model.body;
+        let widgets = view_output!();
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, _sender: ComponentSender<Self>, _root: &Self::Root) {
+        match msg {
+            CalendarSectionInput::Refresh => {
+                self.agenda = read_agenda();
+                self.rebuild_body();
+            }
+        }
+    }
+}
+
+impl CalendarSection {
+    fn rebuild_body(&self) {
+        while let Some(child) = self.body.first_child() {
+            self.body.remove(&child);
+        }
+
+        for day in &self.agenda.days {
+            let heading = gtk::Label::new(Some(&day.heading));
+            heading.add_css_class("dashboard-calendar-day");
+            heading.set_xalign(0.0);
+            self.body.append(&heading);
+
+            for entry in &day.entries {
+                if let Some(time) = &entry.time {
+                    let time_label = gtk::Label::new(Some(time));
+                    time_label.add_css_class("dashboard-calendar-time");
+                    time_label.set_xalign(0.0);
+                    self.body.append(&time_label);
+                }
+
+                let label = gtk::Label::new(Some(&format!("{}  {}", entry.icon, entry.title)));
+                label.add_css_class("dashboard-calendar-entry");
+                label.set_xalign(0.0);
+                label.set_wrap(true);
+                label.set_wrap_mode(gtk::pango::WrapMode::WordChar);
+                label.set_max_width_chars(WRAP_CHARS);
+                self.body.append(&label);
+            }
+        }
+    }
+}
+
+fn cache_path() -> PathBuf {
+    env::var_os("HOME")
+        .map_or_else(PathBuf::new, PathBuf::from)
+        .join(".cache/waybar-ycal/events.json")
+}
+
+fn read_agenda() -> Agenda {
+    let cache = fs::read_to_string(cache_path()).unwrap_or_default();
+    build_agenda(&cache, Local::now().date_naive())
+}
+
+fn build_agenda(cache: &str, start: NaiveDate) -> Agenda {
+    let end = start + Duration::days(DAYS - 1);
+    let range = format!("{} – {}", start.format("%-d %b"), end.format("%-d %b"));
+    let parsed = serde_json::from_str::<Value>(cache).unwrap_or(Value::Null);
+
+    let mut days = Vec::new();
+    for offset in 0..DAYS {
+        let date = start + Duration::days(offset);
+        let entries = entries_for(&parsed, &date.format("%Y-%m-%d").to_string());
+        if entries.is_empty() {
+            continue;
+        }
+        days.push(AgendaDay {
+            heading: if offset == 0 {
+                t!("dropdown-dashboard-calendar-today")
+            } else {
+                date.format("%A %-d %b").to_string()
+            },
+            entries,
+        });
+    }
+
+    Agenda { range, days }
+}
+
+fn entries_for(parsed: &Value, date: &str) -> Vec<AgendaEntry> {
+    let Some(Value::Array(items)) = parsed.get(date) else {
+        return Vec::new();
+    };
+
+    let mut entries = items
+        .iter()
+        .filter_map(|item| match item {
+            Value::String(label) => {
+                let (title, time) = split_time(label);
+                Some(AgendaEntry {
+                    order: 1,
+                    icon: "󰃭",
+                    title,
+                    time,
+                })
+            }
+            Value::Object(task) => {
+                let done = task.get("done").and_then(Value::as_bool).unwrap_or(false);
+                Some(AgendaEntry {
+                    order: if done { 2 } else { 0 },
+                    icon: if done { "󰄲" } else { "󰄱" },
+                    title: task.get("title").and_then(Value::as_str)?.to_owned(),
+                    time: None,
+                })
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    entries.sort_by_key(|entry| entry.order);
+    entries
+}
+
+/// Splits `waybar-ycal`'s `"<title> HH:MM-HH:MM"` label into its two halves.
+///
+/// The cache appends the time range to a timed event's summary and leaves an
+/// all-day event as the summary alone, so anything that does not end in a time
+/// range is returned unchanged.
+fn split_time(label: &str) -> (String, Option<String>) {
+    let Some((title, tail)) = label.rsplit_once(' ') else {
+        return (label.to_owned(), None);
+    };
+
+    let Some((start, end)) = tail.split_once('-') else {
+        return (label.to_owned(), None);
+    };
+
+    if is_clock_time(start) && is_clock_time(end) {
+        (title.trim_end().to_owned(), Some(tail.to_owned()))
+    } else {
+        (label.to_owned(), None)
+    }
+}
+
+fn is_clock_time(value: &str) -> bool {
+    let Some((hours, minutes)) = value.split_once(':') else {
+        return false;
+    };
+
+    hours.len() == 2
+        && minutes.len() == 2
+        && hours.chars().all(|digit| digit.is_ascii_digit())
+        && minutes.chars().all(|digit| digit.is_ascii_digit())
+}
+
+#[cfg(test)]
+mod tests {
+    use chrono::NaiveDate;
+
+    use super::{build_agenda, split_time};
+
+    #[test]
+    fn timed_events_keep_their_time_apart_from_the_title() {
+        let (title, time) = split_time("Video appointment with Johns, Brian (Mr) 19:00-19:30");
+        assert_eq!(title, "Video appointment with Johns, Brian (Mr)");
+        assert_eq!(time.as_deref(), Some("19:00-19:30"));
+    }
+
+    #[test]
+    fn all_day_events_have_no_time() {
+        let (title, time) = split_time("Teachers' Day");
+        assert_eq!(title, "Teachers' Day");
+        assert_eq!(time, None);
+    }
+
+    #[test]
+    fn a_title_ending_in_a_range_that_is_not_a_time_is_left_alone() {
+        let (title, time) = split_time("Sprint 12-14");
+        assert_eq!(title, "Sprint 12-14");
+        assert_eq!(time, None);
+    }
+
+    #[test]
+    fn a_title_that_is_only_a_time_range_keeps_the_time() {
+        let (title, time) = split_time("Standup 09:00-09:15");
+        assert_eq!(title, "Standup");
+        assert_eq!(time.as_deref(), Some("09:00-09:15"));
+    }
+
+    #[test]
+    fn agenda_includes_today_and_the_following_six_days_only() {
+        let cache = r#"{
+            "2026-09-09": ["Today"],
+            "2026-09-15": ["Day seven"],
+            "2026-09-16": ["Too late"]
+        }"#;
+        let Some(start) = NaiveDate::from_ymd_opt(2026, 9, 9) else {
+            panic!("test date must be valid");
+        };
+        let agenda = build_agenda(cache, start);
+        assert_eq!(agenda.days.len(), 2);
+        assert_eq!(agenda.days[0].entries[0].title, "Today");
+        assert_eq!(agenda.days[1].entries[0].title, "Day seven");
+    }
+}
