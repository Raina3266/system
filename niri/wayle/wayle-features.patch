diff --git a/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/notification_section.rs b/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/notification_section.rs
new file mode 100644
index 0000000..53791e5
--- /dev/null
+++ b/crates/wayle-shell/src/shell/bar/dropdowns/dashboard/notification_section.rs
@@ -0,0 +1,278 @@
+use std::{sync::Arc, time::Duration};
+
+use gtk::prelude::*;
+use relm4::{gtk, prelude::*};
+use wayle_config::ConfigService;
+use wayle_notification::NotificationService;
+use wayle_widgets::{prelude::*, watch};
+
+use crate::{
+    i18n::t,
+    shell::bar::dropdowns::notification::{
+        helpers::group_by_app,
+        notification_group::{
+            NotificationGroup,
+            messages::{NotificationGroupInit, NotificationGroupInput, NotificationGroupOutput},
+        },
+    },
+};
+
+const TIME_TICK_INTERVAL: Duration = Duration::from_secs(30);
+
+pub(crate) struct NotificationSectionInit {
+    pub notification: Option<Arc<NotificationService>>,
+    pub config: Arc<ConfigService>,
+}
+
+#[derive(Debug)]
+pub(crate) enum NotificationSectionInput {
+    DndToggled(bool),
+    ClearAll,
+    NotificationDismissed,
+}
+
+#[derive(Debug)]
+pub(crate) enum NotificationSectionCmd {
+    NotificationsChanged,
+    DndChanged(bool),
+    IconSourceChanged,
+    TimeTick,
+}
+
+pub(crate) struct NotificationSection {
+    notification: Option<Arc<NotificationService>>,
+    config: Arc<ConfigService>,
+    dnd: bool,
+    notification_count: usize,
+    groups: FactoryVecDeque<NotificationGroup>,
+}
+
+#[relm4::component(pub(crate))]
+impl Component for NotificationSection {
+    type Init = NotificationSectionInit;
+    type Input = NotificationSectionInput;
+    type Output = ();
+    type CommandOutput = NotificationSectionCmd;
+
+    view! {
+        #[root]
+        gtk::Box {
+            set_css_classes: &["card", "dashboard-card", "notification-dropdown", "dashboard-notification-section"],
+            set_orientation: gtk::Orientation::Vertical,
+
+            gtk::Box {
+                add_css_class: "card-header",
+
+                gtk::Box {
+                    add_css_class: "card-title",
+
+                    gtk::Image {
+                        #[watch]
+                        set_icon_name: Some(if model.dnd {
+                            "ld-bell-off-symbolic"
+                        } else {
+                            "ld-bell-symbolic"
+                        }),
+                    },
+
+                    gtk::Label {
+                        set_label: &t!("dropdown-dashboard-notifications"),
+                    },
+                },
+
+                #[template]
+                Switch {
+                    add_css_class: "notification-dropdown-dnd-switch",
+                    set_valign: gtk::Align::Center,
+                    set_tooltip_text: Some(&t!("notification-dropdown-dnd-label")),
+                    set_visible: model.notification.is_some(),
+                    #[watch]
+                    #[block_signal(dnd_toggle)]
+                    set_active: model.dnd,
+                    connect_state_set[sender] => move |switch, active| {
+                        sender.input(NotificationSectionInput::DndToggled(active));
+                        switch.set_state(active);
+                        gtk::glib::Propagation::Stop
+                    } @dnd_toggle,
+                },
+
+                gtk::Box {
+                    set_hexpand: true,
+                },
+
+                #[template]
+                GhostButton {
+                    add_css_class: "notification-dropdown-clear-all",
+                    #[watch]
+                    set_visible: model.notification_count > 0,
+                    connect_clicked[sender] => move |_| {
+                        sender.input(NotificationSectionInput::ClearAll);
+                    },
+                    #[template_child]
+                    label {
+                        set_label: &t!("notification-dropdown-clear-all"),
+                    },
+                },
+            },
+
+            gtk::Label {
+                add_css_class: "dashboard-section-empty",
+                set_halign: gtk::Align::Start,
+                #[watch]
+                set_label: &model.empty_label(),
+                #[watch]
+                set_visible: model.notification_count == 0,
+            },
+
+            gtk::ScrolledWindow {
+                add_css_class: "dashboard-notification-scroll",
+                set_hscrollbar_policy: gtk::PolicyType::Never,
+                set_vscrollbar_policy: gtk::PolicyType::Automatic,
+                // Keep three notification rows visible; additional history is
+                // reached by scrolling inside the card.
+                set_max_content_height: 270,
+                set_propagate_natural_height: true,
+                #[watch]
+                set_visible: model.notification_count > 0,
+
+                #[local_ref]
+                groups_widget -> gtk::Box {
+                    add_css_class: "notification-dropdown-groups",
+                    set_orientation: gtk::Orientation::Vertical,
+                },
+            },
+        }
+    }
+
+    fn init(
+        init: Self::Init,
+        _root: Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let groups = FactoryVecDeque::builder()
+            .launch(gtk::Box::default())
+            .forward(sender.input_sender(), |output| match output {
+                NotificationGroupOutput::Dismissed => {
+                    NotificationSectionInput::NotificationDismissed
+                }
+            });
+
+        let mut model = Self {
+            dnd: init
+                .notification
+                .as_ref()
+                .is_some_and(|notification| notification.dnd.get()),
+            notification: init.notification,
+            config: init.config,
+            notification_count: 0,
+            groups,
+        };
+
+        model.rebuild_groups();
+        model.spawn_watchers(&sender);
+
+        let groups_widget = model.groups.widget();
+        let widgets = view_output!();
+        ComponentParts { model, widgets }
+    }
+
+    fn update(&mut self, msg: Self::Input, _sender: ComponentSender<Self>, _root: &Self::Root) {
+        match msg {
+            NotificationSectionInput::DndToggled(active) => {
+                if let Some(notification) = &self.notification {
+                    notification.set_dnd(active);
+                }
+            }
+            NotificationSectionInput::ClearAll => {
+                if let Some(notification) = &self.notification {
+                    for item in notification.notifications.get() {
+                        item.dismiss();
+                    }
+                }
+            }
+            NotificationSectionInput::NotificationDismissed => {}
+        }
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        _sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        match msg {
+            NotificationSectionCmd::NotificationsChanged => self.rebuild_groups(),
+            NotificationSectionCmd::DndChanged(dnd) => self.dnd = dnd,
+            NotificationSectionCmd::IconSourceChanged => self.rebuild_groups(),
+            NotificationSectionCmd::TimeTick => {
+                for index in 0..self.groups.len() {
+                    self.groups.send(index, NotificationGroupInput::RefreshTime);
+                }
+            }
+        }
+    }
+}
+
+impl NotificationSection {
+    fn empty_label(&self) -> String {
+        if self.notification.is_some() {
+            t!("notification-dropdown-empty-title")
+        } else {
+            t!("dropdown-dashboard-notifications-unavailable")
+        }
+    }
+
+    fn rebuild_groups(&mut self) {
+        let notifications = self
+            .notification
+            .as_ref()
+            .map(|notification| notification.notifications.get())
+            .unwrap_or_default();
+        self.notification_count = notifications.len();
+
+        let icon_source = self.config.config().modules.notifications.icon_source.get();
+        let mut guard = self.groups.guard();
+        guard.clear();
+        for group in group_by_app(&notifications) {
+            guard.push_back(NotificationGroupInit {
+                app_name: group.app_name,
+                notifications: group.notifications,
+                icon_source,
+            });
+        }
+    }
+
+    fn spawn_watchers(&self, sender: &ComponentSender<Self>) {
+        let Some(notification) = &self.notification else {
+            return;
+        };
+
+        let notifications = notification.notifications.clone();
+        watch!(sender, [notifications.watch()], |out| {
+            let _ = out.send(NotificationSectionCmd::NotificationsChanged);
+        });
+
+        let dnd = notification.dnd.clone();
+        watch!(sender, [dnd.watch()], |out| {
+            let _ = out.send(NotificationSectionCmd::DndChanged(dnd.get()));
+        });
+
+        let icon_source = self.config.config().modules.notifications.icon_source.clone();
+        watch!(sender, [icon_source.watch()], |out| {
+            let _ = out.send(NotificationSectionCmd::IconSourceChanged);
+        });
+
+        sender.command(|out, shutdown| async move {
+            let shutdown_fut = shutdown.wait();
+            tokio::pin!(shutdown_fut);
+            loop {
+                tokio::select! {
+                    () = &mut shutdown_fut => break,
+                    () = tokio::time::sleep(TIME_TICK_INTERVAL) => {
+                        let _ = out.send(NotificationSectionCmd::TimeTick);
+                    }
+                }
+            }
+        });
+    }
+}
