-use super::{bar::BarVisibility, state::ShellIpcState};
+use super::{
+    bar::BarVisibility,
+    state::{DropdownRequest, ShellIpcState},
+};
@@ -38,0 +42,31 @@ impl ShellIpcDaemon {
+    /// Toggles a dropdown on a monitor for integration with external bars.
+    pub async fn dropdown_toggle(&self, name: &str, monitor: &str) -> fdo::Result<()> {
+        if !crate::shell::bar::dropdowns::DROPDOWN_NAMES.contains(&name) {
+            return Err(fdo::Error::InvalidArgs(format!(
+                "unknown dropdown: {name}"
+            )));
+        }
+
+        let mut connectors = self.state.connectors.get();
+        connectors.sort();
+        let monitor = if monitor.is_empty() {
+            connectors.first().map(String::as_str).unwrap_or_default()
+        } else {
+            monitor
+        };
+
+        if !connectors.iter().any(|item| item == monitor) {
+            return Err(fdo::Error::InvalidArgs(format!(
+                "unknown monitor: {monitor}"
+            )));
+        }
+
+        let serial = self.state.dropdown_request.get().serial.wrapping_add(1);
+        self.state.dropdown_request.set(DropdownRequest {
+            serial,
+            name: name.to_owned(),
+            monitor: monitor.to_owned(),
+        });
+        Ok(())
+    }
+
