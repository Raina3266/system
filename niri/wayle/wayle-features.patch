@@ -0,0 +1,31 @@
+use std::{env, ffi::OsString, sync::Arc};
+
+use wayle_network::NetworkService;
+
+pub(super) async fn load(
+    _network: Arc<NetworkService>,
+    ssid: String,
+) -> Result<String, String> {
+    let output = tokio::process::Command::new(network_manager_binary())
+        .arg("wayle-info")
+        .arg(&ssid)
+        .output()
+        .await
+        .map_err(|error| format!("Could not start network-manager: {error}"))?;
+
+    if !output.status.success() {
+        let detail = String::from_utf8_lossy(&output.stderr);
+        return Err(if detail.trim().is_empty() {
+            format!("network-manager exited with {}", output.status)
+        } else {
+            detail.trim().to_owned()
+        });
+    }
+
+    String::from_utf8(output.stdout)
+        .map_err(|error| format!("network-manager returned invalid UTF-8: {error}"))
+}
+
+pub(super) fn network_manager_binary() -> OsString {
+    env::var_os("WAYLE_NETWORK_MANAGER").unwrap_or_else(|| OsString::from("network-manager"))
+}
