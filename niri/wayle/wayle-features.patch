+/// Watches every device's ports, so plugging a jack in or out adds and removes
+/// its row without waiting for the device list itself to change.
+pub(super) fn spawn_per_device(
+    sender: &ComponentSender<DevicePicker>,
+    audio: &Arc<AudioService>,
+    kind: VolumeSectionKind,
+    token: CancellationToken,
+) {
+    match kind {
+        VolumeSectionKind::Output => {
+            for device in audio.output_devices.get() {
+                let ports = device.ports.clone();
+                let active_port = device.active_port.clone();
+                watch_cancellable!(
+                    sender,
+                    token.clone(),
+                    [ports.watch(), active_port.watch()],
+                    |out| {
+                        let _ = out.send(DevicePickerCmd::RowsChanged);
+                    }
+                );
+            }
+        }
+        VolumeSectionKind::Input => {
+            for device in audio.input_devices.get() {
+                let ports = device.ports.clone();
+                let active_port = device.active_port.clone();
+                watch_cancellable!(
+                    sender,
+                    token.clone(),
+                    [ports.watch(), active_port.watch()],
+                    |out| {
+                        let _ = out.send(DevicePickerCmd::RowsChanged);
+                    }
+                );
+            }
+        }
+    }
+}
+
+pub(super) fn spawn_stream(
+    sender: &ComponentSender<DevicePicker>,
+    stream: &Arc<AudioStream>,
+    token: CancellationToken,
+) {
+    let device_index = stream.device_index.clone();
+    watch_cancellable!(sender, token, [device_index.watch()], |out| {
+        let _ = out.send(DevicePickerCmd::RowsChanged);
+    });
+}
