+/// Removes PulseAudio profile boilerplate while retaining the device model.
+pub(crate) fn short_device_name(description: &str) -> String {
+    let mut short = description.to_owned();
+    for noise in DESCRIPTION_NOISE {
+        while let Some(at) = short.find(noise) {
+            short.replace_range(at..at + noise.len(), " ");
+        }
+    }
+    let tokens: Vec<&str> = short.split_whitespace().collect();
+    let short = tokens
+        .iter()
+        .enumerate()
+        .filter(|(index, token)| {
+            let family_label = **token == "Family"
+                && tokens
+                    .get(index + 1)
+                    .is_some_and(|next| is_pci_family(next));
+            !(is_pci_family(token) || family_label)
+        })
+        .map(|(_, token)| *token)
+        .collect::<Vec<_>>()
+        .join(" ");
+    let short = short.trim_matches(|character: char| {
+        character.is_whitespace() || matches!(character, '-' | ',' | ':')
+    });
+    if short.is_empty() {
+        description.to_owned()
+    } else {
+        short.to_owned()
+    }
+}
