+
+/// Chrome marks web notifications transient. Wayle correctly displays those
+/// as popups but normally omits them from history; retain Chrome's entries so
+/// its native notification panels can still reopen them.
+fn spawn_chrome_history_watcher(service: &Arc<NotificationService>) {
+    let popups = service.popups.clone();
+    let history = service.notifications.clone();
+    let mut stream = popups.watch();
+
+    tokio::spawn(async move {
+        while stream.next().await.is_some() {
+            let mut current = history.get();
+            let mut changed = false;
+
+            for popup in popups
+                .get()
+                .iter()
+                .filter(|item| retain_transient(item.as_ref()))
+            {
+                if current.iter().any(|item| item.id == popup.id) {
+                    continue;
+                }
+                current.insert(0, popup.clone());
+                changed = true;
+            }
+
+            if changed {
+                history.set(current);
+            }
+        }
+    });
+}
+
+fn retain_transient(notification: &Notification) -> bool {
+    if !notification.is_transient.get() {
+        return false;
+    }
+
+    let desktop_entry = notification
+        .desktop_entry
+        .get()
+        .unwrap_or_default()
+        .to_ascii_lowercase();
+    let app_name = notification
+        .app_name
+        .get()
+        .unwrap_or_default()
+        .to_ascii_lowercase();
+
+    desktop_entry == "google-chrome"
+        || desktop_entry == "chromium"
+        || desktop_entry == "chromium-browser"
+        || desktop_entry.starts_with("chrome-")
+        || app_name.contains("chrome")
+        || app_name.contains("chromium")
diff --git a/crates/wayle-styling/scss/main.scss b/crates/wayle-styling/scss/main.scss
index a4b5734..8a69bdb 100644
--- a/crates/wayle-styling/scss/main.scss
+++ b/crates/wayle-styling/scss/main.scss
@@ -11,0 +12,18 @@
+
+// The external dropdown host is a layer surface anchored to all four edges, so
+// that a click outside the panel has somewhere to land. base/_index.scss paints
+// every `window` with --bg-base, which on that host is an opaque sheet over the
+// whole monitor rather than a panel background. Keep the structural part here
+// instead of only in ~/.config/wayle/styles: user styles are compiled from a
+// file outside the store and are dropped wholesale when that file is missing or
+// fails to compile, and losing them should not black out the desktop. They are
+// appended after this rule, so they can still restyle the panel.
+window.external-dropdown-window {
+    background: transparent;
+    box-shadow: none;
+
+    .external-dropdown-panel,
+    > .dropdown {
+        min-width: 0;
+    }
+}
