+/// Position as a percentage of the track length, for the seek slider's 0-100
+/// range. A player with no length reported sits at zero rather than jumping.
+fn progress_percentage(position: Duration, length: Option<Duration>) -> f64 {
+    match length {
+        Some(length) if !length.is_zero() => (position.as_secs_f64() / length.as_secs_f64()
+            * PERCENTAGE_SCALE)
+            .clamp(0.0, PERCENTAGE_SCALE),
+        _ => 0.0,
     }
 }
 
+fn format_duration(duration: Duration) -> String {
+    let total_secs = duration.as_secs();
+    let minutes = total_secs / SECONDS_PER_MINUTE;
+    let seconds = total_secs % SECONDS_PER_MINUTE;
+    format!("{minutes}:{seconds:02}")
+}
