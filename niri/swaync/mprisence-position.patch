diff --git a/src/web_bridge/mpris.rs b/src/web_bridge/mpris.rs
index c58ebfa..74e8562 100644
--- a/src/web_bridge/mpris.rs
+++ b/src/web_bridge/mpris.rs
@@ -461,17 +461,26 @@ fn stabilize_playback(
 
     let prev_dur_ms = (prev.meta.length_us / 1000).max(0) as u64;
     let prev_pos_ms = (prev.last_position_us / 1000).max(0) as u64;
+    let mut timing_glitch = false;
 
     if prev_dur_ms > 0 && playback.duration_ms == 0 {
+        timing_glitch = true;
         playback.duration_ms = prev_dur_ms;
     } else if prev_dur_ms > 0 && playback.duration_ms > 0 {
         let diff = prev_dur_ms.abs_diff(playback.duration_ms);
         if diff > 10_000 && (diff as f64 / prev_dur_ms as f64) > 0.15 {
+            timing_glitch = true;
             playback.duration_ms = prev_dur_ms;
         }
     }
 
-    if prev_pos_ms > 5_000 && playback.position_ms.saturating_add(3_000) < prev_pos_ms {
+    // Only preserve the previous position when the same update also carried a
+    // broken duration. A real seek or replay keeps the duration stable and
+    // must be allowed to move backwards, including from the end back to zero.
+    if timing_glitch
+        && prev_pos_ms > 5_000
+        && playback.position_ms.saturating_add(3_000) < prev_pos_ms
+    {
         playback.position_ms = prev_pos_ms;
     }
 
@@ -864,4 +873,29 @@ mod tests {
         assert_eq!(playback.duration_ms, 598_000);
         assert_eq!(playback.position_ms, 156_000);
     }
+
+    #[test]
+    fn stabilize_playback_accepts_replay_from_the_start() {
+        use super::super::protocol::{PlaybackState, Status};
+
+        let prev = PublishedSnapshot {
+            meta: MetaSnapshot {
+                track_id: "/mprisence/track/video".into(),
+                length_us: 2_994_000_000,
+                ..Default::default()
+            },
+            last_position_us: 2_994_000_000,
+            ..Default::default()
+        };
+        let mut playback = PlaybackState {
+            status: Status::Playing,
+            position_ms: 0,
+            duration_ms: 2_994_000,
+        };
+
+        stabilize_playback(&prev, &mut playback, "/mprisence/track/video");
+
+        assert_eq!(playback.duration_ms, 2_994_000);
+        assert_eq!(playback.position_ms, 0);
+    }
 }
