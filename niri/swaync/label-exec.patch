+        private void update_label (string content) {
+            if (pango_markup) {
+                label_widget.set_markup (content);
+            } else {
+                label_widget.set_text (content);
+            }
+        }
+
+        private async void refresh_label () {
+            if (refreshing) {
+                return;
+            }
+            refreshing = true;
+            try {
+                GLib.Subprocess process = new GLib.Subprocess (
+                    GLib.SubprocessFlags.STDOUT_PIPE | GLib.SubprocessFlags.STDERR_PIPE,
+                    "/bin/sh", "-c", exec);
+                string ?output = null;
+                string ?errors = null;
+                yield process.communicate_utf8_async (null, null, out output, out errors);
+                if (process.get_successful ()) {
+                    update_label ((output ?? "").chomp ());
+                } else {
+                    warning ("%s: \"%s\" failed: %s", key, exec, (errors ?? "").chomp ());
+                }
+            } catch (GLib.Error e) {
+                warning ("%s: could not run \"%s\": %s", key, exec, e.message);
+            }
+            refreshing = false;
