+        // Only the control center's own visibility gates the timer's usefulness,
+        // so also refresh on open to avoid showing values from the last tick.
+        public override void on_cc_visibility_change (bool value) {
+            if (value && exec != "") {
+                refresh_label.begin ();
+            }
+        }
