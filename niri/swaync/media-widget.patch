diff --git a/src/controlCenter/widgets/media/media.vala b/src/controlCenter/widgets/media/media.vala
new file mode 100644
index 0000000..7afdf33
--- /dev/null
+++ b/src/controlCenter/widgets/media/media.vala
@@ -0,0 +1,339 @@
+namespace SwayNotificationCenter.Widgets {
+    /**
+     * One player: a play/pause button beside its title, the track's progress,
+     * and its volume.
+     *
+     * The row knows nothing about MPRIS. It renders the fields it is given and
+     * emits a signal when one of its controls is used; the widget below turns
+     * that into the configured command.
+     */
+    class MediaRow : Gtk.Box {
+
+        private Gtk.Button toggle_button;
+        private Gtk.Label title_label;
+        private Gtk.Label subtitle_label;
+        private Gtk.ProgressBar progress;
+        private Gtk.Box volume_box;
+        private Gtk.Scale volume_scale;
+        private ulong volume_handler;
+
+        /**
+         * Refreshes leave the volume alone until this passes, so a value on its
+         * way back from the player cannot yank the slider out from under the
+         * pointer that just moved it.
+         */
+        private int64 volume_held_until = 0;
+        private const int64 VOLUME_HOLD = 2 * 1000 * 1000;
+
+        public signal void toggled ();
+        public signal void volume_changed (double percent);
+
+        public MediaRow () {
+            Object ();
+
+            set_orientation (Gtk.Orientation.VERTICAL);
+            set_spacing (2);
+            add_css_class ("widget-media-row");
+
+            toggle_button = new Gtk.Button.with_label ("");
+            toggle_button.add_css_class ("widget-media-toggle");
+            toggle_button.clicked.connect (() => toggled ());
+
+            title_label = new Gtk.Label (null);
+            title_label.set_ellipsize (Pango.EllipsizeMode.END);
+            title_label.set_max_width_chars (0);
+            title_label.set_xalign (0.0f);
+            title_label.set_hexpand (true);
+            title_label.add_css_class ("widget-media-title");
+
+            Gtk.Box header = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 6);
+            header.append (toggle_button);
+            header.append (title_label);
+            append (header);
+
+            subtitle_label = new Gtk.Label (null);
+            subtitle_label.set_ellipsize (Pango.EllipsizeMode.END);
+            subtitle_label.set_max_width_chars (0);
+            subtitle_label.set_xalign (0.0f);
+            subtitle_label.set_hexpand (true);
+            subtitle_label.add_css_class ("widget-media-subtitle");
+            append (subtitle_label);
+
+            progress = new Gtk.ProgressBar ();
+            progress.set_hexpand (true);
+            progress.add_css_class ("widget-media-progress");
+            append (progress);
+
+            volume_scale = new Gtk.Scale.with_range (Gtk.Orientation.HORIZONTAL, 0, 100, 1);
+            volume_scale.set_draw_value (false);
+            volume_scale.set_hexpand (true);
+            volume_handler = volume_scale.value_changed.connect (() => {
+                volume_held_until = GLib.get_monotonic_time () + VOLUME_HOLD;
+                volume_changed (volume_scale.get_value ());
+            });
+
+            Gtk.Label volume_icon = new Gtk.Label ("󰕾");
+            volume_icon.add_css_class ("widget-media-volume-icon");
+
+            volume_box = new Gtk.Box (Gtk.Orientation.HORIZONTAL, 6);
+            volume_box.add_css_class ("widget-media-volume");
+            volume_box.append (volume_icon);
+            volume_box.append (volume_scale);
+            append (volume_box);
+        }
+
+        /**
+         * Apply one line's worth of fields.
+         *
+         * `volume`, `position` and `length` are all optional in MPRIS; a player
+         * that reports none of them gets a row with neither slider nor bar
+         * rather than an empty one.
+         */
+        public void update (bool playing, double volume, double position, double length,
+                            string title, string subtitle) {
+            toggle_button.set_label (playing ? "󰏤" : "󰐊");
+            if (playing) {
+                add_css_class ("playing");
+                remove_css_class ("paused");
+            } else {
+                add_css_class ("paused");
+                remove_css_class ("playing");
+            }
+
+            title_label.set_text (title);
+            subtitle_label.set_text (subtitle);
+            subtitle_label.set_visible (subtitle.length > 0);
+
+            bool has_progress = length > 0 && position >= 0;
+            progress.set_visible (has_progress);
+            if (has_progress) {
+                progress.set_fraction ((position / length).clamp (0.0, 1.0));
+            }
+
+            bool has_volume = volume >= 0;
+            volume_box.set_visible (has_volume);
+            if (has_volume && GLib.get_monotonic_time () > volume_held_until) {
+                GLib.SignalHandler.block (volume_scale, volume_handler);
+                volume_scale.set_value (volume.clamp (0.0, 100.0));
+                GLib.SignalHandler.unblock (volume_scale, volume_handler);
+            }
+        }
+    }
+
+    /**
+     * A list of every MPRIS player that is playing or paused, each with its own
+     * progress bar and volume slider.
+     *
+     * The widget is only a renderer: `exec` prints one tab-separated line per
+     * player — id, status, volume, position, length, title, subtitle — and the
+     * two command options are run with `$id` and `$value` substituted when a
+     * row's button or slider is used. Everything that knows what a player is
+     * stays in the program behind `exec`.
+     */
+    public class Media : BaseWidget {
+        public override string widget_name {
+            get {
+                return "media";
+            }
+        }
+
+        private const int FIELDS = 7;
+
+        private Gtk.Box list;
+        private Gtk.Label empty_label;
+        private HashTable<string, MediaRow> rows =
+            new HashTable<string, MediaRow> (str_hash, str_equal);
+
+        // Default config values
+        private string exec = "";
+        private string toggle_command = "";
+        private string volume_command = "";
+        private int interval = 0;
+        private string empty_text = "Nothing is playing";
+
+        private bool refreshing = false;
+        private bool cc_visible = false;
+
+        public Media (string suffix) {
+            base (suffix);
+            set_orientation (Gtk.Orientation.VERTICAL);
+
+            Json.Object ?config = get_config (this);
+            if (config != null) {
+                string ?exec = get_prop<string> (config, "exec");
+                if (exec != null) {
+                    this.exec = exec;
+                }
+                string ?toggle_command = get_prop<string> (config, "toggle-command");
+                if (toggle_command != null) {
+                    this.toggle_command = toggle_command;
+                }
+                string ?volume_command = get_prop<string> (config, "volume-command");
+                if (volume_command != null) {
+                    this.volume_command = volume_command;
+                }
+                int ?interval = get_prop<int> (config, "interval");
+                if (interval != null) {
+                    this.interval = interval;
+                }
+                string ?empty_text = get_prop<string> (config, "empty-text");
+                if (empty_text != null) {
+                    this.empty_text = empty_text;
+                }
+            }
+
+            list = new Gtk.Box (Gtk.Orientation.VERTICAL, 6);
+            list.set_hexpand (true);
+            list.set_visible (false);
+            append (list);
+
+            empty_label = new Gtk.Label (this.empty_text);
+            empty_label.set_xalign (0.0f);
+            empty_label.set_hexpand (true);
+            empty_label.add_css_class ("widget-media-empty");
+            append (empty_label);
+
+            if (this.exec != "") {
+                refresh.begin ();
+                if (this.interval > 0) {
+                    GLib.Timeout.add_seconds ((uint) this.interval, () => {
+                        if (cc_visible) {
+                            refresh.begin ();
+                        }
+                        return GLib.Source.CONTINUE;
+                    });
+                }
+            }
+        }
+
+        // The progress bars are only worth ticking while they can be seen, but
+        // the first frame after opening should not be a stale one either.
+        public override void on_cc_visibility_change (bool value) {
+            cc_visible = value;
+            if (value && exec != "") {
+                refresh.begin ();
+            }
+        }
+
+        private async void refresh () {
+            if (refreshing) {
+                return;
+            }
+            refreshing = true;
+            try {
+                GLib.Subprocess process = new GLib.Subprocess (
+                    GLib.SubprocessFlags.STDOUT_PIPE | GLib.SubprocessFlags.STDERR_PIPE,
+                    "/bin/sh", "-c", exec);
+                string ?output = null;
+                string ?errors = null;
+                yield process.communicate_utf8_async (null, null, out output, out errors);
+                if (process.get_successful ()) {
+                    apply (output ?? "");
+                } else {
+                    warning ("%s: \"%s\" failed: %s", key, exec, (errors ?? "").chomp ());
+                }
+            } catch (GLib.Error e) {
+                warning ("%s: could not run \"%s\": %s", key, exec, e.message);
+            }
+            refreshing = false;
+        }
+
+        /**
+         * Reconcile the rows with the players the command reported.
+         *
+         * Rows are updated in place rather than rebuilt so that a refresh
+         * landing mid-drag does not destroy the slider being dragged.
+         */
+        private void apply (string output) {
+            GenericArray<MediaRow> ordered = new GenericArray<MediaRow> ();
+
+            foreach (string line in output.split ("\n")) {
+                if (line.strip ().length == 0) {
+                    continue;
+                }
+                string[] fields = line.split ("\t");
+                if (fields.length < FIELDS) {
+                    warning ("%s: expected %d fields, got %d: \"%s\"",
+                             key, FIELDS, fields.length, line);
+                    continue;
+                }
+
+                string id = fields[0];
+                MediaRow ?row = rows.lookup (id);
+                if (row == null) {
+                    row = build_row (id);
+                    rows.set (id, row);
+                    list.append (row);
+                }
+                row.update (fields[1] == "playing",
+                            number (fields[2]),
+                            number (fields[3]),
+                            number (fields[4]),
+                            fields[5],
+                            fields[6]);
+                ordered.add (row);
+            }
+
+            // Collect first, then remove: the key array is only valid while the
+            // table it came from is untouched.
+            GenericArray<string> stale = new GenericArray<string> ();
+            foreach (string id in rows.get_keys_as_array ()) {
+                MediaRow ?row = rows.lookup (id);
+                if (row == null || !ordered.find (row)) {
+                    stale.add (id);
+                }
+            }
+            for (int i = 0; i < stale.length; i++) {
+                MediaRow ?row = rows.lookup (stale.get (i));
+                if (row != null) {
+                    list.remove (row);
+                }
+                rows.remove (stale.get (i));
+            }
+
+            // Keep the list in the order the command reported, which is the
+            // order that program considers most relevant.
+            Gtk.Widget ?previous = null;
+            for (int i = 0; i < ordered.length; i++) {
+                list.reorder_child_after (ordered.get (i), previous);
+                previous = ordered.get (i);
+            }
+
+            bool empty = ordered.length == 0;
+            list.set_visible (!empty);
+            empty_label.set_visible (empty);
+        }
+
+        private MediaRow build_row (string id) {
+            MediaRow row = new MediaRow ();
+            row.toggled.connect (() => {
+                if (toggle_command != "") {
+                    execute_command.begin (expand (toggle_command, id, null));
+                }
+            });
+            row.volume_changed.connect ((percent) => {
+                if (volume_command != "") {
+                    execute_command.begin (expand (volume_command, id, percent));
+                }
+            });
+            return row;
+        }
+
+        /** A field the reporting program left out, as a negative number. */
+        private static double number (string field) {
+            double value;
+            if (!double.try_parse (field, out value)) {
+                return -1;
+            }
+            return value;
+        }
+
+        private static string expand (string command, string id, double ?value) {
+            string expanded = command.replace ("$id", id);
+            if (value != null) {
+                expanded = expanded.replace ("$value", "%.0f".printf (value));
+            }
+            return expanded;
+        }
+    }
+}
