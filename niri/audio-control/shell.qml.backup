import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import QtQuick.Shapes
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Bluetooth
import "shared" as Shared

ShellRoot {
    id: root

    property bool opened: false
    property string monitor: ""
    property int currentTab: 1
    readonly property string helper: Quickshell.env("AUDIO_CONTROL_HELPER") || "audio-control"

    function close() {
        opened = false;
    }

    IpcHandler {
        target: "panel"

        function toggle(monitor: string): void {
            if (root.opened && root.monitor === monitor) {
                root.close();
            } else {
                root.monitor = monitor;
                root.opened = true;
            }
        }

        function close(): void { root.close(); }

        function bluetoothPower(): void {
            if (bluetooth.adapter)
                bluetooth.adapter.enabled = !bluetooth.adapter.enabled;
        }
    }

    PanelWindow {
        id: window
        visible: root.opened
        screen: Quickshell.screens.find(s => s.name === root.monitor) || Quickshell.screens[0]
        anchors { top: true; bottom: true; left: true; right: true }
        color: "transparent"
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive
        WlrLayershell.namespace: "audio-control"

        MouseArea {
            anchors.fill: parent
            onClicked: root.close()
        }

        Pane {
            id: panel
            readonly property var colors: Shared.Colors {}
            width: Math.min(400, parent.width - 16)
            height: Math.min(520, parent.height - 64)
            anchors {
                top: parent.top
                right: parent.right
                topMargin: 40
                rightMargin: Math.min(96, Math.max(8, (panel.parent.width - panel.width) / 2))
            }
            padding: 11
            focus: true
            Keys.onEscapePressed: root.close()
            font.family: "Noto Sans"
            font.pixelSize: 13
            palette {
                window: panel.colors.background
                windowText: panel.colors.accent
                base: panel.colors.surface
                alternateBase: panel.colors.elevated
                text: panel.colors.accent
                button: panel.colors.surface
                buttonText: panel.colors.accent
                highlight: panel.colors.primary
                highlightedText: panel.colors.background
                mid: panel.colors.muted
                dark: panel.colors.elevated
            }
            background: Shared.PopupFrame {
                // Consume inside clicks instead of dismissing the backdrop.
                MouseArea { anchors.fill: parent }
            }

            ColumnLayout {
                anchors.fill: parent
                spacing: 0

                RowLayout {
                    id: tabs
                    Layout.fillWidth: true
                    spacing: 0
                    readonly property real tabWidth: width / 3
                    Repeater {
                        model: ["Bluetooth", "Output", "Input"]
                        delegate: Shared.ControlButton {
                            required property int index
                            required property string modelData
                            Layout.fillWidth: true
                            Layout.minimumWidth: 0
                            Layout.preferredWidth: tabs.tabWidth
                            text: modelData.toUpperCase()
                            size: 40
                            tabStyle: true
                            checkable: true
                            autoExclusive: true
                            checked: root.currentTab === index
                            onActivated: root.currentTab = index
                        }
                    }
                }
                Item {
                    id: pageFrame
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    readonly property real outlineInset: 0.5
                    readonly property real selectedTabEdgeInset: 0.75

                    Shape {
                        anchors.fill: parent
                        ShapePath {
                            strokeColor: panel.colors.accent
                            strokeWidth: 1
                            fillColor: "transparent"
                            startX: pageFrame.outlineInset
                            startY: pageFrame.outlineInset
                            PathLine {
                                x: tabs.tabWidth * root.currentTab + pageFrame.selectedTabEdgeInset
                                y: pageFrame.outlineInset
                            }
                        }
                        ShapePath {
                            strokeColor: panel.colors.accent
                            strokeWidth: 1
                            fillColor: "transparent"
                            startX: tabs.tabWidth * (root.currentTab + 1) - pageFrame.selectedTabEdgeInset
                            startY: pageFrame.outlineInset
                            PathLine { x: pageFrame.width - pageFrame.outlineInset; y: pageFrame.outlineInset }
                            PathLine { x: pageFrame.width - pageFrame.outlineInset; y: pageFrame.height - pageFrame.outlineInset }
                            PathLine { x: pageFrame.outlineInset; y: pageFrame.height - pageFrame.outlineInset }
                            PathLine { x: pageFrame.outlineInset; y: pageFrame.outlineInset }
                        }
                    }
                    StackLayout {
                        anchors.fill: parent
                        anchors.margins: 12
                        currentIndex: root.currentTab
                        BluetoothPage {
                            id: bluetooth
                            active: root.opened && root.currentTab === 0
                        }
                        AudioPage {
                            kind: "output"
                            helper: root.helper
                            active: root.opened && root.currentTab === 1
                        }
                        AudioPage {
                            kind: "input"
                            helper: root.helper
                            active: root.opened && root.currentTab === 2
                        }
                    }
                }
            }
        }
    }
}
