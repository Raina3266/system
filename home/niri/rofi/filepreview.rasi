/* ROFI: file finder with a preview pane.
 *
 * Used only by the dedicated file-search invocation (Mod+Shift+F), not by the
 * combi launcher. drun entries feed their own application icon to
 * `icon-current-entry`, which looks bad blown up to pane size, so the preview
 * pane deliberately lives in a separate theme/invocation.
 *
 * The pane is driven by `preview-cmd` (see preview.sh). For files with no
 * meaningful preview, preview.sh emits a 1x1 transparent PNG; combined with
 * `squared: false` that makes the icon widget's desired width collapse to
 * ~nothing, so the listview reclaims the space.
 */

/* @import (not @theme) so the cyberpunk rules merge into this theme rather
 * than discarding it -- `-theme` is itself handled like an @theme. */
@import "~/.config/rofi/cyberpunk.rasi"

/* Wider than the launcher: needs room for list + preview side by side. */
window {
    width: 900px;
}

mainbox {
    children: [ inputbar, message, listview-split, mode-switcher ];
}

listview-split {
    orientation: horizontal;
    spacing:     10px;
    children:    [ listview, icon-current-entry ];
}

listview {
    lines: 12;
}

/* The preview pane itself. `squared: false` lets the widget take its natural
 * aspect ratio (and collapse when the preview is the 1x1 placeholder). */
icon-current-entry {
    expand:           true;
    squared:          false;
    size:             360px;
    background-color: @bg-mod;
    border:           1px;
    border-color:     rgba(122, 252, 255, 0.2);
    border-radius:    6px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
