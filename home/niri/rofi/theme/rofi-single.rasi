/* ROFI: cyberpunk single-line theme
   One-line rows: main text only, no tooltip line. */

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:        #0E0616F2;
    bg-mod:    #141428B3;
    fg:        #CBE3E7;
    pink:      #FF7EDB;
    cyan:      #7AFCFF;
    amber:     #F29E74;
    red:       #FF3333;
    dim:       #5C6776;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     rgba(255, 126, 219, 0.5);
    border-radius:    15px;
    padding:          10px;
    width:            400px;
}

/* `navbar` is the slot for the network menu's custom action bar (see "Button
   bars"). Rofi builds unknown widget names as plain boxes; a box is vertical
   unless its `orientation` is set, which the menu does via -theme-str when it
   fills the bar. With no buttons defined it stays empty and collapses. Keeping
   it here means no caller overrides `children`, which would drop
   textbox-current-entry. */
mainbox {
    orientation: vertical;
    children:   [ inputbar, message, textbox-current-entry, listview, navbar ];
}

/* ── Current Entry ── */

textbox-current-entry {
    vertical-align: 0.5;
    width:         580px;
    padding:        10px 0 10px 10px;
    border:           1px;
    border-radius:    6px;
    border-color:     rgba(255, 126, 219, 0.2);
    font:          "JetBrains Mono Nerd Font 11";
    text-color:    @cyan;
    markup:        true;
}

/* ── Search input ── */

inputbar {
    background-color: @bg-mod;
    border:           1px;
    border-color:     rgba(255, 126, 219, 0.2);
    border-radius:    6px;
    padding:          10px 14px;
    margin:           0 0 10px 0;
    children:         [ prompt, entry ];
}

inputbar focus,
inputbar active {
    border-color: rgba(255, 126, 219, 0.5);
}

prompt {
    text-color: @pink;
}

entry {
    text-color: @fg;
    cursor:     text;
    placeholder: "";
    placeholder-color: @dim;
}

/* ── List ── */

listview {
    margin:      10px 0 0 0;
    lines:       10;
    dynamic:     true;
    scrollbar:   true;
    spacing:     3px;
    eh:          1;
}

scrollbar {
    width:         4px;
    border-radius: 2px;
    handle-color:  @pink;
    handle-width:  4px;
    border:        0;
    margin:        0 0 0 4px;
}

element {
    padding:       10px;
    border:        1px;
    border-color:  rgba(122, 252, 255, 0.1);
    children: [ element-text ];
}

element selected.normal {
    border-color:     rgba(255, 126, 219, 0.5);
}

element-text {
    cursor:          inherit;
    vertical-align:  0.5;
}

element-text selected.normal {
    text-color:       @pink;
}

/* ── Button bars ──
   Two kinds of bar exist:
     - mode-switcher: rofi's built-in row, one `button` per mode. Its buttons
       can only switch modes, so they cannot host arbitrary actions.
     - navbar: our own box of button1..N widgets, generated at runtime by the
       network menu (see network.nix) so the count can vary.
   A widget is only a real (clickable) button if its name starts with "button";
   otherwise rofi builds a box and silently ignores content/action.

   IMPORTANT: rofi resolves a widget's properties from its *own* name/path, not
   by walking ancestors, so there is no CSS-style descendant inheritance. A path
   like `navbar button` refers to a widget literally *named* `button` inside
   navbar; it does not match widgets named button1..N, and neither does a bare
   `button {}`. Running `G_MESSAGES_DEBUG=Theme rofi ...` shows rofi querying
   `#button1` directly, never `navbar` or `button`.

   Because only exact names match, the look cannot be expressed once and
   inherited -- but it also does not need to live in the script. The widget
   names are predictable, so button1..8 and navrow1..3 are simply declared here
   as an explicit comma list (per rofi-theme(5) a comma list and a multi-name
   path are equivalent). The script then injects *structure only*: which navrow
   holds which buttons, and each button's content/action.

   Raise the counts below if a menu ever needs more than 8 buttons or 3 rows;
   declaring more than exist is harmless, as unused names are never built. */

/* Custom action bar. Empty (no buttons) it collapses in menus that define none.
   The script sets `children` to a list of navrow* boxes, one per line, so the
   bar itself stacks vertically.

   `expand: false` stops the bar swallowing the window's leftover vertical
   space; without it the pills get stretched into tall columns.

   The bottom padding is deliberately non-zero: at 0 the last row's lower border
   lands exactly on the window edge and gets clipped, which made the pills look
   like open-bottomed brackets. */
navbar {
    orientation:  vertical;
    spacing:      6px;
    padding:      10px 0 4px 0;
    expand:       false;
}

/* One line of the action bar. Each holds a slice of the buttons; `expand: false`
   keeps a row only as tall as its pills. */
navrow1, navrow2, navrow3 {
    orientation:  horizontal;
    padding:      5px 5px;
    spacing:      6px;
    expand:       false;
}

/* The action-bar pills. `expand: false` sizes each to its own label instead of
   stretching them all to equal width, which is what made the bar look lumpy. */
button1, button2, button3, button4, button5, button6, button7, button8 {
    border:           1px;
    border-radius:    6px;
    border-color:     rgba(122, 252, 255, 0.35);
    background-color: rgba(122, 252, 255, 0.07);
    padding:          7px 12px;
    text-color:       @cyan;
    expand:           false;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}

/* mode-switcher tabs only; its single child type really is named `button`. */
button {
    border-radius:  6px;
    border:         1px;
    border-color:   rgba(122, 252, 255, 0.25);
    padding:        8px;
    text-color:     @cyan;
    horizontal-align: 0.5;
    cursor:         pointer;
}

button selected.normal {
    background-color: @pink;
    text-color:       @pink;
}
/* ── Error ── */

error-message {
    border:           1px;
    border-color:     @red;
    border-radius:    6px;
    padding:          10px;
    background-color: @bg;
    text-color:       @fg;
}
