/* Clipboard menu: memo/text/image tabs and action buttons. */

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    amber:    #F29E74;
    red:      #FF5C57;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 400px;
    height: 615px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    margin: 5px;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    children: [ mode-switcher, inputbar, clipboard-body, action-bar ];
}

/* Memo / Text / Images are native mode buttons and are mouse-clickable. */
mode-switcher {
    orientation: horizontal;
    spacing: 10px;
    padding: 2px 0 2px 0;
}

button {
    expand: true;
    cursor: pointer;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
    horizontal-align: 0.5;
}

button selected {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.16);
    text-color: @pink;
}

inputbar {
    spacing: 10px;
    padding: 6px 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(255, 126, 219, 0.25);
    background-color: @bg-mod;
    children: [ entry ];
}

entry {
    cursor: text;
    placeholder: "Search clipboard";
    placeholder-color: @dim;
}

clipboard-body {
    orientation: horizontal;
    children: [ listview ];
}

listview {
    width: 400px;
    lines: 9;
    eh: 1;
    padding: 4px 0;
    dynamic: true;
    scrollbar: true;
    spacing: 4px;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @pink;
    border: 0;
    margin: 0 0 0 5px;
}

/* Visible rows stay textual; stable IDs and full values travel separately. */
element {
    children: [ element-icon, element-text ];
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.10);
}

element-icon {
    enabled: false;
    size: 400px;
}

element normal.active,
element alternate.active {
    border-color: rgba(122, 252, 255, 0.45);
    background-color: rgba(122, 252, 255, 0.07);
}

element selected.normal,
element selected.active {
    border-color: rgba(255, 126, 219, 0.65);
    background-color: rgba(255, 126, 219, 0.10);
}

element-text {
    vertical-align: 0.5;
}

element-text normal.active,
element-text alternate.active {
    text-color: @cyan;
}

element-text selected {
    text-color: @pink;
}

/* Custom widget names beginning with "button" are real rofi buttons. Their
   action invokes the same script-mode event as the documented Alt shortcut. */
action-bar {
    expand: false;
    orientation: horizontal;
    spacing: 10px;
    children: [ button-pin, button-edit, button-delete ];
}

button-pin,
button-delete,
button-edit {
    cursor: pointer;
    horizontal-align: 0.5;
    margin: 5px 0px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
}

button-pin {
    content: "󰐃 Pin";
    action: "kb-custom-1";
}

button-delete {
    content: "󰆴 Delete";
    action: "kb-custom-2";
    border-color: rgba(255, 92, 87, 0.35);
    text-color: @red;
}

button-edit {
    content: "󰏫 Edit";
    action: "kb-custom-3";
}


textbox {
    markup: false;
    text-color: @amber;
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
