/* ROFI: base configuration */

configuration {
    /* ── Top-right corner ── */ 
    location: 3; 
    x-offset: 5px; 
    y-offset: 44px; 
    scroll-method: 1; 
    cycle: false;

    modes: "combi,filesearch:rofi-filesearch";
    combi-modes: "drun,filesearch:rofi-filesearch";
    combi-display-format: "{text}";
    sidebar-mode: true;

    /* ── Behaviour ── */
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-combi: "󰍉 ";
    display-drun: "󰀻 ";
    display-filesearch: "󰈞 ";
    drun-display-format: "{icon} {name}";

    /* ── File contents preview ──
       Called as: rofi-preview <input> <output> <size>; must write a PNG to
       <output>. Results are cached by rofi under ~/.cache/thumbnails. */
    preview-cmd: "rofi-preview {input} {output} {size}";

    filebrowser {
        command: "xdg-open";
        directory: "/home/raina";
        show-hidden: false;
        display-format: "{name}";
    }

    /* ── Wayland ── */
    click-to-exit: true;
}

@theme "~/.config/rofi/cyberpunk.rasi"
