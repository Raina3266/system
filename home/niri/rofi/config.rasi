/* ROFI: base configuration */

configuration {
    /* ── Top-right corner ── */
    location: 3;
    x-offset: 5px;
    y-offset: 44px;
    scroll-method: 0;
    hover-select: true;
    cycle: false;
    
    /* ── Wayland ── */
    click-to-exit: true;

    modes: "combi,filesearch:rofi-filesearch,filebrowser";
    combi-modes: "drun,filesearch";
    combi-display-format: "{text}";
    sidebar-mode: true;

    /* ── Behaviour ── */
    show-icons: false;
    icon-theme: "Papirus-Dark";
    display-combi: "󰍉 All ";
    display-filebrowser: " Folders ";
    display-filesearch: "󰈞 Files ";
    drun-display-format: "⌘ {name}";
    filebrowser-display-format: "  {name}";

    filebrowser {
        command: "xdg-open";
        directory: "/home/raina";
        show-hidden: false;
    }
}

@theme "~/.config/rofi/cyberpunk.rasi"
