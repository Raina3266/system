/* Dynamic media menu: live MPRIS rows plus seven mouse-action buttons. */

* {
    font: "JetBrains Mono Nerd Font 13";
    bg:       #0E0616F2;
    bg-mod:   #141428F2;
    fg:       #CBE3E7;
    pink:     #FF7EDB;
    cyan:     #7AFCFF;
    amber:    #F29E74;
    red:      #FF3333;
    dim:      #5C6776;

    background-color: transparent;
    text-color: @fg;
}

window {
    location: north;
    anchor: north;
    width: 600px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 126, 219, 0.55);
    border-radius: 15px;
    margin: 5px;
    padding: 12px;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    children: [ listview, action-bar ];
}

listview {
    lines: 10;
    dynamic: true;
    fixed-height: false;
    scrollbar: true;
    spacing: 4px;
    padding: 0;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: rgba(255, 126, 219, 0.55);
    border: 0;
    margin: 0 0 0 5px;
}

element {
    children: [ element-text ];
    padding: 9px 11px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.10);
}

element normal.active,
element alternate.active {
    border-color: rgba(122, 252, 255, 0.36);
    background-color: rgba(122, 252, 255, 0.06);
}

element selected.normal,
element selected.active,
element selected.urgent {
    border-color: @pink;
    background-color: rgba(255, 126, 219, 0.12);
}

element-text {
    vertical-align: 0.5;
    text-color: @dim;
}

element-text normal.normal,
element-text alternate.normal,
element-text selected.normal {
    text-color: @dim;
}

element-text normal.active,
element-text alternate.active,
element-text selected.active {
    text-color: @fg;
}

element-text normal.urgent,
element-text alternate.urgent,
element-text selected.urgent {
    text-color: @cyan;
}

/* These are native Rofi buttons. Each action becomes ROFI_RETV 10..16 in
   script mode, so Rust can act on the row selected in the list above. */
action-bar {
    expand: false;
    orientation: horizontal;
    spacing: 7px;
    children: [
        button-pin,
        button-prev,
        button-next,
        button-play,
        button-vol-up,
        button-vol-down,
        button-remove
    ];
}

button-pin,
button-prev,
button-next,
button-play,
button-vol-up,
button-vol-down,
button-remove {
    cursor: pointer;
    expand: true;
    horizontal-align: 0.5;
    margin: 1px 1px;
    border: 1px;
    border-radius: 7px;
    border-color: rgba(122, 252, 255, 0.28);
    background-color: rgba(122, 252, 255, 0.06);
    text-color: @cyan;
}

button-pin {
    content: " 󰐃 ";
    action: "kb-custom-1";
}

button-prev {
    content: " 󰒮 ";
    action: "kb-custom-2";
}

button-next {
    content: " 󰒭 ";
    action: "kb-custom-3";
}

button-play {
    content: " 󰐊 ";
    action: "kb-custom-4";
}

button-vol-up {
    content: " 󰝝 ";
    action: "kb-custom-5";
}

button-vol-down {
    content:  "󰝞 ";
    action: "kb-custom-6";
}

button-remove {
    content: " 󰆴 ";
    action: "kb-custom-7";
    border-color: rgba(255, 51, 51, 0.45);
    text-color: @amber;
}

error-message {
    padding: 10px;
    border: 1px;
    border-radius: 7px;
    border-color: @red;
    background-color: @bg;
    text-color: @fg;
}
